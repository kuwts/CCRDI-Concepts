---
import config from '@/config/site.config.json';
import { absoluteImageURL } from '@/lib/seo';
import { alternates, getLang, languages, localeTag, siteText, ui } from '@/i18n';
import type { Seo } from '@/types/shared';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ScrollProgress from '@/components/ScrollProgress.astro';
import DeviceSizeIndicator from "@/components/helper/DeviceSizeIndicator.astro";

// brand fonts, self-hosted (site.config.json → brand.font names these families)
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/inter';
import '@/styles/global.css';

interface Props {
  /** The page's own title (e.g. "About", a post title); shown as "{title} | {brand.name}". */
  title?: string;
  /** The page's own description (e.g. a post's summary). */
  description?: string;
  /** The page's own share image path (src/assets or public), ideally 1200×630. */
  image?: string;
  /** SEO overrides from the page's content entry (its `seo` front-matter block). */
  seo?: Seo;
  noindex?: boolean;
  /** Extra classes on the site footer. */
  footerClass?: string;
  /** Canonical URL or path; defaults to this page's own URL. */
  canonical?: string;
  /** og:type */
  type?: 'website' | 'article';
}

const { brand } = config;
// English at the root, French under /fr: SEO defaults, footer details and labels per language
const lang = getLang(Astro.url);
const { seo: siteSeo, footer } = siteText(lang);
const t = ui(lang);
const {
  title,
  description,
  image,
  seo,
  noindex = false,
  footerClass,
  canonical,
  type = 'website',
} = Astro.props;

// SEO for any page, most specific first; empty strings count as unset:
//   1. `seo` prop: the page's content entry (`seo:` in its front matter)
//   2. site.config.json → seo.pages["/path"] (French: fr.seo.pages): for pages with no content entry
//   3. the page's own title / description / image props
//   4. site defaults (seo.title, seo.description, seo.image)
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const pathSeo = (siteSeo.pages as Record<string, Seo>)[path];

const site = Astro.site ?? new URL(config.baseURL);
const resolvedTitle = seo?.title || pathSeo?.title || title;
const pageTitle = resolvedTitle ? `${resolvedTitle} | ${brand.name}` : siteSeo.title;
const pageDescription =
  seo?.description || pathSeo?.description || description || siteSeo.description;
const canonicalURL = new URL(canonical ?? Astro.url.pathname, site).href;
const imageURL = await absoluteImageURL(
  seo?.image || pathSeo?.image || image || siteSeo.image,
  site,
);

// favicon set from site.config.json → brand.favicon (public/ paths; empty = skipped)
const favicon = brand.favicon;

// brand colors from site.config.json → --brand-* (mapped to Tailwind tokens in global.css)
const brandVars =
  Object.entries(brand.colors)
    .map(([name, value]) => `--brand-${name}:${value};`)
    .join('') +
  `--brand-font-heading:'${brand.font.heading.name}',${brand.font.heading.fallback};` +
  `--brand-font-body:'${brand.font.body.name}',${brand.font.body.fallback};`;

// the same page in the other language (src/i18n/routes.json): hreflang links, with English
// as the default for other languages; not on noindex pages (404, thank-you)
const pair = noindex ? undefined : alternates(Astro.url);
// written like this page's canonical URL (with a trailing slash in the built site)
const slash = Astro.url.pathname.endsWith('/');
const altURL = (path: string) => new URL(slash && path !== '/' ? `${path}/` : path, site).href;
const otherLang = lang === 'fr' ? 'en' : 'fr';

// Organization structured data, on the homepage only (as Google recommends); in French on /fr.
// No `sameAs`: the footer's social links are Consumer Choice Award's accounts, not
// CCC's own profiles (add CCC's profile URLs here when it has them; brief/gaps.md).
// Placeholder contact details are left out rather than published as data.
const isHome = Astro.url.pathname.replace(/(.)\/$/, '$1') === languages[lang].home;
const real = (v: string) => (v && !v.includes('CLIENT TO PROVIDE') ? v : undefined);
const organization = isHome
  ? {
      '@context': 'https://schema.org',
      '@type': 'Organization',
      name: brand.name,
      url: new URL(languages[lang].home, site).href,
      logo: await absoluteImageURL(brand.logoLight.src, site),
      description: siteSeo.description,
      email: real(footer.email),
      telephone: real(footer.phone),
      address: real([footer.address_line_1, footer.address_line_2].filter(Boolean).join(', ')),
    }
  : null;
---

<!doctype html>
<html lang={localeTag(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    {siteSeo.author && <meta name="author" content={siteSeo.author} />}
    {favicon.png32 && <link rel="icon" type="image/png" sizes="32x32" href={favicon.png32} />}
    {favicon.svg && <link rel="icon" type="image/svg+xml" href={favicon.svg} />}
    {favicon.appleTouch && <link rel="apple-touch-icon" sizes="180x180" href={favicon.appleTouch} />}
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content={brand.colors.dark} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex" />}
    {
      pair && (
        <>
          <link rel="alternate" hreflang={languages.en.lang} href={altURL(pair.en)} />
          <link rel="alternate" hreflang={languages.fr.lang} href={altURL(pair.fr)} />
          <link rel="alternate" hreflang="x-default" href={altURL(pair.en)} />
        </>
      )
    }

    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={languages[lang].ogLocale} />
    {pair && <meta property="og:locale:alternate" content={languages[otherLang].ogLocale} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={imageURL} />

    {
      organization && (
        <script
          is:inline
          type="application/ld+json"
          set:html={JSON.stringify(organization).replace(/</g, '\\u003c')}
        />
      )
    }

    <Fragment set:html={`<style>:root{${brandVars}}</style>`} />
    <!-- scroll-reveal content is hidden until JS marks it visible; without JS, show it -->
    <noscript>
      <style>
        .has-anim {
          opacity: 1 !important;
          visibility: visible !important;
          transform: none !important;
        }
      </style>
    </noscript>
    <slot name="head" />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only-focusable fixed top-3 left-3 z-99999 bg-white px-5 py-3 font-medium text-dark"
    >
      {t.skipToContent}
    </a>
    <ScrollProgress />
    <DeviceSizeIndicator />
    <Header />
    <main id="main" tabindex="-1" class="outline-none"><slot /></main>
    <Footer class={footerClass} />

    <script>
      // ── Scroll reveal animations ──────────────────────────────────
      const animated = document.querySelectorAll<HTMLElement>('.has-anim');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                io.unobserve(entry.target);
              }
            }
          },
          { rootMargin: '0px 0px -15% 0px' },
        );
        animated.forEach((el) => io.observe(el));
      } else {
        animated.forEach((el) => el.classList.add('is-visible'));
      }

      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ── Header hide-on-scroll-down ────────────────────────────────
      // (stays visible while something inside it has keyboard focus)
      const header = document.getElementById('site-header');
      let lastScroll = 0;
      let headerFrame = 0;
      const updateHeader = () => {
        headerFrame = 0;
        const y = window.scrollY;
        if (header) {
          const hide = y > 300 && y > lastScroll && !header.contains(document.activeElement);
          header.classList.toggle('-translate-y-full', hide);
          // pinning shrinks the header (it's sticky, so the page moves up with it); a gap
          // between the two thresholds, wider than that shift, stops it toggling back and
          // forth near 100px
          const pinned = header.classList.contains('sticky-pinned');
          header.classList.toggle('sticky-pinned', pinned ? y > 40 : y > 100);
        }
        lastScroll = y;
      };
      window.addEventListener(
        'scroll',
        () => {
          if (!headerFrame) headerFrame = requestAnimationFrame(updateHeader);
        },
        { passive: true },
      );
      header?.addEventListener('focusin', () => header.classList.remove('-translate-y-full'));

      // ── Scroll progress / back-to-top ─────────────────────────────
      const sp = document.querySelector<HTMLElement>('[data-scroll-progress]');
      const path = sp?.querySelector('path');
      if (sp && path) {
        const len = path.getTotalLength();
        path.style.strokeDasharray = `${len} ${len}`;
        path.style.strokeDashoffset = `${len}`;
        let frame = 0;
        const update = () => {
          frame = 0;
          const scrolled = window.scrollY;
          const height =
            document.documentElement.scrollHeight - window.innerHeight;
          path.style.strokeDashoffset = `${len - (scrolled * len) / (height || 1)}`;
          sp.classList.toggle('is-active', scrolled > 50);
        };
        window.addEventListener(
          'scroll',
          () => {
            if (!frame) frame = requestAnimationFrame(update);
          },
          { passive: true },
        );
        update();
        sp.addEventListener('click', () => {
          window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
          document.getElementById('main')?.focus({ preventScroll: true });
        });
      }

      // ── Mobile drawer ─────────────────────────────────────────────
      // Closed: `inert` + invisible, so its links can't be tabbed to. Open: focus
      // moves into it and Tab stays inside until it's closed.
      const drawer = document.getElementById('mobile-drawer');
      const overlay = document.querySelector('[data-menu-overlay]');
      const opener = document.querySelector<HTMLElement>('[data-menu-open]');
      let menuOpen = false;
      const openMenu = () => {
        if (!drawer) return;
        menuOpen = true;
        drawer.inert = false;
        drawer.classList.remove('translate-x-full', 'invisible');
        overlay?.classList.remove('invisible', 'opacity-0');
        opener?.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
        drawer.querySelector<HTMLElement>('[data-menu-close]')?.focus();
      };
      const closeMenu = () => {
        if (!drawer || !menuOpen) return;
        menuOpen = false;
        drawer.inert = true;
        drawer.classList.add('translate-x-full');
        overlay?.classList.add('invisible', 'opacity-0');
        opener?.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
        opener?.focus();
      };
      // hide the drawer (and its shadow) once the slide-out finishes
      drawer?.addEventListener('transitionend', (e) => {
        if (e.target === drawer && !menuOpen) drawer.classList.add('invisible');
      });
      opener?.addEventListener('click', openMenu);
      document
        .querySelector('[data-menu-close]')
        ?.addEventListener('click', closeMenu);
      overlay?.addEventListener('click', closeMenu);
      // close when a real link inside the drawer is tapped
      drawer?.querySelectorAll('a[href]').forEach((a) => {
        if (!a.hasAttribute('target')) a.addEventListener('click', closeMenu);
      });
      window.addEventListener('keydown', (e) => {
        if (!menuOpen || !drawer) return;
        if (e.key === 'Escape') closeMenu();
        // keep Tab inside the open drawer
        if (e.key === 'Tab') {
          const focusable = [...drawer.querySelectorAll<HTMLElement>('a[href], button')].filter(
            (el) => el.offsetParent !== null,
          );
          const first = focusable[0];
          const last = focusable[focusable.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault();
            last?.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault();
            first?.focus();
          }
        }
      });
      // close if the screen grows past the mobile breakpoint
      window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => {
        if (e.matches) closeMenu();
      });

      // ── Mobile dropdown accordions ────────────────────────────────
      const toggles = document.querySelectorAll<HTMLElement>('[data-dropdown-toggle]');
      const setSub = (btn: HTMLElement, open: boolean) => {
        const sub = btn.parentElement?.querySelector<HTMLElement>('[data-submenu]');
        btn.setAttribute('aria-expanded', String(open));
        btn.querySelector('[data-caret]')?.classList.toggle('rotate-180', open);
        if (!sub) return;
        sub.inert = !open;
        sub.style.maxHeight = open ? sub.scrollHeight + 'px' : '0px';
      };
      toggles.forEach((btn) => {
        btn.addEventListener('click', () => {
          const open = btn.getAttribute('aria-expanded') === 'true';
          toggles.forEach((other) => setSub(other, false));
          if (!open) setSub(btn, true);
        });
      });
    </script>
  </body>
</html>
