---
import PortfolioCard from '@/components/PortfolioCard.astro';

interface Project {
  slug?: string;
  /** link for the card; defaults to the project's case-study page */
  href?: string;
  title: string;
  category: string;
  color: string;
  carouselImage?: string;
  image: string;
  imageAlt?: string;
  /** text over the hover colour: `white` (default) or `dark` for light colours */
  tone?: 'white' | 'dark';
  /** a thin decorative line in the brand's second colour */
  accent?: string;
  /** the brand's logo for dark backgrounds and its edge gradient: a branded card */
  logo?: { src: string; alt: string };
  edge?: string;
}
interface Props {
  projects: Project[];
}
const { projects } = Astro.props;
// short lists are repeated until there are 8 slides so loop mode works; the
// counter still reports the real number of projects, and the repeats are kept
// out of the keyboard and screen-reader order
const slideItems: (Project & { repeat: boolean })[] = projects.map((p) => ({ ...p, repeat: false }));
while (projects.length && slideItems.length < 8) {
  slideItems.push(...projects.map((p) => ({ ...p, repeat: true })));
}
const total = String(projects.length).padStart(2, '0');
const btn = 'cursor-pointer px-3 py-2.5 text-[14px] font-bold tracking-wider text-black uppercase transition hover:opacity-60';
---

{projects.length > 0 && (
<div class="portfolio-carousel-fluid" data-total={projects.length}>
  <div class="swiper">
    <div class="swiper-wrapper">
      {
        slideItems.map((p) => (
          <div class="swiper-slide" aria-hidden={p.repeat ? 'true' : undefined} data-repeat={p.repeat ? '' : undefined}>
            <PortfolioCard
              variant="carousel"
              href={p.href ?? `/portfolio/${p.slug}`}
              image={p.carouselImage ?? p.image}
              title={p.title}
              category={p.category}
              color={p.color}
              imageAlt={p.repeat ? '' : p.imageAlt}
              tone={p.tone}
              accent={p.accent}
              logo={p.logo && (p.repeat ? { ...p.logo, alt: '' } : p.logo)}
              edge={p.edge}
              titleClass="text-h3"
              class="mx-3.75 lg:mx-7.5 xl:mx-10 aspect-[3/2]"
            />
          </div>
        ))
      }
    </div>
  </div>

  <div class="mt-4 text-center">
    <button type="button" class:list={['pf-prev', btn]}>Prev</button>
    <button type="button" class:list={['pf-next', btn]}>Next</button>
  </div>

  <div class="swipeCarousel-control pointer-events-none relative h-9.5" aria-hidden="true">
    <div class="pf-progress swiper-pagination"></div>
    <div
      class="absolute top-[calc(50%+5px)] left-[calc(50%-200px)] leading-none font-semibold text-black max-[575px]:left-[calc(50%-140px)]"
      data-active
    >
      01
    </div>
    <div
      class="absolute top-[calc(50%+5px)] right-[calc(50%-200px)] leading-none font-semibold text-black max-[575px]:right-[calc(50%-140px)]"
    >
      {total}
    </div>
  </div>
</div>
)}

<style is:global>
  .portfolio-carousel-fluid {
    --swiper-pagination-color: var(--color-dark);
    --swiper-pagination-progressbar-bg-color: color-mix(in srgb, var(--color-dark) 12%, transparent);
  }
  .portfolio-carousel-fluid .swiper-pagination-progressbar {
    position: absolute !important;
    top: auto !important;
    bottom: 5px !important;
    left: calc(50% - 165px) !important;
    width: 330px !important;
    height: 3px !important;
  }
  @media (max-width: 575px) {
    .portfolio-carousel-fluid .swiper-pagination-progressbar {
      left: calc(50% - 100px) !important;
      width: 200px !important;
    }
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Mousewheel, FreeMode } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  document.querySelectorAll<HTMLElement>('.portfolio-carousel-fluid').forEach((root) => {
    const el = root.querySelector<HTMLElement>('.swiper');
    if (!el) return;

    // repeated slides: still clickable, but not tabbable
    root.querySelectorAll('[data-repeat] a').forEach((a) => a.setAttribute('tabindex', '-1'));

    const active = root.querySelector<HTMLElement>('[data-active]');
    const totalReal = Number(root.dataset.total) || 1;
    const progressEl = root.querySelector<HTMLElement>('.pf-progress');
    const nextEl = root.querySelector<HTMLElement>('.pf-next');
    const prevEl = root.querySelector<HTMLElement>('.pf-prev');

    new Swiper(el, {
      modules: [Navigation, Pagination, Mousewheel, FreeMode],
      slidesPerView: 2,
      spaceBetween: 0,
      speed: 600,
      loop: true,
      loopAdditionalSlides: 3,
      centeredSlides: true,
      freeMode: { enabled: true, sticky: false },
      mousewheel: { forceToAxis: true, sensitivity: 1, releaseOnEdges: true },
      breakpoints: {
        0: { slidesPerView: 1 },
        640: { slidesPerView: 2 },
      },
      pagination: progressEl ? { el: progressEl, type: 'progressbar' } : false,
      navigation: nextEl && prevEl ? { nextEl, prevEl } : false,
      on: {
        slideChange(sw) {
          if (active && typeof sw.realIndex === 'number')
            active.textContent = String((sw.realIndex % totalReal) + 1).padStart(2, '0');
        },
      },
    });
  });
</script>
