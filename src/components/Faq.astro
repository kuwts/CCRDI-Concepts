---
interface FaqItem {
  question: string;
  answer: string;
}
interface FaqGroup {
  title: string;
  items: FaqItem[];
}
interface Props {
  groups: FaqGroup[];
  /** Heading level for the group titles: `h2` directly under the page title (default), `h3` under a section heading. */
  headingLevel?: 'h2' | 'h3';
}
const { groups, headingLevel: Heading = 'h2' } = Astro.props;

// unique ids per accordion, so several can share a page
const uid = Math.random().toString(36).slice(2, 8);
---

<style>
  .faq-answer-wrapper {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.35s var(--ease-theme);
  }
  .faq-item.is-open .faq-answer-wrapper {
    grid-template-rows: 1fr;
  }
  .faq-answer-wrapper > * {
    overflow: hidden;
  }
  .faq-icon {
    transition: transform 0.3s var(--ease-theme);
  }
  .faq-item.is-open .faq-icon {
    transform: rotate(45deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .faq-answer-wrapper,
    .faq-icon {
      transition: none;
    }
  }
</style>

{groups.length > 0 && (
<div data-faq>
  {groups.map((group, gi) => (
    <div class:list={[gi > 0 && 'not-first:mt-10']}>
      <Heading class="text-dark text-lg font-medium has-anim fade mb-4">{group.title}</Heading>
      <div class="space-y-2.5">
        {group.items.map((item, ii) => {
          const id = `faq-${uid}-${gi}-${ii}`;
          return (
            <div class="faq-item has-anim fade">
              <button
                type="button"
                class="faq-summary bg-white border border-dark/10 flex w-full cursor-pointer items-center justify-between gap-4 py-4 px-7 text-[18px] font-semibold text-dark text-left"
                aria-expanded="false"
                aria-controls={id}
              >
                {item.question}
                <span class="faq-icon shrink-0 text-2xl leading-none" aria-hidden="true">
                  <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24"><path fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/></svg>
                </span>
              </button>
              <div class="faq-answer-wrapper" id={id} inert>
                <div class="bg-light text-dark">
                  <div class="content border border-t-0 border-black/12.5 p-6" set:html={item.answer} />
                </div>
              </div>
            </div>
          );
        })}
      </div>
    </div>
  ))}
</div>
)}

<script>
  // One open answer per accordion. Closed answers are `inert`, so their links
  // can't be tabbed to.
  document.querySelectorAll<HTMLElement>('[data-faq]').forEach((faq) => {
    const setOpen = (item: Element, open: boolean) => {
      item.classList.toggle('is-open', open);
      item.querySelector('.faq-summary')?.setAttribute('aria-expanded', String(open));
      const answer = item.querySelector<HTMLElement>('.faq-answer-wrapper');
      if (answer) answer.inert = !open;
    };
    faq.addEventListener('click', (e) => {
      if (!(e.target instanceof Element)) return;
      const item = e.target.closest('.faq-summary')?.closest('.faq-item');
      if (!item) return;
      const isOpen = item.classList.contains('is-open');
      faq.querySelectorAll('.faq-item.is-open').forEach((el) => setOpen(el, false));
      if (!isOpen) setOpen(item, true);
    });
  });
</script>
