---
import { Icon } from 'astro-icon/components';
import AstroImage from '@/components/helper/AstroImage.astro';
import AstroVideo from '@/components/helper/AstroVideo.astro';
import PauseButton from '@/components/PauseButton.astro';
import { socialNetwork } from '@/utils/social';

interface Testimonial {
  review: string;
  author: string;
  role?: string;
  company?: string;
  rating?: number;
  date?: string;
  social?: string;
  media?: string;
}
interface Props {
  items: Testimonial[];
  light?: boolean;
  testimonials: {
    total_rating?: string;
    total_reviews?: string;
    top_companies?: {
      name: string;
      logo: string;
    }[];
  };
}
const { items, light = false, testimonials } = Astro.props;

const isVideo = (src?: string) => !!src && /\.(mp4|webm|mov|ogv)$/i.test(src);

// In a production build the theme's demo-only media (the dev pages' blog, portfolio, team,
// client and testimonial assets and the demo showreel; brief/cleanup-list.md) is left out of
// this glob, so Vite doesn't emit it; `astro dev` resolves everything for the dev pages.
const videoModules = import.meta.env.DEV
  ? import.meta.glob<{ default: string }>('/src/assets/**/*.{mp4,webm,ogv,ogg,mov}')
  : import.meta.glob<{ default: string }>(['/src/assets/**/*.{mp4,webm,ogv,ogg,mov}', '!/src/assets/videos/showreel.*', '!/src/assets/images/testimonials/**']);

const resolveVideo = async (path: string | undefined): Promise<string> => {
  if (!path) return '';
  const normalized = path.startsWith('/') ? path : `/${path}`;
  const candidates = [
    `/src/assets${normalized}`,
    `/src/assets/images${normalized}`,
    `/src${normalized}`,
  ];
  for (const candidate of candidates) {
    if (videoModules[candidate]) {
      const mod = await videoModules[candidate]();
      return mod.default;
    }
  }
  return path;
};

const resolvedMediaMap = new Map<string, string>();
for (const t of items) {
  if (t.media && isVideo(t.media) && !resolvedMediaMap.has(t.media)) {
    resolvedMediaMap.set(t.media, await resolveVideo(t.media));
  }
}

const getResolvedMedia = (media: string | undefined): string => {
  if (!media) return '';
  return resolvedMediaMap.get(media) ?? media;
};

const slides = items;
const ctrl = light ? 'text-white' : 'text-dark';
// the summary card only shows when there's something to put on it
const hasSummary = !!(testimonials?.total_rating || testimonials?.total_reviews || testimonials?.top_companies?.length);
const hasVideo = items.some((t) => isVideo(t.media));
const ratingLabel = (n: number) => `Rated ${n} out of 5`;
// stars and the big number only for a real rating, so placeholder text never implies one
const hasRating = /^\d+(\.\d+)?$/.test(testimonials?.total_rating ?? '');
---

<!-- per-instance root (no transform, so the fixed popup inside still covers the viewport) -->
{(hasSummary || slides.length > 0) && (
<div data-review-root>
<div class="review-carousel relative has-anim fade" data-total={items.length}>
  {hasVideo && <PauseButton label="testimonial videos" class="top-2 left-1/2 -translate-x-1/2" />}
  <div class="overflow-clip">
    <div class="container">
      <div class="swiper overflow-visible!">
        <div class="swiper-wrapper cursor-grab">
          {/* Info card */}
          {hasSummary && (
          <div class="swiper-slide h-auto! px-3">
            <div class="group relative h-full min-h-90 overflow-hidden bg-white rounded-card">
              <div class="relative z-10 flex h-full flex-col items-center justify-center p-6 md:p-7">
                <p class:list={['font-bold text-black/40 sm:mt-auto', hasRating ? 'text-8xl' : 'text-xl text-center text-dark/70']}>{testimonials?.total_rating}</p>
                {hasRating && (
                <div class="flex gap-0.5 text-lg text-amber-400 my-3" role="img" aria-label={`${testimonials?.total_rating} out of 5`}>
                  {Array.from({ length: 5 }).map(() => (
                    <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none" /><path fill="currentColor" d="M9.153 5.408C10.42 3.136 11.053 2 12 2s1.58 1.136 2.847 3.408l.328.588c.36.646.54.969.82 1.182s.63.292 1.33.45l.636.144c2.46.557 3.689.835 3.982 1.776c.292.94-.546 1.921-2.223 3.882l-.434.507c-.476.557-.715.836-.822 1.18c-.107.345-.071.717.001 1.46l.066.677c.253 2.617.38 3.925-.386 4.506s-1.918.051-4.22-1.009l-.597-.274c-.654-.302-.981-.452-1.328-.452s-.674.15-1.328.452l-.596.274c-2.303 1.06-3.455 1.59-4.22 1.01c-.767-.582-.64-1.89-.387-4.507l.066-.676c.072-.744.108-1.116 0-1.46c-.106-.345-.345-.624-.821-1.18l-.434-.508c-1.677-1.96-2.515-2.941-2.223-3.882S3.58 8.328 6.04 7.772l.636-.144c.699-.158 1.048-.237 1.329-.45s.46-.536.82-1.182z" /></svg>
                  ))}
                </div>
                )}
                <p class:list={['text-dark font-medium', !hasRating && 'mt-3 text-center']}>{testimonials?.total_reviews}</p>
                
                <div class="hidden sm:flex mt-auto gap-4">
                  {testimonials?.top_companies?.map((c) => (
                    <AstroImage
                      src={`/${c.logo}`}
                      alt={c.name}
                      width={120}
                      height={24}
                      loading="lazy"
                      class="h-6 object-contain invert-100 max-w-full"
                    />
                  ))}
                </div>
              </div>
            </div>
          </div>
          )}
          {slides.map((t) => (
            <div class="swiper-slide h-auto! px-3">
              {isVideo(t.media) ? (
                /* ── video card ── */
                <div class="group relative h-full min-h-90 overflow-hidden bg-dark rounded-card">
                  {/* started by the script below, unless the visitor prefers reduced motion */}
                  <AstroVideo
                    src={t.media}
                    muted
                    loop
                    playsinline
                    preload="none"
                    class="absolute inset-0 size-full object-cover"
                    aria-hidden="true"
                    data-review-autoplay
                  />
                  <div class="absolute inset-0 bg-linear-to-b from-black/40 via-transparent to-black/60"></div>

                  <div class="relative z-10 flex h-full flex-col justify-between p-6 md:p-7 text-white">
                    <div class="flex items-start justify-between">
                      <div>
                        <p class="text-lg font-semibold leading-tight">{t.author}</p>
                        {t.company && <p class="mt-0.5 text-sm text-white">{t.company}</p>}
                      </div>
                      {t.social && (
                        <a
                          href={t.social}
                          target="_blank"
                          rel="noopener noreferrer"
                          aria-label={`${t.author} on ${socialNetwork(t.social).name}`}
                          class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-white/15 backdrop-blur-sm transition hover:bg-white/25"
                        >
                          <Icon name={socialNetwork(t.social).icon} class="size-4" aria-hidden="true" />
                        </a>
                      )}
                    </div>

                    <button
                      type="button"
                      class="mx-auto flex size-12 items-center justify-center rounded-full bg-white text-dark shadow-lg transition-transform duration-300 hover:scale-110 cursor-pointer"
                      data-review-play
                      data-src={getResolvedMedia(t.media)}
                      aria-label={`Play video testimonial from ${t.author}`}
                      aria-haspopup="dialog"
                    >
                      <Icon name="lucide:play" class="ml-0.5 size-5" aria-hidden="true" />
                    </button>

                    <div class="flex items-center justify-between">
                      <div class="flex gap-0.5 text-lg text-amber-400" role="img" aria-label={ratingLabel(t.rating ?? 5)}>
                        {Array.from({ length: 5 }).map((_, i) => (
                          <span class={i < (t.rating ?? 5) ? '' : 'text-white/30'}>
                            <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="1em" height="1em" viewBox="0 0 24 24"><path d="M0 0h24v24H0z" fill="none" /><path fill="currentColor" d="M9.153 5.408C10.42 3.136 11.053 2 12 2s1.58 1.136 2.847 3.408l.328.588c.36.646.54.969.82 1.182s.63.292 1.33.45l.636.144c2.46.557 3.689.835 3.982 1.776c.292.94-.546 1.921-2.223 3.882l-.434.507c-.476.557-.715.836-.822 1.18c-.107.345-.071.717.001 1.46l.066.677c.253 2.617.38 3.925-.386 4.506s-1.918.051-4.22-1.009l-.597-.274c-.654-.302-.981-.452-1.328-.452s-.674.15-1.328.452l-.596.274c-2.303 1.06-3.455 1.59-4.22 1.01c-.767-.582-.64-1.89-.387-4.507l.066-.676c.072-.744.108-1.116 0-1.46c-.106-.345-.345-.624-.821-1.18l-.434-.508c-1.677-1.96-2.515-2.941-2.223-3.882S3.58 8.328 6.04 7.772l.636-.144c.699-.158 1.048-.237 1.329-.45s.46-.536.82-1.182z" /></svg>
                          </span>
                        ))}
                      </div>
                      {t.date && <span class="text-sm font-medium text-white/70">{t.date}</span>}
                    </div>
                  </div>
                </div>
              ) : (
                /* ── image and text card ── */
                <div class="flex h-full min-h-90 flex-col bg-white p-6 md:p-7 rounded-card">
                  <p class="mb-6 flex-1 sm:text-xl leading-relaxed text-dark">
                    {t.review}
                  </p>

                  <div class="flex items-center justify-between">
                    <div class="flex items-center gap-3">
                      {t.media && (
                        <AstroImage
                          src={t.media}
                          alt=""
                          width={48}
                          height={48}
                          loading="lazy"
                          class="size-12 rounded-full object-cover"
                        />
                      )}
                      <div>
                        <p class="font-semibold text-dark leading-tight">{t.author}</p>
                        {(t.role || t.company) && (
                          <p class="mt-0.5 text-sm text-dark/70">{t.role ?? t.company}</p>
                        )}
                      </div>
                    </div>
                    {t.social && (
                      <a
                        href={t.social}
                        target="_blank"
                        rel="noopener noreferrer"
                        aria-label={`${t.author} on ${socialNetwork(t.social).name}`}
                        class="flex size-9 shrink-0 items-center justify-center rounded-lg bg-black/5 text-dark transition hover:bg-black/10"
                      >
                        <Icon name={socialNetwork(t.social).icon} class="size-4" aria-hidden="true" />
                      </a>
                    )}
                  </div>
                </div>
              )}
            </div>
          ))}
        </div>
      </div>
    </div>

    {/* pagination dots */}
    <div class:list={['mt-12 -mb-2 flex items-center justify-center', ctrl]}>
      <div class="swiper-pagination"></div>
    </div>
  </div>

</div>

{/* video popup (outside has-anim to keep position:fixed working); inert while closed */}
<div
  class="pointer-events-none fixed top-0 left-0 h-screen w-screen z-9999999 flex items-center justify-center bg-dark/90 p-6 opacity-0 transition-opacity duration-300"
  data-review-modal
  role="dialog"
  aria-modal="true"
  aria-label="Video testimonial"
  inert
>
  <button
    type="button"
    class="group absolute top-6 right-6 z-10 flex size-10 items-center justify-center rounded-full bg-white/10 text-white transition hover:rotate-90 hover:bg-white/20 cursor-pointer"
    data-review-close
    aria-label="Close video"
  >
    <Icon name="lucide:x" class="size-4 transition group-hover:scale-130" aria-hidden="true" />
  </button>
  <video
    class="max-h-[85vh] max-w-[90vw] rounded-lg"
    controls
    playsinline
    data-review-modal-video
  ></video>
</div>
</div>
)}

<style is:global>
  .review-carousel .swiper-slide {
    height: auto;
  }
  .review-carousel .swiper-pagination {
    --swiper-pagination-bullet-inactive-color: currentColor;
    --swiper-pagination-color: currentColor;
    --swiper-pagination-bullet-inactive-opacity: 0.3;
    --swiper-pagination-bullet-opacity: 1;
  }
</style>

<script>
  import Swiper from 'swiper';
  import { Pagination, FreeMode, Mousewheel } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-review-root]').forEach((root) => {
    const el = root.querySelector<HTMLElement>('.review-carousel .swiper');
    if (!el) return;

    // Muted background videos on video cards: they only load and play while the
    // carousel is on screen, the tab is visible and nothing pauses them (hover,
    // keyboard focus inside the carousel, or the pause button). Never with
    // reduced motion. The play button still opens the full video either way.
    const cardVideos = [...root.querySelectorAll<HTMLVideoElement>('[data-review-autoplay]')];
    const pauseToggle = root.querySelector<HTMLButtonElement>('[data-pause-toggle]');
    if (!reduceMotion && cardVideos.length) {
      const carousel = root.querySelector<HTMLElement>('.review-carousel')!;
      let onScreen = false;
      let hovered = false;
      let focused = false;
      let paused = false;
      const sync = () => {
        const run = onScreen && !hovered && !focused && !paused && !document.hidden;
        cardVideos.forEach((v) => {
          if (run && v.paused) v.play().catch(() => {});
          else if (!run && !v.paused) v.pause();
        });
      };
      new IntersectionObserver(([e]) => {
        onScreen = e.isIntersecting;
        sync();
      }).observe(carousel);
      document.addEventListener('visibilitychange', sync);
      carousel.addEventListener('mouseenter', () => { hovered = true; sync(); });
      carousel.addEventListener('mouseleave', () => { hovered = false; sync(); });
      carousel.addEventListener('focusin', (e) => { focused = e.target !== pauseToggle; sync(); });
      carousel.addEventListener('focusout', () => { focused = false; sync(); });
      pauseToggle?.addEventListener('click', () => {
        paused = !paused;
        pauseToggle.setAttribute('aria-pressed', String(paused));
        pauseToggle.textContent = `${paused ? 'Play' : 'Pause'} testimonial videos`;
        sync();
      });
    } else {
      pauseToggle?.remove();
    }

    new Swiper(el, {
      modules: [Pagination, FreeMode, Mousewheel],
      slidesPerView: 1,
      spaceBetween: 0,
      speed: 600,
      loop: false,
      loopAdditionalSlides: 2,
      freeMode: { enabled: true, sticky: false },
      mousewheel: { forceToAxis: true, releaseOnEdges: true },
      breakpoints: {
        0: { slidesPerView: 1.1 },
        375: { slidesPerView: 1.5 },
        768: { slidesPerView: 2.3 },
        1024: { slidesPerView: 2.6 },
        1280: { slidesPerView: 3.5 },
      },
      pagination: {
        el: root.querySelector<HTMLElement>('.swiper-pagination'),
        clickable: true,
        dynamicBullets: true,
      },
    });

    // ── video popup ──
    const modal = root.querySelector<HTMLElement>('[data-review-modal]');
    const modalVideo = root.querySelector<HTMLVideoElement>('[data-review-modal-video]');
    const closeBtn = root.querySelector<HTMLElement>('[data-review-close]');

    if (modal && modalVideo && closeBtn) {
      let isOpen = false;
      let returnTo: HTMLElement | null = null;
      const openModal = (src: string, trigger: HTMLElement) => {
        isOpen = true;
        returnTo = trigger;
        modalVideo.src = src;
        modal.inert = false;
        modal.style.opacity = '1';
        modal.style.pointerEvents = 'auto';
        document.body.style.overflow = 'hidden';
        modalVideo.currentTime = 0;
        modalVideo.play().catch(() => {});
        closeBtn.focus();
      };
      const closeModal = () => {
        // only the open instance reacts (Escape reaches every instance)
        if (!isOpen) return;
        isOpen = false;
        modalVideo.pause();
        modalVideo.removeAttribute('src');
        modalVideo.load();
        modal.style.opacity = '0';
        modal.style.pointerEvents = 'none';
        modal.inert = true;
        document.body.style.overflow = '';
        returnTo?.focus();
      };

      root.querySelectorAll<HTMLElement>('[data-review-play]').forEach((btn) => {
        btn.addEventListener('click', () => {
          const src = btn.dataset.src;
          if (src) openModal(src, btn);
        });
      });
      closeBtn.addEventListener('click', closeModal);
      modal.addEventListener('click', (e) => {
        if (e.target === modal) closeModal();
      });
      document.addEventListener('keydown', (e) => {
        if (!isOpen) return;
        if (e.key === 'Escape') closeModal();
        // Tab cycles between the close button and the video controls
        if (e.key === 'Tab') {
          e.preventDefault();
          (document.activeElement === closeBtn ? modalVideo : closeBtn).focus();
        }
      });
    }
  });
</script>
