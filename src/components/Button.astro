---
interface Props {
  label: string;
  href?: string;
  /** gold-outline button: `white` on navy backgrounds, `black` on light ones; `primary`: solid,
   *  white on the primary colour */
  variant?: 'white' | 'black' | 'primary';
  type?: 'button' | 'submit';
  block?: boolean;
  target?: string;
  rel?: string;
  class?: string;
}

const {
  label,
  href,
  variant = 'white',
  type = 'button',
  block = false,
  target,
  rel,
  class: className = '',
} = Astro.props;

const variantClass = { white: 'btn-white', black: 'btn-black', primary: 'btn-primary' }[variant];
const classes = ['btn', variantClass, block ? 'flex w-full' : '', className]
  .filter(Boolean)
  .join(' ');
---

{
  href ? (
    <a href={href} class={classes} target={target} rel={rel ?? (target === '_blank' ? 'noopener' : undefined)}>
      <span>{label}</span>
    </a>
  ) : (
    <button type={type} class={classes}>
      <span>{label}</span>
    </button>
  )
}
