---
// Pause / play control for moving content (logo wall, marquee, autoplaying video).
// Hidden until it gets keyboard focus, so it doesn't change the design; the
// component that owns it listens for clicks and keeps `aria-pressed` in sync.
// Needs a `relative` parent.
import { fill, getLang, ui } from '@/i18n';

// labels in the page's language (site.config.json → ui)
const t = ui(getLang(Astro.url));

interface Props {
  /** What it pauses, in the page's language (site.config.json → ui.pauseLabels), e.g. "logo
   *  animation"; read as "Pause logo animation". */
  label: string;
  /** Position classes; default `top-2 left-2`. */
  class?: string;
}

const { label, class: className = 'top-2 left-2' } = Astro.props;
---

<button
  type="button"
  class:list={[
    'sr-only-focusable absolute z-30 cursor-pointer bg-white px-4 py-2 text-sm font-medium text-dark shadow-lg',
    className,
  ]}
  aria-pressed="false"
  data-pause-toggle
  data-pause-text={fill(t.pause, { label })}
  data-play-text={fill(t.play, { label })}
>
  {fill(t.pause, { label })}
</button>
