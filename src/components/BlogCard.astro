---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';
import { readingTime } from '@/utils/readingTime';
import AstroImage from '@/components/helper/AstroImage.astro';
import { Icon } from "astro-icon/components";

interface Props {
  post: CollectionEntry<'blog'>;
  horizontal?: boolean;
  category?: string;
  class?: string;
}

const {
  post,
  horizontal = false,
  category: categoryOverride,
  class: className = '',
} = Astro.props;

const href = `/blog/${post.id}`;
const { title, description, date, color } = post.data;
const image = post.data.thumbnail ?? post.data.image;
const category = categoryOverride ?? post.data.category;
const readTime = readingTime(post.body ?? '');

const headingClass = 'text-balance leading-snug font-bold text-dark underline decoration-transparent transition group-hover/img:text-[#222] group-hover/img:decoration-[#444]';
---

<article
  class:list={[
    'relative mt-7.5 p-4 md:p-7',
    className,
  ]}
>
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.05]"
    style={`background-color:${color}`}>
  </div>

  {
    horizontal ? (
      <div class="group/img row justify-center">
        <div class="lg:col-6">
          <a href={href} class="block overflow-hidden after:absolute after:inset-0">
            <AstroImage
              src={image}
              alt={title}
              loading="lazy"
              class="w-full origin-right scale-[1.02] transition-all duration-300 group-hover/img:origin-left bg-gray-100"
            />
          </a>
        </div>
        <div class="lg:col-6">
          <div class="mt-6 sm:mt-8 lg:mt-0 text-dark lg:h-full p-0 lg:p-6 lg:flex flex-col">
            <span class="mb-6 text-xs tracking-wider text-dark/80 uppercase bg-dark/5 px-2 py-1 inline-block w-max">
              {category}
            </span>
            <h3 class:list={['text-xl sm:text-[30px]', headingClass]}>
              {title}
            </h3>
            <p class="my-6 text-[15px] line-clamp-2">{description}</p>
            <div class="mt-0 lg:mt-auto flex items-end justify-between">
              <p class="text-[14px]">
                {formatDate(date)} <span class="mx-2">—</span> {readTime}
              </p>
              <span class="inline-flex items-center gap-1 text-[14px] text-dark group-hover/img:text-black transition group-hover/img:translate-x-1 group-hover/img:-translate-y-1">
                <Icon name="hugeicons:arrow-up-right-01" class="size-6" />
              </span>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="group/img">
        <a href={href} class="block overflow-hidden after:absolute after:inset-0">
          <AstroImage
            src={image}
            alt={title}
            loading="lazy"
            class="w-full origin-right scale-[1.02] transition-all duration-300 group-hover/img:origin-left"
          />
        </a>
        <div class="mt-6 text-dark h-full">
          <span class="mb-4 text-xs tracking-wider text-dark/80 uppercase bg-dark/5 px-2 py-1 inline-block w-max">
            {category}
          </span>
          <h4 class:list={['text-xl sm:text-[24px] line-clamp-2', headingClass]}>
            {title}
          </h4>
          <p class="mt-3 mb-6 text-[15px] line-clamp-2">{description}</p>
          <div class="mt-auto flex items-end justify-between">
            <p class="text-[14px]">
              {formatDate(date)} <span class="mx-2">—</span> {readTime}
            </p>
            <span class="inline-flex items-center gap-1 text-[14px] text-dark group-hover/img:text-black transition group-hover/img:translate-x-1 group-hover/img:-translate-y-1">
              <Icon name="hugeicons:arrow-up-right-01" class="size-6" />
            </span>
          </div>
        </div>
      </div>
    )
  }
</article>
