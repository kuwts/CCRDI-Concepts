---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';
import { readingTime } from '@/utils/readingTime';
import AstroImage from '@/components/helper/AstroImage.astro';
import { Icon } from "astro-icon/components";

/** A card without a blog post behind it (e.g. a homepage news item); the date is shown as written. */
interface CardItem {
  title: string;
  description: string;
  date: string;
  category?: string;
  image?: string;
  imageAlt?: string;
  href: string;
}

interface Props {
  post?: CollectionEntry<'blog'>;
  item?: CardItem;
  horizontal?: boolean;
  category?: string;
  /** Heading level for the title: `h2` on listing pages, `h3` under a section heading (default). */
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  post,
  item,
  horizontal = false,
  category: categoryOverride,
  as: Heading = 'h3',
  class: className = '',
} = Astro.props;

const href = post ? `/blog/${post.id}` : (item?.href ?? '#');
const title = post?.data.title ?? item?.title ?? '';
const description = post?.data.description ?? item?.description ?? '';
const color = post?.data.color;
const image = post ? (post.data.thumbnail ?? post.data.image) : item?.image;
const imageAlt = item?.imageAlt ?? '';
const category = categoryOverride ?? post?.data.category ?? item?.category;
// "date — reading time" for posts; the date as written for plain items
const meta = post
  ? [formatDate(post.data.date), readingTime(post.body ?? '')]
  : [item?.date ?? ''];

const headingClass = 'text-dark underline decoration-transparent transition group-hover/img:text-black group-hover/img:decoration-dark/70 break-words';
// wraps when the label is wider than the card (long taglines)
const chipClass = 'text-[13px] sm:text-xs tracking-wider text-dark/80 uppercase bg-dark/5 px-2 py-1 inline-block w-fit max-w-full';
// posts are clamped to 2 lines; plain items (approved copy) are shown in full
const clamp = post ? 'line-clamp-2' : '';
---

<article
  class:list={[
    'relative mt-7.5 p-4 md:p-7 rounded-card overflow-hidden',
    className,
  ]}
>
  {color && (
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.05]"
    style={`background-color:${color}`}>
  </div>
  )}

  {
    horizontal ? (
      <div class="group/img row justify-center">
        <div class="lg:col-6">
          <a href={href} aria-label={title} class="block overflow-hidden rounded-card after:absolute after:inset-0">
            <AstroImage
              src={image}
              alt={imageAlt}
              loading="lazy"
              class="w-full aspect-[3/2] object-cover transition-[scale] duration-(--duration-slow) ease-theme group-hover/img:scale-(--zoom-image) group-focus-within/img:scale-(--zoom-image) motion-reduce:transition-none bg-gray-100"
            />
          </a>
        </div>
        <div class="lg:col-6">
          <div class="mt-6 sm:mt-8 lg:mt-0 text-dark lg:h-full p-0 lg:p-6 lg:flex flex-col">
            {category && <span class:list={['mb-6', chipClass]}>{category}</span>}
            <Heading class:list={['text-statement', headingClass]}>
              {title}
            </Heading>
            <p class:list={['my-6 text-[15px]', clamp]}>{description}</p>
            <div class="mt-0 lg:mt-auto flex items-end justify-between">
              <p class="text-[14px]">
                {meta[0]}{meta[1] && <><span class="mx-2" aria-hidden="true">—</span> {meta[1]}</>}
              </p>
              <span class="inline-flex items-center gap-1 text-[14px] text-dark group-hover/img:text-black transition group-hover/img:translate-x-1 group-hover/img:-translate-y-1" aria-hidden="true">
                <Icon name="lucide:arrow-up-right" class="size-6" />
              </span>
            </div>
          </div>
        </div>
      </div>
    ) : (
      <div class="group/img">
        <a href={href} aria-label={title} class="block overflow-hidden rounded-card after:absolute after:inset-0">
          <AstroImage
            src={image}
            alt={imageAlt}
            loading="lazy"
            class="w-full aspect-[3/2] object-cover transition-[scale] duration-(--duration-slow) ease-theme group-hover/img:scale-(--zoom-image) group-focus-within/img:scale-(--zoom-image) motion-reduce:transition-none"
          />
        </a>
        <div class="mt-6 text-dark h-full">
          {category && <span class:list={['mb-4', chipClass]}>{category}</span>}
          <Heading class:list={['text-h3', clamp, headingClass]}>
            {title}
          </Heading>
          <p class:list={['mt-3 mb-6 text-[15px]', clamp]}>{description}</p>
          <div class="mt-auto flex items-end justify-between">
            <p class="text-[14px]">
              {meta[0]}{meta[1] && <><span class="mx-2" aria-hidden="true">—</span> {meta[1]}</>}
            </p>
            <span class="inline-flex items-center gap-1 text-[14px] text-dark group-hover/img:text-black transition group-hover/img:translate-x-1 group-hover/img:-translate-y-1" aria-hidden="true">
              <Icon name="lucide:arrow-up-right" class="size-6" />
            </span>
          </div>
        </div>
      </div>
    )
  }
</article>
