---
import { animDelay } from '@/utils/animDelay';
import SectionTitle from '@/components/SectionTitle.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import LineLink from '@/components/LineLink.astro';

interface Step {
  heading: string;
  text: string;
}
interface Props {
  subtitle: string;
  title: string;
  steps: Step[];
  cta: {
    title: string;
    /** a plain path is decorative; `{ src, alt }` describes the photo; empty = no photos */
    images?: (string | { src: string; alt?: string })[];
    button: {
      label: string;
      href: string;
      target?: string;
    };
  };
  /** cards per row from lg (default 4) */
  columns?: 3 | 4;
  /** section padding; defaults to the theme's */
  spacingClass?: string;
  class?: string;
}
const { subtitle, title, steps, cta, columns = 4, spacingClass = 'py-section', class: className = '' } = Astro.props;
const symbols = ['✳', '✺', '✲', '❋'];
const stripImages = (cta.images ?? []).map((img) =>
  typeof img === 'string' ? { src: img, alt: '' } : { src: img.src, alt: img.alt ?? '' },
);
---

<section class:list={['overflow-hidden', spacingClass, className]}>
  <div class="container">
    <SectionTitle subtitle={subtitle} title={title} background="dark" />
    
    <div class="row -mt-6">
      {
        steps.map((step, i) => (
          <div class:list={[columns === 3 ? 'lg:col-4' : 'lg:col-3', 'sm:col-6 has-anim mt-6', animDelay[i]]}>
            <div class:list={
              ['h-full flex flex-col bg-white/5 mx-auto text-white px-8 py-8 overflow-clip relative', i == 0 ? 'active' : '']
            }>
              <span class="text-6xl" aria-hidden="true">{symbols[i % symbols.length]}</span>
              <h3 class="mt-4 mb-24 text-h3">{step.heading}</h3>
              <p class="relative text-balance -mb-0.75 leading-relaxed mt-auto opacity-80">
                {step.text}
              </p>
            </div>
          </div>
        ))
      }
    </div>

    <div class="flex max-md:flex-col flex-wrap items-center mt-8 border-t border-white/5 pt-8">
      <div class="flex max-md:flex-col items-center gap-4 has-anim delay-100 max-md:text-center">
        {stripImages.length > 0 && <div class="flex">
          {stripImages.map((img, i) => (
            <AstroImage src={`/${img.src}`} alt={img.alt} class:list={['max-h-10 rounded-full', i > 0 ? '-ms-2' : '']} width={40} height={40} />
          ))}
        </div>}
        <p class="text-white text-balance">{cta.title}</p>
      </div>
      <div class="md:ms-auto max-md:mt-6 has-anim delay-200">
        <LineLink href={cta.button.href} label={cta.button.label} target={cta.button.target} tone="white" icon="arrow" />
      </div>
    </div>
  </div>
</section>