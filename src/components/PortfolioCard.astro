---
import AstroImage from '@/components/helper/AstroImage.astro';

interface Props {
  href: string;
  title: string;
  category: string;
  color: string;
  image: string;
  /** alt text for the image; empty = decorative (the title link names the project) */
  imageAlt?: string;
  /** text over the hover colour: `white` (default) or `dark` for light colours.
      Touch devices always use white, over the darkened image. */
  tone?: 'white' | 'dark';
  /** carousel: a short decorative line in the brand's second colour, shown with the colour wash */
  accent?: string;
  variant?: 'grid' | 'carousel';
  titleClass?: string;
  /** Heading level for the title: `h2` on listing pages, `h3` under a section heading (default). */
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  href,
  title,
  category,
  color,
  image,
  imageAlt = '',
  tone = 'white',
  accent,
  variant = 'grid',
  titleClass = 'text-h3',
  as: Heading = 'h3',
  class: className = '',
} = Astro.props;

const ease = 'ease-theme';
const textTone = tone === 'dark' ? 'text-dark touch:text-white' : 'text-white';
const underline = tone === 'dark' ? 'hover:decoration-current focus-visible:decoration-current' : 'hover:decoration-white focus-visible:decoration-white';
// hover reveals (zoom, color wash, title) also run while the title link has keyboard focus
const reveal = 'group-hover:translate-y-0 group-focus-within:translate-y-0';
---

<div class:list={['group relative block overflow-hidden rounded-card', className]}>
  <span class="relative block overflow-hidden">
    <AstroImage
      src={image}
      alt={imageAlt}
      loading="lazy"
      class:list={[
        'w-full max-w-full aspect-[3/2] object-cover transition-[scale] duration-(--duration-slow) group-hover:scale-(--zoom-image) group-focus-within:scale-(--zoom-image) motion-reduce:transition-none bg-gray-100',
        ease,
      ]}
    />
    <span
      class="absolute inset-0 z-2 opacity-0 transition-opacity duration-300 group-hover:opacity-95 group-focus-within:opacity-95"
      style={`background-color:${color}`}></span>
    <!-- touch devices: titles are always shown, so darken the image behind them -->
    <span
      class:list={[
        'absolute inset-0 z-2 hidden touch:block',
        variant === 'carousel' ? 'bg-black/40' : 'bg-linear-to-t from-black/70 via-black/10 to-transparent',
      ]}></span>
  </span>

  {
    variant === 'carousel' ? (
      <div class="absolute inset-0 z-3 flex items-center justify-center p-5 text-center">
        <div>
          <Heading
            class:list={[
              'mb-3 translate-y-15 opacity-0 transition-all delay-0 duration-300 group-hover:opacity-100 group-hover:delay-200 group-focus-within:opacity-100 touch:translate-y-0 touch:opacity-100 break-words',
              reveal,
              titleClass,
              ease,
              textTone,
            ]}
          >
            <a href={href} class:list={['underline decoration-transparent underline-offset-5 decoration-3 transition-all duration-300', textTone, underline]}>
              {title}
            </a>
          </Heading>
          {accent && (
            <span
              class:list={['mx-auto mb-3 block h-0.5 w-12 rounded-full translate-y-15 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:delay-200 group-focus-within:opacity-100 touch:translate-y-0 touch:opacity-100', reveal]}
              style={`background:${accent}`}
              aria-hidden="true"></span>
          )}
          <span class:list={[textTone, 'block text-[15px] translate-y-15 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:delay-200 group-focus-within:opacity-100 touch:translate-y-0 touch:opacity-100', reveal]}>
            {category}
          </span>
        </div>
      </div>
    ) : (
      <div class="absolute inset-x-0 bottom-0 z-3 p-8 md:p-12">
        <div class="overflow-hidden">
          <span
            class:list={[
              'mb-2 block translate-y-[calc(-100%-15px)] text-[15px] text-white/80 transition-transform duration-700 touch:translate-y-0',
              reveal,
              ease,
            ]}
          >
            {category}
          </span>
          <Heading
            class:list={[
              'mb-0 translate-y-full text-white transition-transform duration-700 touch:translate-y-0 break-words',
              reveal,
              titleClass,
              ease,
            ]}
          >
            <a href={href} class="text-white underline decoration-transparent underline-offset-4 decoration-2 hover:decoration-white focus-visible:decoration-white transition-all duration-300">
              {title}
            </a>
          </Heading>
        </div>
      </div>
    )
  }
</div>
