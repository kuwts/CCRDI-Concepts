---
import type { ImageMetadata } from 'astro';
import AstroImage from '@/components/helper/AstroImage.astro';

interface Props {
  href: string;
  title: string;
  category: string;
  color: string;
  image: string;
  /** alt text for the image; empty = decorative (the title link names the project) */
  imageAlt?: string;
  /** text over the hover colour: `white` (default) or `dark` for light colours.
      Touch devices always use white, over the darkened image. */
  tone?: 'white' | 'dark';
  /** carousel: a short decorative line in the brand's second colour, shown with the colour wash */
  accent?: string;
  /** carousel: the brand's logo for dark backgrounds; makes a branded card (photo under navy,
      an inset gradient edge, the logo as the heading) */
  logo?: { src: string; alt: string };
  /** branded card: the edge gradient, e.g. var(--edge-award) */
  edge?: string;
  variant?: 'grid' | 'carousel';
  titleClass?: string;
  /** Heading level for the title: `h2` on listing pages, `h3` under a section heading (default). */
  as?: 'h2' | 'h3' | 'h4';
  class?: string;
}

const {
  href,
  title,
  category,
  color,
  image,
  imageAlt = '',
  tone = 'white',
  accent,
  logo,
  edge,
  variant = 'grid',
  titleClass = 'text-h3',
  as: Heading = 'h3',
  class: className = '',
} = Astro.props;

const ease = 'ease-theme';
// branded card: size the logo by its shape, so a tall mark (the Award medal) carries the same
// visual weight as a wide wordmark
const logoFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/brands/*.{png,webp,jpg}', { eager: true });
const logoMeta = logo ? logoFiles[`/src/assets/${logo.src.replace(/^\//, '')}`]?.default : undefined;
const tallLogo = logoMeta ? logoMeta.width / logoMeta.height < 1.2 : false;
const textTone = tone === 'dark' ? 'text-dark touch:text-white' : 'text-white';
const underline = tone === 'dark' ? 'hover:decoration-current focus-visible:decoration-current' : 'hover:decoration-white focus-visible:decoration-white';
// hover reveals (zoom, color wash, title) also run while the title link has keyboard focus
const reveal = 'group-hover:translate-y-0 group-focus-within:translate-y-0';
---

{variant === 'carousel' && logo ? (
  /* Branded card: the photo under a navy overlay, an inset edge in the brand's colours, the
     logo as the heading (its alt names the brand; the link covers the card). On hover or
     focus: the photo zooms, the navy deepens, the edge's sheen sweeps, the logo lifts and the
     role rises in beneath it. Touch: everything shown at rest. */
  <div class:list={['group relative block overflow-hidden rounded-card bg-dark', className]} style={`--edge:${edge ?? 'var(--edge-award)'}`}>
    <AstroImage
      src={image}
      alt={imageAlt}
      loading="lazy"
      widths={[600, 900, 1200]}
      sizes="(min-width: 1024px) 45vw, 90vw"
      class="absolute inset-0 size-full object-cover transition-[scale] duration-(--duration-slow) ease-theme group-hover:scale-(--zoom-image) group-focus-within:scale-(--zoom-image) motion-reduce:transition-none"
    />
    <span class="absolute inset-0 bg-linear-to-b from-dark/60 via-dark/70 to-dark/90" aria-hidden="true"></span>
    {/* hover: the navy deepens a little so the logo and role stand out */}
    <span class="absolute inset-0 bg-dark/40 opacity-0 transition-opacity duration-(--duration-slow) group-hover:opacity-100 group-focus-within:opacity-100 touch:opacity-100 motion-reduce:transition-none" aria-hidden="true"></span>
    <span class="edge-ring" aria-hidden="true"></span>

    <div class="absolute inset-0 flex flex-col items-center justify-center p-10 text-center text-white">
      <Heading class="brand-card-logo transition-transform duration-(--duration-slow) ease-theme group-hover:-translate-y-3 group-focus-within:-translate-y-3 touch:-translate-y-3 motion-reduce:transition-none">
        <a href={href} class="inline-block rounded-sm after:absolute after:inset-0 focus-visible:outline-offset-8">
          <AstroImage src={logo.src} alt={logo.alt} height={320} class:list={['w-auto object-contain', tallLogo ? 'h-28 sm:h-32 lg:h-40' : 'h-20 sm:h-24 lg:h-28 max-w-[min(62vw,18rem)]']} />
        </a>
      </Heading>
      <div class:list={['translate-y-6 opacity-0 transition-all duration-(--duration-slow) ease-theme group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:translate-y-0 group-focus-within:opacity-100 touch:translate-y-0 touch:opacity-100 motion-reduce:transition-none']}>
        {/* the brand's second colour; Heritage Gold for the Award, whose mark is all gold */}
        <span class="mx-auto mt-6 mb-3 block h-0.5 w-12 rounded-full" style={`background:${accent ?? 'var(--color-primary)'}`} aria-hidden="true"></span>
        <span class="block text-[15px] text-white">{category}</span>
      </div>
    </div>
  </div>
) : (
<div class:list={['group relative block overflow-hidden rounded-card', className]}>
  <span class="relative block overflow-hidden">
    <AstroImage
      src={image}
      alt={imageAlt}
      loading="lazy"
      class:list={[
        'w-full max-w-full aspect-[3/2] object-cover transition-[scale] duration-(--duration-slow) group-hover:scale-(--zoom-image) group-focus-within:scale-(--zoom-image) motion-reduce:transition-none bg-gray-100',
        ease,
      ]}
    />
    <span
      class="absolute inset-0 z-2 opacity-0 transition-opacity duration-300 group-hover:opacity-95 group-focus-within:opacity-95"
      style={`background-color:${color}`}></span>
    <!-- touch devices: titles are always shown, so darken the image behind them -->
    <span
      class:list={[
        'absolute inset-0 z-2 hidden touch:block',
        variant === 'carousel' ? 'bg-black/40' : 'bg-linear-to-t from-black/70 via-black/10 to-transparent',
      ]}></span>
  </span>

  {
    variant === 'carousel' ? (
      <div class="absolute inset-0 z-3 flex items-center justify-center p-5 text-center">
        <div>
          <Heading
            class:list={[
              'mb-3 translate-y-15 opacity-0 transition-all delay-0 duration-300 group-hover:opacity-100 group-hover:delay-200 group-focus-within:opacity-100 touch:translate-y-0 touch:opacity-100 break-words',
              reveal,
              titleClass,
              ease,
              textTone,
            ]}
          >
            <a href={href} class:list={['underline decoration-transparent underline-offset-5 decoration-3 transition-all duration-300', textTone, underline]}>
              {title}
            </a>
          </Heading>
          {accent && (
            <span
              class:list={['mx-auto mb-3 block h-0.5 w-12 rounded-full translate-y-15 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:delay-200 group-focus-within:opacity-100 touch:translate-y-0 touch:opacity-100', reveal]}
              style={`background:${accent}`}
              aria-hidden="true"></span>
          )}
          <span class:list={[textTone, 'block text-[15px] translate-y-15 opacity-0 transition-all duration-300 group-hover:opacity-100 group-hover:delay-200 group-focus-within:opacity-100 touch:translate-y-0 touch:opacity-100', reveal]}>
            {category}
          </span>
        </div>
      </div>
    ) : (
      <div class="absolute inset-x-0 bottom-0 z-3 p-8 md:p-12">
        <div class="overflow-hidden">
          <span
            class:list={[
              'mb-2 block translate-y-[calc(-100%-15px)] text-[15px] text-white/80 transition-transform duration-700 touch:translate-y-0',
              reveal,
              ease,
            ]}
          >
            {category}
          </span>
          <Heading
            class:list={[
              'mb-0 translate-y-full text-white transition-transform duration-700 touch:translate-y-0 break-words',
              reveal,
              titleClass,
              ease,
            ]}
          >
            <a href={href} class="text-white underline decoration-transparent underline-offset-4 decoration-2 hover:decoration-white focus-visible:decoration-white transition-all duration-300">
              {title}
            </a>
          </Heading>
        </div>
      </div>
    )
  }
</div>
)}
