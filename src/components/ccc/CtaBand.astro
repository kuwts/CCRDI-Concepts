---
// A call-to-action band: a heading, an optional line of text and up to two actions (a Button
// and a LineLink). A complete section. Variants:
//   navy  - centred on navy with the grain (Heritage Gold eyebrow, white button)
//   ivory - centred on ivory (dark gold eyebrow, dark button)
//   split - on white: heading and text on the left, actions on the right, a gold hairline above
// Keep one main Button per page: on a page whose hero already has one, use only `secondary`.
import Button from '@/components/Button.astro';
import LineLink from '@/components/LineLink.astro';

interface Action {
  label: string;
  href: string;
  target?: string;
}
interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primary?: Action;
  secondary?: Action;
  variant?: 'navy' | 'ivory' | 'split';
  /** set the title in the pull-quote style (for a framework statement) */
  quote?: boolean;
  /** heading level for the title (default h2) */
  as?: 'h2' | 'h3';
  class?: string;
}

const { eyebrow, title, text, primary, secondary, variant = 'navy', quote = false, as: Heading = 'h2', class: className = '' } = Astro.props;
const navy = variant === 'navy';
const split = variant === 'split';
---

<section
  class:list={[
    'py-section',
    navy && 'bg-dark bg-grain text-white',
    variant === 'ivory' && 'bg-light',
    split && 'hairline-top bg-white',
    className,
  ]}
>
  <div class="container">
    <div class:list={['row', split ? 'items-end' : 'justify-center text-center']}>
      <div class:list={[split ? 'lg:col-7' : 'lg:col-9 xl:col-8']}>
        {eyebrow && <p class:list={['mb-4 text-eyebrow uppercase has-anim fade', navy ? 'text-primary' : 'text-gold-text']}>{eyebrow}</p>}
        <Heading
          class:list={[
            'has-anim fade delay-100',
            quote ? 'pull-quote' : 'text-h2',
            // centred pull quotes drop the side rule
            quote && !split && 'border-l-0! pl-0! lg:pl-0!',
            quote && navy && '[--pull-quote-rule:var(--color-hairline-dark)]',
            navy ? 'text-white' : 'text-dark',
          ]}
        >
          {title}
        </Heading>
        {text && <p class:list={['mt-5 text-lead has-anim fade delay-150', split ? 'max-w-measure' : 'mx-auto max-w-measure', navy ? 'text-white/85' : 'text-text']}>{text}</p>}
      </div>
      {(primary || secondary) && (
        <div class:list={[split ? 'lg:col-5 max-lg:mt-8 flex lg:justify-end' : 'col-12 mt-10 flex justify-center']}>
          <div class="flex max-sm:flex-col items-center gap-x-8 gap-y-5 has-anim fade delay-200">
            {primary && <Button href={primary.href} label={primary.label} target={primary.target} variant={navy ? 'white' : 'black'} class="max-sm:w-full" />}
            {secondary && <LineLink href={secondary.href} label={secondary.label} target={secondary.target} tone={navy ? 'white' : 'dark'} icon="arrow" />}
          </div>
        </div>
      )}
    </div>
  </div>
</section>
