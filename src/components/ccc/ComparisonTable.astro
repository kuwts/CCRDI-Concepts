---
// A comparison table: rows of items compared across a few columns, as a real <table> with a
// caption, column headers and row headers, in a named, keyboard-focusable region that scrolls
// sideways on small screens (arrow keys scroll it) with the row headers kept in view.
// Signature: the gold rule under the header draws across as the table comes into view
// (`draw-x`), then the rows reveal top to bottom; on hover or keyboard focus within a row, a
// gold bar slides in at its left edge and the row warms to ivory. A highlighted column is a
// soft ivory band with a gold cap. A block, not a section; for white or ivory backgrounds.
// Reduced motion: drawn and in place.
interface Props {
  /** names the table (and its scroll region) */
  caption: string;
  /** show the caption above the table (default) or keep it for screen readers only */
  captionVisible?: boolean;
  columns: string[];
  /** one array of cell text per row; the first cell is the row header */
  rows: string[][];
  /** a column to emphasise (0-based), e.g. the one being recommended */
  highlight?: number;
  /** a unique id on the page */
  id: string;
  class?: string;
}

const { caption, captionVisible = true, columns, rows, highlight, id, class: className = '' } = Astro.props;
const captionId = `${id}-caption`;
const hl = (i: number) => highlight === i;
---

<div class:list={['cmp has-anim fade', className]}>
  <div
    role="region"
    aria-labelledby={captionId}
    tabindex="0"
    class="overflow-x-auto rounded-card bg-white"
  >
    <table class="w-full min-w-[40rem] border-collapse text-left">
      <caption
        id={captionId}
        class:list={[captionVisible ? 'px-6 pt-7 pb-3 text-left text-eyebrow uppercase text-gold-text sm:px-8' : 'sr-only']}
      >
        {caption}
      </caption>
      <thead>
        <tr class="relative">
          {columns.map((c, i) => (
            <th
              scope="col"
              class:list={[
                'relative px-6 pt-5 pb-5 align-bottom text-sm font-semibold text-dark sm:px-8',
                i === 0 && 'sticky left-0 z-1 bg-white',
                hl(i) && 'bg-light',
              ]}
            >
              {hl(i) && <span class="absolute inset-x-0 top-0 h-0.5 bg-hairline-light" aria-hidden="true"></span>}
              {c}
              {/* the header rule, drawn left to right across the columns */}
              <span
                class="draw-x absolute inset-x-0 bottom-0 h-0.5 bg-hairline-light"
                style={`--draw-delay: ${150 + i * 220}ms; transition-duration: 0.5s`}
                aria-hidden="true"
              ></span>
            </th>
          ))}
        </tr>
      </thead>
      <tbody>
        {rows.map((r, ri) => (
          <tr class="cmp-row group/row border-t border-dark/8 first:border-t-0" style={`--row-delay: ${700 + ri * 110}ms`}>
            {r.map((cell, i) =>
              i === 0 ? (
                <th
                  scope="row"
                  class:list={[
                    'relative sticky left-0 z-1 bg-white px-6 py-6 align-top font-heading text-lg font-semibold text-dark transition-colors duration-(--duration-base) group-hover/row:bg-light sm:px-8',
                    hl(0) && 'bg-light',
                  ]}
                >
                  <span class="cmp-bar absolute inset-y-3 left-0 w-0.5 bg-hairline-light" aria-hidden="true"></span>
                  <span class="cmp-cell block">{cell}</span>
                </th>
              ) : (
                <td class:list={['px-6 py-6 align-top text-text transition-colors duration-(--duration-base) group-hover/row:bg-light sm:px-8', hl(i) && 'bg-light']}>
                  <span class="cmp-cell block">{cell}</span>
                </td>
              ),
            )}
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</div>

<style>
  /* rows reveal top to bottom once the header rule has drawn */
  .cmp-cell {
    opacity: 0;
    translate: 0 var(--reveal-distance);
    transition:
      opacity var(--duration-slow) var(--ease-theme) var(--row-delay),
      translate var(--duration-slow) var(--ease-theme) var(--row-delay);
  }
  :global(.cmp.is-visible) .cmp-cell {
    opacity: 1;
    translate: none;
  }
  /* the row's gold bar */
  .cmp-bar {
    scale: 1 0;
    transition: scale var(--duration-base) var(--ease-theme);
  }
  .cmp-row:hover .cmp-bar,
  .cmp-row:focus-within .cmp-bar {
    scale: 1 1;
  }
  @media (prefers-reduced-motion: reduce) {
    .cmp-cell {
      opacity: 1;
      translate: none;
      transition: none;
    }
    .cmp-bar {
      transition: none;
    }
  }
  @media print {
    .cmp-cell {
      opacity: 1;
      translate: none;
    }
  }
</style>
