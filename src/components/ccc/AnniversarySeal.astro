---
import { fill, getLang, ui } from '@/i18n';

interface Props {
  /** `dark` for navy backgrounds (hero, footer), `light` for white or ivory ones. */
  variant?: 'dark' | 'light';
  /** Optional link, e.g. the 40 Years page. The seal's title names the link. */
  href?: string;
  class?: string;
}

const { variant = 'dark', href, class: className = 'size-32' } = Astro.props;

// unique ids, so several seals on one page keep their own arcs and title
const uid = `seal-${Math.random().toString(36).slice(2, 8)}`;
// founding year: Consumer Choice Award, "since 1987" (ccaward.com and its press releases);
// client to confirm (brief/gaps.md)
const year = '1987';
// "Years of Trust" / "ans de confiance" (site.config.json → ui); the brand arc stays in English
const lang = getLang(Astro.url);
const t = ui(lang);
const title = fill(t.sealTitle, { year });
// the French line is two characters longer and sits on the same chord of the inner ring
const yearsSize = lang === 'fr' ? 10.5 : 11.5;

// navy disc on light backgrounds; a lighter navy disc so it reads on navy ones
const disc = variant === 'dark' ? 'fill-navy-700' : 'fill-dark';
const Wrapper = href ? 'a' : 'span';
---

<Wrapper href={href} class:list={['inline-block shrink-0 rounded-full', className]}>
  <svg
    viewBox="0 0 200 200"
    role="img"
    aria-labelledby={`${uid}-title`}
    class="block size-full"
  >
    <title id={`${uid}-title`}>{title}</title>
    <defs>
      <path id={`${uid}-top`} d="M 30,100 A 70,70 0 0 1 170,100" />
      <path id={`${uid}-bottom`} d="M 21,100 A 79,79 0 0 0 179,100" />
    </defs>

    <circle cx="100" cy="100" r="97" class:list={[disc, 'stroke-primary']} stroke-width="3" />
    <circle cx="100" cy="100" r="88" fill="none" class="stroke-primary" stroke-width="1" />
    <circle cx="100" cy="100" r="58" fill="none" class="stroke-primary" stroke-width="1" />

    <g class="fill-primary font-heading" font-size="12.5" font-weight="600" letter-spacing="1.2">
      <text text-anchor="middle">
        <textPath href={`#${uid}-top`} startOffset="50%">Consumer Choice Canada</textPath>
      </text>
      <text text-anchor="middle">
        <textPath href={`#${uid}-bottom`} startOffset="50%">{year}</textPath>
      </text>
    </g>

    <!-- small diamonds between the two arcs -->
    <g class="fill-primary">
      <rect x="10" y="96.5" width="7" height="7" transform="rotate(45 13.5 100)" />
      <rect x="183" y="96.5" width="7" height="7" transform="rotate(45 186.5 100)" />
    </g>

    <text x="100" y="112" text-anchor="middle" class="fill-primary font-heading" font-size="54" font-weight="600">40</text>
    <text x="100" y="132" text-anchor="middle" class="fill-white font-heading" font-size={yearsSize} font-weight="500" letter-spacing="0.6">{t.sealYears}</text>
  </svg>
</Wrapper>
