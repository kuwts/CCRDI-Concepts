---
import AstroImage from '@/components/helper/AstroImage.astro';
import PauseButton from '@/components/PauseButton.astro';

interface ClientLogo {
  name: string;
  logo: string;
  /** a random repeat added only to even out column lengths */
  pad?: boolean;
}
interface Props {
  items: ClientLogo[];
  columnCount?: number;
  /** logo height in px (default 36); width follows each logo's proportions */
  logoHeight?: number;
  /** set each logo on a white tile (logos made for light backgrounds, on a navy section) */
  tiles?: boolean;
  class?: string;
}
const { items, columnCount = 5, logoHeight = 36, tiles = false, class: className = '' } = Astro.props;
const tilePad = 24; // px around each logo on its tile

function shuffleArray<T>(array: T[]): T[] {
  const shuffled = [...array];
  for (let i = shuffled.length - 1; i > 0; i--) {
    const j = Math.floor(Math.random() * (i + 1));
    [shuffled[i], shuffled[j]] = [shuffled[j], shuffled[i]];
  }
  return shuffled;
}

function distributeLogos(allLogos: ClientLogo[], columns: number): ClientLogo[][] {
  const shuffled = shuffleArray(allLogos);
  const cols: ClientLogo[][] = Array.from({ length: columns }, () => []);

  shuffled.forEach((logo, index) => {
    cols[index % columns].push(logo);
  });

  const maxLength = Math.max(...cols.map((col) => col.length));
  cols.forEach((col) => {
    while (col.length < maxLength) {
      col.push({ ...shuffled[Math.floor(Math.random() * shuffled.length)], pad: true });
    }
  });

  return cols;
}

// never more columns than logos, so one logo doesn't repeat across columns
const logoColumns = items.length ? distributeLogos(items, Math.min(columnCount, items.length)) : [];
---

{logoColumns.length > 0 && (
<div class:list={['relative container xl:max-w-275 has-anim fade', className]} data-logo-carousel>
  <PauseButton label="logo animation" />
  <div class="flex flex-wrap items-center justify-center gap-4 md:gap-6">
    {
      logoColumns.map((col, colIndex) => (
        <div
          class:list={['logo-col relative w-[calc(38%-0.5rem)] sm:w-[calc(25%-0.5rem)] overflow-hidden lg:w-auto lg:flex-1', tiles && 'rounded-card bg-white max-sm:w-[calc(50%-0.5rem)]']}
          style={{ height: `${logoHeight + (tiles ? tilePad * 2 : 0)}px` }}
          data-column={colIndex}
        >
          <div class="logo-stack relative h-full w-full">
            {col.map((logo, logoIndex) => (
              <div
                class:list={[
                  'logo-slot absolute flex items-center justify-center pointer-events-none',
                  tiles ? 'inset-6' : 'inset-0',
                  logoIndex === 0 && 'active',
                ]}
                data-logo-index={logoIndex}
                data-pad={logo.pad ? '' : undefined}
                aria-hidden={logo.pad ? 'true' : undefined}
              >
                <AstroImage
                  src={logo.logo}
                  alt={logo.name}
                  loading="lazy"
                  class:list={['w-auto object-contain', tiles ? 'max-w-full' : 'max-w-[80%]']}
                  style={{ height: `${logoHeight}px` }}
                  height={logoHeight}
                />
              </div>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</div>
)}

<style>
  .logo-slot {
    opacity: 0;
    transform: translateY(10%);
    filter: blur(8px);
    transition:
      opacity 0.5s var(--ease-theme),
      transform 0.5s var(--ease-theme),
      filter 0.5s var(--ease-theme);
  }

  .logo-slot.active {
    opacity: 1;
    transform: translateY(0%);
    filter: blur(0px);
    pointer-events: auto;
  }

  .logo-slot.exit {
    opacity: 0;
    transform: translateY(-20%);
    filter: blur(6px);
    transition:
      opacity 0.3s ease-in,
      transform 0.3s ease-in,
      filter 0.3s ease-in;
  }

  /* reduced motion: no cycling; each column lists its logos so every client shows once */
  @media (prefers-reduced-motion: reduce) {
    .logo-col,
    .logo-stack {
      height: auto;
    }
    .logo-stack {
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }
    .logo-slot {
      position: static;
      opacity: 1;
      transform: none;
      filter: none;
      transition: none;
      pointer-events: auto;
    }
    .logo-slot[data-pad] {
      display: none;
    }
    [data-logo-carousel] [data-pause-toggle] {
      display: none;
    }
  }
</style>

<script>
  const cycleInterval = 2000;
  const columnDelay = 250;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // one independent timer per logo wall, so several can share a page. It only
  // runs while the wall is on screen, the tab is visible, nothing pauses it
  // (hover, keyboard focus inside it, or the pause button).
  document.querySelectorAll<HTMLElement>('[data-logo-carousel]').forEach((root) => {
    if (reduceMotion) return;

    let currentTime = 0;
    let timer = 0;
    let onScreen = false;
    let hovered = false;
    let paused = false;
    const toggle = root.querySelector<HTMLButtonElement>('[data-pause-toggle]');
    const previousIndex: Record<number, number> = {};
    const columns = root.querySelectorAll<HTMLElement>('[data-column]');

    function updateCarousel() {
      columns.forEach((col, colIndex) => {
        const slots = col.querySelectorAll('.logo-slot');
        const logosCount = slots.length;
        if (logosCount === 0) return;

        const adjustedTime = (currentTime + colIndex * columnDelay) % (cycleInterval * logosCount);
        const targetIndex = Math.floor(adjustedTime / cycleInterval);
        const prevIdx = previousIndex[colIndex];

        if (prevIdx !== undefined && prevIdx !== targetIndex) {
          const prevSlot = slots[prevIdx];
          if (prevSlot) {
            prevSlot.classList.remove('active');
            prevSlot.classList.add('exit');
            setTimeout(() => {
              prevSlot.classList.remove('exit');
            }, 300);
          }
        }

        if (prevIdx !== targetIndex) {
          slots[targetIndex].classList.add('active');
        }

        previousIndex[colIndex] = targetIndex;
      });

      currentTime += 100;
    }

    const sync = () => {
      const run = onScreen && !hovered && !paused && !document.hidden;
      if (run && !timer) timer = window.setInterval(updateCarousel, 100);
      if (!run && timer) {
        clearInterval(timer);
        timer = 0;
      }
    };

    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
    root.addEventListener('mouseenter', () => { hovered = true; sync(); });
    root.addEventListener('mouseleave', () => { hovered = false; sync(); });
    toggle?.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = `${paused ? 'Play' : 'Pause'} logo animation`;
      sync();
    });
  });
</script>
