---
// A stepped backdrop blur along one edge: several stacked layers, each blurring a
// little more and masked to its own band. Pure CSS; the layers are worked out at
// build time, so no JavaScript ships for it.

type Position = 'top' | 'bottom' | 'left' | 'right';
type Curve = 'linear' | 'bezier' | 'ease-in' | 'ease-out' | 'ease-in-out';

interface Props {
  position?: Position;
  /** Blur strength multiplier. */
  strength?: number;
  /** Band size for top/bottom (any CSS length). */
  height?: string;
  /** Band size for left/right; defaults to `height`. */
  width?: string;
  /** Number of blur layers. */
  divCount?: number;
  /** Blur grows exponentially from layer to layer instead of linearly. */
  exponential?: boolean;
  curve?: Curve;
  opacity?: number;
  zIndex?: number;
  /** `page`: fixed to the viewport edge; `parent`: absolute inside a `relative` parent. */
  target?: 'parent' | 'page';
  preset?: keyof typeof PRESETS;
  class?: string;
}

const PRESETS = {
  top: { position: 'top', height: '6rem' },
  bottom: { position: 'bottom', height: '6rem' },
  left: { position: 'left', height: '6rem' },
  right: { position: 'right', height: '6rem' },
  subtle: { height: '4rem', strength: 1, opacity: 0.8, divCount: 3 },
  intense: { height: '10rem', strength: 4, divCount: 8, exponential: true },
  smooth: { height: '8rem', curve: 'bezier', divCount: 10 },
  sharp: { height: '5rem', curve: 'linear', divCount: 4 },
  header: { position: 'top', height: '8rem', curve: 'ease-out' },
  footer: { position: 'bottom', height: '8rem', curve: 'ease-out' },
  sidebar: { position: 'left', height: '6rem', strength: 2.5 },
  'page-header': { position: 'top', height: '10rem', target: 'page', strength: 3 },
  'page-footer': { position: 'bottom', height: '10rem', target: 'page', strength: 3 },
} satisfies Record<string, Partial<Props>>;

const CURVES: Record<Curve, (p: number) => number> = {
  linear: (p) => p,
  bezier: (p) => p * p * (3 - 2 * p),
  'ease-in': (p) => p * p,
  'ease-out': (p) => 1 - Math.pow(1 - p, 2),
  'ease-in-out': (p) => (p < 0.5 ? 2 * p * p : 1 - Math.pow(-2 * p + 2, 2) / 2),
};

const { preset, class: className = '', ...props } = Astro.props;
const {
  position = 'bottom',
  strength = 2,
  height = '6rem',
  width,
  divCount = 5,
  exponential = false,
  curve = 'linear',
  opacity = 1,
  zIndex = 1000,
  target = 'parent',
}: Props = { ...(preset ? PRESETS[preset] : {}), ...props };

const direction = `to ${position}`;
const increment = 100 / divCount;
const round = (n: number) => Math.round(n * 10) / 10;

const layers = Array.from({ length: divCount }, (_, idx) => {
  const i = idx + 1;
  const progress = CURVES[curve](i / divCount);
  const blur = exponential
    ? Math.pow(2, progress * 4) * 0.0625 * strength
    : 0.0625 * (progress * divCount + 1) * strength;

  const p1 = round(increment * i - increment);
  const p2 = round(increment * i);
  const p3 = round(increment * i + increment);
  const p4 = round(increment * i + increment * 2);
  let gradient = `transparent ${p1}%, black ${p2}%`;
  if (p3 <= 100) gradient += `, black ${p3}%`;
  if (p4 <= 100) gradient += `, transparent ${p4}%`;

  const mask = `linear-gradient(${direction}, ${gradient})`;
  return `mask-image:${mask};-webkit-mask-image:${mask};backdrop-filter:blur(${blur.toFixed(3)}rem);-webkit-backdrop-filter:blur(${blur.toFixed(3)}rem);opacity:${opacity}`;
});

const vertical = position === 'top' || position === 'bottom';
const box = [
  `position:${target === 'page' ? 'fixed' : 'absolute'}`,
  'pointer-events:none',
  `z-index:${target === 'page' ? zIndex + 100 : zIndex}`,
  `${position}:0`,
  vertical
    ? `height:${height};width:${width ?? '100%'};left:0;right:0`
    : `width:${width ?? height};height:100%;top:0;bottom:0`,
].join(';');
---

<div class:list={['gradual-blur isolate', className]} style={box} aria-hidden="true">
  <div class="relative h-full w-full">
    {layers.map((style) => <div class="absolute inset-0" style={style} />)}
  </div>
</div>
