---
import AstroImage from '@/components/helper/AstroImage.astro';
import PauseButton from '@/components/PauseButton.astro';

type GroupImage = string | { src: string; alt?: string };
interface Props {
  /** Image paths, or `{ src, alt }` to describe a photo (plain paths are decorative). */
  images: GroupImage[];
}
const { images } = Astro.props;

const photos = images.map((img) => (typeof img === 'string' ? { src: img, alt: '' } : { src: img.src, alt: img.alt ?? '' }));
const items = [...photos, ...photos];
const duration = 20;
---

{photos.length > 0 && (
<div class="team-group-carousel marquee relative overflow-hidden" data-marquee>
  <PauseButton label="photo strip" />
  <div class="marquee-track flex" data-marquee-track data-duration={duration}>
    {
      items.map((photo, i) => (
        <div
          class="shrink-0"
          data-duplicate={i >= photos.length ? '' : undefined}
          aria-hidden={i >= photos.length ? 'true' : undefined}
        >
          <div class="team-group-image has-anim inline-block overflow-hidden text-center mx-4">
            <AstroImage
              src={photo.src}
              alt={photo.alt}
              loading="lazy"
              class="max-w-100 bg-gray-100"
            />
          </div>
        </div>
      ))
    }
  </div>
</div>
)}

<style>
  /* reduced motion: no marquee; one set of photos the visitor can scroll by hand */
  @media (prefers-reduced-motion: reduce) {
    .team-group-carousel {
      overflow-x: auto;
    }
    .team-group-carousel [data-duplicate],
    .team-group-carousel [data-pause-toggle] {
      display: none;
    }
  }
</style>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // The strip only moves while it's on screen, the tab is visible, and it isn't
  // paused (hover, keyboard focus inside it, or the pause button).
  document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((root) => {
    const track = root.querySelector<HTMLElement>('[data-marquee-track]');
    if (!track || reduceMotion) return;

    const duration = Number(track.dataset.duration) || 5;
    const toggle = root.querySelector<HTMLButtonElement>('[data-pause-toggle]');
    let oneSet = 0;
    let pos = 0;
    let prev = 0;
    let frame = 0;
    let onScreen = false;
    let hovered = false;
    let paused = false;

    const setOffset = () => {
      oneSet = track.scrollWidth / 2;
    };

    const loop = (now: number) => {
      const dt = prev ? (now - prev) / 1000 : 0;
      prev = now;
      if (oneSet > 0) {
        const pxPerSec = oneSet / duration;
        pos -= pxPerSec * dt;
        if (pos <= -oneSet) pos += oneSet;
        track.style.transform = `translateX(${pos}px)`;
      }
      frame = requestAnimationFrame(loop);
    };

    const sync = () => {
      const run = onScreen && !hovered && !paused && !document.hidden;
      if (run && !frame) {
        prev = 0;
        frame = requestAnimationFrame(loop);
      } else if (!run && frame) {
        cancelAnimationFrame(frame);
        frame = 0;
      }
    };

    new ResizeObserver(setOffset).observe(track);
    setOffset();
    new IntersectionObserver(([e]) => {
      onScreen = e.isIntersecting;
      sync();
    }).observe(root);
    document.addEventListener('visibilitychange', sync);
    root.addEventListener('mouseenter', () => { hovered = true; sync(); });
    root.addEventListener('mouseleave', () => { hovered = false; sync(); });
    toggle?.addEventListener('click', () => {
      paused = !paused;
      toggle.setAttribute('aria-pressed', String(paused));
      toggle.textContent = `${paused ? 'Play' : 'Pause'} photo strip`;
      sync();
    });
  });
</script>
