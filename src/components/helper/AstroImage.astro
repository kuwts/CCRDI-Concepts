---
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";

interface Props {
  src: string | undefined;
  alt: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy" | null | undefined;
  decoding?: "async" | "auto" | "sync" | null | undefined;
  format?: "auto" | "avif" | "jpeg" | "png" | "svg" | "webp";
  class?: string;
  style?: Record<string, string>;
  /** srcset widths; defaults to 400 / 800 / 1200 / 1600 (up to the rendered width) for raster images */
  widths?: number[];
  sizes?: string;
}

const {
  src,
  alt,
  width,
  height,
  loading,
  decoding,
  class: className,
  format,
  style,
  widths,
  sizes,
} = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif,svg}'
);

const resolveImage = (path: string | undefined): string | null => {
  if (!path) return null;

  const normalized = path.startsWith('/') ? path : `/${path}`;

  const candidates = [
    `/src/assets${normalized}`,
    `/src/assets/images${normalized}`,
    `/src${normalized}`,
  ];

  for (const candidate of candidates) {
    if (images[candidate]) return candidate;
  }

  return null;
};

const resolvedSrc = resolveImage(src);
let imgMeta: ImageMetadata | null = null;
if (resolvedSrc && images[resolvedSrc]) {
  const mod = await images[resolvedSrc]();
  imgMeta = mod.default;
}

// only one side given: work out the other from the image's own proportions, so it isn't
// cropped or stretched
const ratio = imgMeta ? imgMeta.width / imgMeta.height : undefined;
const imgWidth = width ?? (height && ratio ? Math.round(height * ratio) : (imgMeta?.width ?? 800));
const imgHeight = height ?? (width && ratio ? Math.round(width / ratio) : (imgMeta?.height ?? 600));

// Responsive by default: raster images wider than 400px get a srcset (never wider
// than the width they render at) so phones don't download full-size files.
const DEFAULT_WIDTHS = [400, 800, 1200, 1600];
const isRaster = !!imgMeta && imgMeta.format !== 'svg';
const autoWidths =
  !widths && isRaster && imgWidth > DEFAULT_WIDTHS[0]
    ? [...DEFAULT_WIDTHS.filter((w) => w < imgWidth), imgWidth]
    : undefined;
const srcWidths = widths ?? autoWidths;
const srcSizes = sizes ?? (srcWidths ? `(min-width: ${imgWidth}px) ${imgWidth}px, 100vw` : undefined);
---

{/* nothing to show: render nothing rather than a broken image */}
{src && (resolvedSrc && images[resolvedSrc] ? (
  <Image
    src={images[resolvedSrc]()}
    alt={alt}
    width={imgWidth}
    height={imgHeight}
    loading={loading}
    decoding={decoding}
    class={className}
    format={format}
    style={style}
    widths={srcWidths}
    sizes={srcSizes}
  />
) : (
  <img
    src={src}
    alt={alt}
    width={imgWidth}
    height={imgHeight}
    loading={loading}
    decoding={decoding}
    class={className}
    style={style}
  />
))}
