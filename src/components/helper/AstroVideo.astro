---
import type { ImageMetadata } from "astro";
import { getImage } from "astro:assets";

interface Props {
  src: string | undefined;
  /** Extra versions of the same video in other formats (e.g. an .mp4 next to a .webm), tried in order after `src`. */
  sources?: string[];
  poster?: string;
  /** Largest width the poster image is resized to. */
  posterWidth?: number;
  class?: string;
  autoplay?: boolean;
  loop?: boolean;
  muted?: boolean;
  controls?: boolean;
  playsinline?: boolean;
  preload?: "auto" | "metadata" | "none";
  width?: number;
  height?: number;
  [key: string]: unknown;
}

const {
  src,
  sources = [],
  poster,
  posterWidth = 1600,
  class: className,
  autoplay = false,
  loop = false,
  muted = false,
  controls = false,
  playsinline = false,
  preload = "metadata",
  width,
  height,
  ...rest
} = Astro.props;

const videoModules = import.meta.glob<{ default: string }>(
  '/src/assets/**/*.{mp4,webm,ogv,ogg,mov}'
);
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  '/src/assets/**/*.{jpeg,jpg,png,gif,webp,avif,svg}'
);

const candidatesFor = (path: string) => {
  const normalized = path.startsWith('/') ? path : `/${path}`;
  return [`/src/assets${normalized}`, `/src/assets/images${normalized}`, `/src${normalized}`];
};

const resolveVideo = async (path: string): Promise<string> => {
  for (const candidate of candidatesFor(path)) {
    if (videoModules[candidate]) return (await videoModules[candidate]()).default;
  }
  return path;
};

// posters in src/assets are optimized (resized, WebP); other paths are used as-is
const resolvePoster = async (path: string | undefined): Promise<string> => {
  if (!path) return '';
  for (const candidate of candidatesFor(path)) {
    if (!imageModules[candidate]) continue;
    const meta = (await imageModules[candidate]()).default;
    if (meta.format === 'svg') return meta.src;
    const img = await getImage({ src: meta, width: Math.min(meta.width, posterWidth), format: 'webp' });
    return img.src;
  }
  return path;
};

const MIME: Record<string, string> = {
  mp4: 'video/mp4',
  webm: 'video/webm',
  ogv: 'video/ogg',
  ogg: 'video/ogg',
  mov: 'video/quicktime',
};
const typeOf = (path: string) => {
  const ext = path.split('.').pop()?.toLowerCase() ?? '';
  return MIME[ext] ?? `video/${ext}`;
};

const allSources = await Promise.all(
  [src, ...sources].filter((s): s is string => !!s).map(async (s) => ({ src: await resolveVideo(s), type: typeOf(s) })),
);
const posterUrl = await resolvePoster(poster);
---

{allSources.length > 0 && (
  <video
    class={className}
    poster={posterUrl || undefined}
    autoplay={autoplay}
    loop={loop}
    muted={muted}
    controls={controls}
    playsinline={playsinline}
    preload={preload}
    width={width}
    height={height}
    {...rest}
  >
    {allSources.map((s) => <source src={s.src} type={s.type} />)}
  </video>
)}
