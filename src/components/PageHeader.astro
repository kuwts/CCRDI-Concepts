---
interface Props {
  subtitle: string;
  title: string;
  align?: 'left' | 'center';
  dot?: boolean;
  /** a 1px gold hairline along the bottom edge (when a light section follows) */
  hairline?: boolean;
  colClass?: string;
}

const {
  subtitle,
  title,
  align = 'left',
  dot = false,
  hairline = false,
  colClass = 'lg:col-10',
} = Astro.props;
---

<section class:list={['page-header pt-24 sm:pt-28 pb-28 sm:pb-32 text-muted', hairline && 'hairline-bottom']}>
  <div class="container -mt-1.5">
    <div class="row justify-center">
      <div class:list={[colClass, align === 'center' ? 'text-center' : '']}>
        {subtitle && <p class="has-anim fade mb-5 font-medium">{subtitle}</p>}
        <h1
          class:list={[
            'has-anim fade delay-100 text-white text-h1 break-words',
            dot ? 'section-title-dot' : '',
          ]}
          set:html={title}
        />
      </div>
    </div>
  </div>
</section>
