---
import { Icon } from 'astro-icon/components';
import AstroImage from '@/components/helper/AstroImage.astro';
import DropdownNav from '@/components/menu/DropdownNav.astro';

import site from '@/config/site.config.json';
import { alternates, getLang, languages, menuFor, siteText, ui } from '@/i18n';

// typed so menus without dropdowns (no `children` anywhere) still check
interface MenuItem {
  name: string;
  url: string;
  children?: { name: string; url: string }[];
}
// menus, header button and labels in the page's language (menu.json, site.config.json)
const lang = getLang(Astro.url);
const menu: { main: MenuItem[] } = menuFor(lang);
const t = ui(lang);
const home = languages[lang].home;

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (url: string) =>
  url !== '#' && pathname === url.replace(/\/$/, '');
const inSection = (item: MenuItem) =>
  isActive(item.url) || !!item.children?.some((c) => isActive(c.url));

// header button: the site's main action (site.config.json → headerButton)
const { headerButton } = siteText(lang);
const external = /^https?:\/\//.test(headerButton.url);
const extAttrs = external ? { target: '_blank', rel: 'noopener' } : {};

// language switcher: the same page in the other language (src/i18n/routes.json), or its home.
// Compact "FR"/"EN" in the header bar, the full name in the mobile menu; the link text is in
// the other language, so it carries that `lang`.
const other = lang === 'fr' ? 'en' : 'fr';
const otherLang = languages[other];
const switchHref = alternates(Astro.url)?.[other] ?? otherLang.home;
---
<header
  id="site-header"
  class="group/header bg-dark bg-grain sticky top-0 left-0 z-9992 w-full transition-transform duration-500 will-change-transform"
  style="transition-timing-function:var(--ease-theme)"
>
  <div class="container">
    <div class="row">
      <div class="col-12">
        <nav class="flex items-center justify-between py-4 lg:py-5 group-[.sticky-pinned]/header:py-2 transition-all duration-300">
          <!-- logo -->
          <a href={home} title={site.brand.logo.alt} class="inline-block shrink-0">
            <AstroImage
              src={site.brand.logo.src}
              alt={site.brand.logo.alt}
              width={site.brand.logo.width}
              height={site.brand.logo.height}
              loading="eager"
              class="w-38 lg:w-36 xl:w-50 h-auto"
            />
          </a>

          <!-- desktop nav -->
          <DropdownNav items={menu.main} currentPath={pathname} />

          <!-- desktop language switcher + header button -->
          <div class="hidden shrink-0 items-center gap-3 xl:gap-5 lg:flex">
            <a
              href={switchHref}
              lang={otherLang.lang}
              hreflang={otherLang.lang}
              class="py-1 text-[15px] font-medium text-white/85 underline decoration-transparent decoration-1 underline-offset-4 transition hover:text-white hover:decoration-primary/70"
            >
              {otherLang.short}<span class="sr-only"> – {otherLang.name}</span>
            </a>
            <a
              href={headerButton.url}
              class="btn btn-sm btn-white"
              {...extAttrs}
            >
              <span>{headerButton.label}</span>
            </a>
          </div>

          <!-- mobile toggler -->
          <button
            type="button"
            data-menu-open
            aria-label={t.openMenu}
            aria-expanded="false"
            aria-controls="mobile-drawer"
            class="text-white transition-opacity hover:opacity-70 lg:hidden cursor-pointer p-1"
          >
            <Icon name="lucide:menu" class="text-[30px]" aria-hidden="true" />
          </button>
        </nav>
      </div>
    </div>
  </div>
</header>

<!-- mobile drawer overlay -->
<div
  data-menu-overlay
  class="invisible fixed inset-0 z-9998 bg-dark/70 opacity-0 backdrop-blur-[2px] transition-all duration-300 lg:hidden"
>
</div>

<!-- mobile drawer -->
<aside
  id="mobile-drawer"
  aria-label={t.menu}
  inert
  class="bg-dark invisible fixed top-0 right-0 z-9999 flex h-screen w-75 max-w-[85vw] translate-x-full flex-col p-7.5 shadow-2xl shadow-black/50 transition-transform duration-500 lg:hidden"
  style="transition-timing-function:var(--ease-theme)"
>
  <div class="mb-4 flex items-center justify-between">
    <a href={home} title={site.brand.logo.alt}>
      <AstroImage src={site.brand.logo.src} alt={site.brand.logo.alt} class="w-38 h-auto" width={site.brand.logo.width} height={site.brand.logo.height} loading="eager" />
    </a>
    <button
      type="button"
      data-menu-close
      aria-label={t.closeMenu}
      class="flex items-center gap-1 text-[14px] tracking-wider text-white/80 uppercase transition-opacity hover:opacity-60 cursor-pointer p-1"
    >
      <Icon name="lucide:x" class="text-[18px]" aria-hidden="true" /> {t.close}
    </button>
  </div>

  <ul class="-mr-2 flex-1 overflow-y-auto pr-2 scrollbar-hidden">
    {
      menu.main.map((item) =>
        item.children ? (
          <li class="border-b border-white/5">
            <button
              type="button"
              data-dropdown-toggle
              aria-expanded="false"
              class:list={[
                'flex w-full items-center justify-between py-3.5 text-[16px] font-medium transition-colors cursor-pointer',
                inSection(item) ? 'text-white' : 'text-white/95 hover:text-white',
              ]}
            >
              {item.name}
              <Icon
                name="lucide:chevron-down"
                class="transition-transform duration-300"
                data-caret
                aria-hidden="true"
              />
            </button>
            <ul
              data-submenu
              inert
              class="max-h-0 overflow-hidden border-l border-white/5 pl-4 transition-[max-height] duration-300 ease-out"
            >
              {item.children.map((child) => (
                <li class="last:mb-2">
                  <a
                    href={child.url}
                    aria-current={isActive(child.url) ? 'page' : undefined}
                    class:list={[
                      'block py-2 text-[14px] font-medium transition-colors',
                      isActive(child.url)
                        ? 'text-white'
                        : 'text-white/70 hover:text-white',
                    ]}
                  >
                    {child.name}
                  </a>
                </li>
              ))}
            </ul>
          </li>
        ) : (
          <li class="border-b border-white/5">
            <a
              href={item.url}
              aria-current={isActive(item.url) ? 'page' : undefined}
              class:list={[
                'block py-3.5 text-[16px] font-medium transition-colors',
                isActive(item.url) ? 'text-white' : 'text-white/95 hover:text-white',
              ]}
            >
              {item.name}
            </a>
          </li>
        ),
      )
    }
  </ul>

  <a
    href={switchHref}
    lang={otherLang.lang}
    hreflang={otherLang.lang}
    class="mt-5 inline-block self-start py-2 text-[15px] font-medium text-white/85 underline decoration-white/30 decoration-1 underline-offset-4 transition hover:text-white hover:decoration-primary/70"
  >
    {otherLang.name}
  </a>

  <a
    href={headerButton.url}
    class="btn btn-white mt-5 flex w-full"
    {...extAttrs}
  >
    <span>{headerButton.label}</span>
  </a>
</aside>
