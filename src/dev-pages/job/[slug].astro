---
// Theme demo page, not in brief/sitemap.md: noindex and out of the XML sitemap until the
// cleanup phase (brief/cleanup-list.md)
import { getEntry, render } from 'astro:content';

import Base from '@/layouts/Base.astro';
import LineLink from '@/components/LineLink.astro';
import Button from '@/components/Button.astro';
import { getJobs } from '@/lib/content';

export async function getStaticPaths() {
  const jobs = await getJobs();
  return jobs.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { title, meta, apply_label, apply_title } = entry.data;
const { Content } = await render(entry);

// The form's labels and messages are shared by every job page:
// src/content/team/index.mdx → application_form.
const team = await getEntry('team', 'index');
const { fields, submit_label, sending_label, error_message, file_too_large } = team!.data.application_form;

// Submissions go to Netlify Forms (form name "job-application", shared by every job
// page; the hidden "position" field records which job). Where they're emailed is set
// per site in the Netlify dashboard: Forms > Submission notifications.
const fieldClass = 'field';
const textareaClass = 'field field-textarea';
const required = '<span class="text-error" aria-hidden="true">*</span>';
---

<Base title={title} description={meta} seo={entry.data.seo} noindex>
  <!-- Header -->
  <section class="bg-light py-20 md:py-25">
    <div class="container">
      <div class="row justify-center items-end">
        <div class="lg:col-7">
          <p class="has-anim fade mb-5 font-medium text-dark/60">{meta}</p>
          <h1 class="text-dark has-anim fade delay-100 font-medium text-3xl break-words">{title}</h1>
        </div>
        <div class="lg:col-3 lg:text-right mt-4 lg:mt-0 has-anim fade delay-200">
          <LineLink href="#apply-job-wrap" label={apply_label} tone="dark" icon="down" />
        </div>
      </div>
    </div>
  </section>

  <!-- Body (its ## headings keep the 22px size job posts have always had) -->
  <section class="bg-white py-20 md:py-25">
    <div class="container has-anim fade delay-150">
      <div class="row justify-center">
        <div class="lg:col-10">
          <div class="content text-dark [&_h2]:text-[22px]!">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Apply -->
  <div id="apply-job-wrap" class="bg-light py-20 md:py-25">
    <div class="container">
      <div class="row justify-center">
        <div class="lg:col-10">
          <h2 class="text-dark has-anim fade font-semibold">{apply_title}</h2>

          <form
            name="job-application"
            method="POST"
            action="/thank-you/application"
            enctype="multipart/form-data"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="mt-5"
            id="job-apply-form"
            data-sending={sending_label}
            data-error={error_message}
            data-too-large={file_too_large}
          >
            <input type="hidden" name="form-name" value="job-application" />
            <input type="hidden" name="subject" value={`Job application: ${title}`} />
            <input type="hidden" name="position" value={title} />
            <!-- spam honeypot: hidden from people; Netlify rejects submissions that fill it -->
            <p class="hidden">
              <label>Don’t fill this out if you’re human: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
            </p>
            <div class="row">
              <div class="col-12 has-anim fade">
                <label for="apply-cv" class="field-label">{fields.cv.label} <Fragment set:html={required} /></label>
                <input id="apply-cv" type="file" name="cv" accept=".pdf,.doc,.docx" class={`${fieldClass} pt-2.5`} required />
              </div>
              <div class="col-12 has-anim fade">
                <label for="apply-name" class="field-label">{fields.name.label} <Fragment set:html={required} /></label>
                <input id="apply-name" type="text" name="name" autocomplete="name" class={fieldClass} placeholder={fields.name.placeholder} required />
              </div>
              <div class="col-12 has-anim fade">
                <label for="apply-email" class="field-label">{fields.email.label} <Fragment set:html={required} /></label>
                <input id="apply-email" type="email" name="email" autocomplete="email" class={fieldClass} placeholder={fields.email.placeholder} required />
              </div>
              <div class="col-12 md:col-6 has-anim fade">
                <label for="apply-phone" class="field-label">{fields.phone.label} <Fragment set:html={required} /></label>
                <input id="apply-phone" type="tel" name="phone" autocomplete="tel" class={fieldClass} placeholder={fields.phone.placeholder} required />
              </div>
              <div class="col-12 md:col-6 has-anim fade">
                <label for="apply-company" class="field-label">{fields.company.label}</label>
                <input id="apply-company" type="text" name="company" autocomplete="organization" class={fieldClass} placeholder={fields.company.placeholder} />
              </div>
              <div class="col-12 has-anim fade">
                <label for="apply-cover" class="field-label">{fields.cover_letter.label} <Fragment set:html={required} /></label>
                <textarea
                  id="apply-cover"
                  name="cover_letter"
                  class={textareaClass}
                  rows="1"
                  placeholder={fields.cover_letter.placeholder}
                  required></textarea>
              </div>
              <div class="col-12 has-anim fade">
                <Button type="submit" label={submit_label} variant="black" />
                <div class="status empty:hidden py-2 px-3 bg-error text-white font-medium text-sm mt-4" role="status" aria-live="polite"></div>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</Base>

<script>
  // Netlify Forms AJAX submission with a file: send FormData to "/" and let the
  // browser set the multipart Content-Type. Netlify caps a submission at 8 MB
  // (one file per field) and times out uploads after 30 seconds.
  const MAX_BYTES = 8 * 1024 * 1024;

  const form = document.getElementById('job-apply-form') as HTMLFormElement | null;
  if (form) {
    const submitBtn = form.querySelector<HTMLButtonElement>("button[type='submit']");
    const submitBtnHTML = submitBtn?.innerHTML;
    const status = form.querySelector<HTMLElement>('.status');

    const showError = (text: string) => {
      if (status) status.textContent = text;
    };
    const resetButton = () => {
      if (!submitBtn) return;
      if (submitBtnHTML) submitBtn.innerHTML = submitBtnHTML;
      submitBtn.disabled = false;
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      if (status) status.textContent = '';

      const data = new FormData(form);
      const cv = data.get('cv');
      // leave a little room for the text fields within the 8 MB request limit
      if (cv instanceof File && cv.size > MAX_BYTES - 256 * 1024) {
        showError(form.dataset.tooLarge ?? '');
        return;
      }

      if (submitBtn) {
        submitBtn.disabled = true;
        const span = submitBtn.querySelector('span');
        if (span) span.textContent = form.dataset.sending ?? '';
      }

      fetch('/', { method: 'POST', body: data })
        .then((response) => {
          // only a 2xx from Netlify counts as sent; then go to the thank-you page
          // (the form's `action`, which is also where no-JS visitors land)
          if (!response.ok) throw new Error(`Form submission failed (${response.status})`);
          window.location.href = form.getAttribute('action') ?? '/thank-you/application';
        })
        .catch(() => {
          showError(form.dataset.error ?? '');
        })
        .finally(resetButton);
    });
  }
</script>
