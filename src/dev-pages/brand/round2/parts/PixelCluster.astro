---
// The logo's pixel squares (dev only, brand specimen): the 30 squares beside "RDI", at their
// measured positions, sizes and colours (src/assets/images/brands/ccrdi-logo.png). Decorative.
// Signature: as it comes into view the cluster assembles, each square rising into place and
// scaling up from a point, staggered from the letters outward (the way the logo reads), on the
// theme's curve. `mono` keeps three squares in red and the rest in the page's cool neutrals, so
// red stays a signal. Reduced motion: in place, no movement.
interface Props {
  /** `logo`: the logo's own colours; `mono`: neutrals with three red squares */
  tone?: 'logo' | 'mono';
  class?: string;
}
const { tone = 'logo', class: className = '' } = Astro.props;

// [x, y, size, colour] in the logo's own coordinates (offset to this viewBox)
const squares: [number, number, number, string][] = [
  [330, 6, 35, 'signal'], [250, 41, 35, 'signal'], [116, 100, 25, 'blush'], [286, 103, 30, 'blush'],
  [214, 109, 21, 'blush'], [246, 116, 21, 'blush'], [115, 153, 30, 'wine'], [16, 156, 24, 'blush'],
  [165, 157, 21, 'blush'], [203, 157, 21, 'blush'], [250, 158, 21, 'blush'], [66, 188, 23, 'signal'],
  [208, 193, 29, 'blush'], [165, 215, 20, 'soft'], [250, 220, 33, 'soft'], [349, 221, 35, 'signal'],
  [13, 222, 30, 'soft'], [287, 223, 25, 'blush'], [117, 227, 23, 'signal'], [86, 244, 23, 'red'],
  [168, 258, 21, 'blush'], [244, 259, 25, 'blush'], [210, 263, 21, 'soft'], [210, 291, 30, 'soft'],
  [108, 304, 23, 'wine'], [149, 305, 23, 'signal'], [242, 305, 25, 'signal'], [124, 343, 30, 'wine'],
  [168, 356, 24, 'signal'],
];
const logoFill: Record<string, string> = {
  signal: 'var(--spec-signal, var(--spec-red))',
  red: 'var(--spec-red)',
  wine: 'var(--spec-wine, var(--spec-ink))',
  blush: 'var(--spec-blush, var(--spec-silver))',
  soft: 'color-mix(in srgb, var(--spec-red) 72%, transparent)',
};
// mono: the three largest bright squares stay red
const signalIndex = new Set([0, 1, 15]);
const fill = (c: string, i: number) =>
  tone === 'logo'
    ? logoFill[c]
    : signalIndex.has(i)
      ? 'var(--spec-red)'
      : c === 'blush'
        ? 'var(--spec-rule)'
        : 'color-mix(in srgb, var(--spec-steel) 70%, transparent)';
// stagger: from the letters (bottom left) outward
const delay = (x: number, y: number) => Math.round(Math.hypot(x, 400 - y) * 1.6);
---

<svg class:list={['pixel-cluster has-anim', className]} viewBox="0 0 390 400" aria-hidden="true" focusable="false">
  {squares.map(([x, y, s, c], i) => (
    <rect x={x} y={y} width={s} height={s} rx={s * 0.12} fill={fill(c, i)} style={`--d:${delay(x, y)}ms`} />
  ))}
</svg>

<style>
  .pixel-cluster rect {
    transform-box: fill-box;
    transform-origin: center;
    opacity: 0;
    scale: 0.2;
    translate: -14px 22px;
    transition:
      opacity 0.6s ease-out var(--d),
      scale 1.1s var(--ease-theme) var(--d),
      translate 1.1s var(--ease-theme) var(--d);
  }
  /* override the reveal's own fade: the squares carry the motion */
  .pixel-cluster:global(.has-anim) {
    opacity: 1;
    transform: none;
  }
  .pixel-cluster:global(.is-visible) rect {
    opacity: 1;
    scale: 1;
    translate: 0 0;
  }
  @media (prefers-reduced-motion: reduce) {
    .pixel-cluster rect {
      opacity: 1;
      scale: 1;
      translate: 0 0;
      transition: none;
    }
  }
</style>
