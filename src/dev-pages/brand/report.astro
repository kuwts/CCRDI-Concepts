---
// Brand specimen, direction 1: Report (dev only, /component-lab/brand/report). Minimal and
// editorial, like a premium research report: paper-white pages, a large quiet headline that
// rises from behind its own edge, numbered sections in a mono, hairline rules, one monochrome
// photograph overlapping the next section, and a line chart that draws itself as you read.
// Red appears as a signal only: a square before a label, the highlighted line, one rule.
// Theme components: Button, LineLink, FeatureGrid, StatRow, Statement, AstroImage; the theme's
// sticky-beside-scrolling layout, overlap and reveals (THEME_CATALOG.md, "Theme design language").
import AstroImage from '@/components/helper/AstroImage.astro';
import Button from '@/components/Button.astro';
import LineLink from '@/components/LineLink.astro';
import FeatureGrid from '@/components/ccc/FeatureGrid.astro';
import StatRow from '@/components/ccc/StatRow.astro';
import Statement from '@/components/ccc/Statement.astro';
import SpecLayout from './parts/SpecLayout.astro';
import SpecHeader from './parts/SpecHeader.astro';
import CircuitRing from './parts/CircuitRing.astro';
import PixelCluster from './parts/PixelCluster.astro';
import LineChart from './parts/LineChart.astro';
import { credibility, hero, labels, oneLiner, positioning, sampleStats, services, taglines } from './copy';

const periods = ['01', '02', '03', '04', '05', '06', '07', '08', '09', '10'];
const series = [
  { name: 'Category average', values: [61, 62, 62, 63, 64, 64, 65, 66, 66, 67] },
  { name: 'Your organization', values: [57, 59, 62, 64, 66, 68, 71, 72, 74, 77], highlight: true },
];
---

<SpecLayout id="report" index={1}>
  <SpecHeader action="link" />

  <!-- Hero: a report cover -->
  <section class="relative overflow-hidden pt-14 lg:pt-20">
    <CircuitRing class="pointer-events-none absolute -right-[22rem] top-6 w-[54rem] text-(--spec-rule) max-lg:hidden" />
    <div class="container relative">
      <div class="flex items-center justify-between border-b border-(--spec-ink) pb-4">
        <p class="spec-label is-signal">Research <span aria-hidden="true">•</span> Data <span aria-hidden="true">•</span> Insights</p>
        <p class="spec-label spec-num text-(--spec-graphite)" aria-hidden="true">01 / 05</p>
      </div>

      {/* two lines, each rising from behind its own edge */}
      <h1 class="report-display mt-14 lg:mt-20">
        <span class="block has-anim mask"><span class="block">Data That Builds</span></span>
        <span class="block has-anim mask delay-100"><span class="block">Better Businesses</span></span>
      </h1>

      <div class="row mt-14 lg:mt-20 items-end">
        <div class="lg:col-5 xl:col-4">
          <p class="text-lead text-(--spec-graphite) has-anim fade delay-150">{hero.lead}</p>
        </div>
        <div class="lg:col-7 xl:col-8 max-lg:mt-10 flex flex-wrap items-center gap-x-10 gap-y-5 lg:justify-end has-anim fade delay-200">
          <Button href="#" label={labels.contact} variant="primary" />
          <LineLink href="#" label={labels.coreServices} tone="dark" icon="arrow" />
        </div>
      </div>
    </div>

    {/* one photograph, monochrome, overlapping the next section */}
    <div class="container relative z-10 mt-16 lg:mt-24 -mb-28 lg:-mb-40">
      <div class="report-photo has-anim clip aspect-[16/9] md:aspect-[21/9] overflow-hidden">
        <AstroImage src="/images/placeholders/ccrdi-open-office.jpg" alt="" widths={[800, 1200, 1600]} sizes="(min-width: 1320px) 1296px, 100vw" class="h-full w-full object-cover object-[50%_78%]" />
      </div>
      <div class="mt-3 flex justify-between text-(--spec-graphite)" aria-hidden="true">
        <span class="spec-label spec-num">02</span>
        <span class="spec-label">{labels.coreServices}</span>
      </div>
    </div>
  </section>

  <!-- Core Services: a sticky heading beside the ruled index -->
  <section class="bg-light pt-[calc(var(--spacing-section-sm)+7rem)] lg:pt-[calc(var(--spacing-section-md)+10rem)] pb-section">
    <div class="container">
      <div class="row">
        <div class="lg:col-4">
          <div class="lg:sticky lg:top-32">
            <p class="spec-label is-signal mb-6 has-anim fade">{labels.coreServices}</p>
            <h2 class="text-h2 has-anim fade delay-50">{taglines.research}</h2>
            <p class="mt-6 max-w-measure text-(--spec-graphite) has-anim fade delay-100">{positioning}</p>
            <PixelCluster tone="mono" class="mt-12 w-24 max-lg:hidden" />
          </div>
        </div>
        <div class="lg:col-7 lg:offset-1 max-lg:mt-16">
          <FeatureGrid items={services.map(({ title, text }) => ({ title, text }))} columns={2} class="report-index" />
        </div>
      </div>
    </div>
  </section>

  <!-- Stat row -->
  <section class="py-section">
    <div class="container">
      <div class="row mb-14 lg:mb-20 items-end">
        <div class="lg:col-6">
          <p class="spec-label is-signal mb-6 has-anim fade"><span class="spec-num">03</span> · Sample figures</p>
          <h2 class="text-h2 has-anim fade delay-50">{taglines.trust}</h2>
        </div>
        <div class="lg:col-5 lg:offset-1 max-lg:mt-6">
          <p class="text-(--spec-graphite) has-anim fade delay-100">{credibility}</p>
        </div>
      </div>
      <StatRow items={sampleStats} tone="light" class="report-stats" />
    </div>
  </section>

  <!-- Chart: a figure beside its heading -->
  <section class="hairline-top bg-(--spec-white) py-section">
    <div class="container">
      <div class="row">
        <div class="lg:col-4">
          <p class="spec-label is-signal mb-6 has-anim fade"><span class="spec-num">04</span> · {services[1].title}</p>
          <h2 class="text-h2 has-anim fade delay-50">{taglines.confidence}</h2>
          <p class="mt-6 text-(--spec-graphite) has-anim fade delay-100">{services[1].text}</p>
        </div>
        <div class="lg:col-8 max-lg:mt-14">
          <div class="mb-8 flex flex-wrap items-center justify-between gap-4 border-b border-(--spec-rule) pb-4">
            <p class="spec-label text-(--spec-graphite)">Sample data · not CCRDI research</p>
            <ul class="report-legend spec-label" aria-hidden="true">
              <li><i class="bg-(--spec-red)"></i>{series[1].name}</li>
              <li><i class="bg-(--spec-steel)"></i>{series[0].name}</li>
            </ul>
          </div>
          <LineChart series={series} periods={periods} min={50} max={80} ticks={[50, 60, 70, 80]} caption="Sample data: index by period, your organization and the category average" />
        </div>
      </div>
    </div>
  </section>

  <!-- Statement: the theme's word-by-word statement band -->
  <Statement statement={credibility} background="light" />

  <!-- Footer (specimen) -->
  <footer class="border-t border-(--spec-ink) bg-(--spec-page) pt-16 pb-24">
    <div class="container">
      <div class="row items-end gap-y-10">
        <div class="lg:col-5">
          <AstroImage src="/images/brands/ccrdi.png" alt="Consumer Choice Research, Data & Insights" height={96} class="h-16 w-auto" />
          <p class="mt-6 max-w-sm text-[15px] text-(--spec-graphite)">{oneLiner}</p>
        </div>
        <div class="lg:col-7 flex flex-wrap gap-x-10 gap-y-3 lg:justify-end">
          {labels.nav.map((n) => <a href="#" class="spec-label">{n}</a>)}
        </div>
      </div>
    </div>
  </footer>
</SpecLayout>

<style is:global>
  [data-direction='report'] {
    --text-h2: clamp(1.875rem, 1.4rem + 1.6vw, 2.875rem);
  }
  [data-direction='report'] :is(h1, h2, h3, .text-h2, .text-h3, .text-statement) {
    font-family: var(--font-heading);
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  /* the cover headline: very large, light, tight, set in two lines that rise from behind
     their own edges */
  .report-display {
    font-family: var(--font-heading);
    font-size: clamp(3rem, 1.4rem + 7vw, 8.25rem);
    font-weight: 450;
    font-stretch: 92%;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }
  /* photography: monochrome, cool */
  .report-photo {
    position: relative;
    background: var(--spec-ink);
  }
  .report-photo img {
    filter: grayscale(1) contrast(1.18) brightness(0.9);
  }
  .report-photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--spec-graphite);
    mix-blend-mode: soft-light;
    opacity: 0.45;
    pointer-events: none;
  }
  /* FeatureGrid as a report's index: mono numbering, no icons, a 1px ink rule */
  .report-index .feature-rule {
    background: var(--spec-ink);
  }
  .report-index .tabular-nums {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
    color: var(--spec-graphite);
  }
  .report-index .feature > div:last-child {
    margin-top: 2.5rem;
  }
  /* StatRow as figures in a report: open tiles, light numerals, a red rule that draws */
  .report-stats .stat-tile {
    background: transparent;
    padding-left: 0;
    border-radius: 0;
    border-top: 1px solid var(--spec-rule);
  }
  .report-stats .stat-tile > span:first-child {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.08em;
  }
  .report-stats dd {
    font-family: var(--font-heading);
    font-weight: 400;
    letter-spacing: -0.04em;
    font-size: clamp(3rem, 2rem + 3vw, 5.25rem);
  }
  .report-stats dt {
    font-family: var(--mono);
    font-size: 12px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .report-stats .stat-rule {
    background: var(--spec-red);
    bottom: auto;
    top: -1px;
    right: auto;
    width: 32px;
    height: 2px;
  }
  /* the statement band upright, in the heading face */
  [data-direction='report'] .pull-quote {
    font-style: normal;
    font-weight: 400;
    letter-spacing: -0.025em;
  }
  .report-legend {
    display: flex;
    gap: 1.5rem;
  }
  .report-legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .report-legend i {
    width: 8px;
    height: 8px;
  }
</style>
