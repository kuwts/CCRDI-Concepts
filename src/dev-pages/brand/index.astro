---
// Brand specimen, round 2 (dev only, not linked, noindex): the three CCRDI design directions side
// by side for the project owner's choice. Each direction is its own page (report.astro,
// platform.astro, signal.astro) built with the theme's components; here each shows its palette
// with contrast, its type pairing, and a live preview of the page in a frame at a desktop width
// of 1280px, scaled to fit. Round 1 (two layout variants) stays at /component-lab/brand/round-1.
import '@fontsource-variable/instrument-sans/wdth.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/archivo/wdth.css';
import '@fontsource-variable/jetbrains-mono';
import Base from '@/layouts/Base.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import { contrast, direction, directions, fontFamily, headStyle, hexOf } from './directions';

// the pairs that decide each palette: text, secondary text, red on the page, the primary button
const checks = (id: string) => {
  const d = direction(id);
  const page = { report: 'paper', platform: 'canvas', signal: 'white' }[id]!;
  const secondary = d.palette.some((c) => c.key === 'slate') ? 'slate' : 'graphite';
  return [
    ['Text', 'ink', page],
    ['Secondary text', secondary, page],
    ['Red label', 'red', page],
    ['Button label', 'white', 'ink'],
  ].map(([use, fg, bg]) => ({ use, ratio: contrast(hexOf(d, fg), hexOf(d, bg)) }));
};
---

<Base title="Brand specimen" noindex footerClass="hidden">
  <Fragment slot="head" set:html={headStyle(direction('signal'))} />

  <div class="spec-index">
    <header class="border-b border-(--spec-rule)">
      <div class="container flex flex-wrap items-center justify-between gap-6 py-4">
        <AstroImage src="/images/brands/ccrdi.png" alt="Consumer Choice Research, Data & Insights" height={96} loading="eager" class="h-14 w-auto" />
        <p class="idx-label text-(--spec-slate)">Brand specimen · round 2 · dev only</p>
      </div>
    </header>

    <section class="pt-16 pb-10 lg:pt-24">
      <div class="container">
        <p class="idx-label idx-signal mb-6">Three directions</p>
        <h1 class="max-w-4xl text-h1 font-semibold tracking-tight">Tech and data-forward, light-led, on the logo’s ink, red and silver</h1>
        <p class="mt-6 max-w-measure text-(--spec-slate)">Each direction is a full sample page built with the theme’s components: a light header and hero, a card section, a stat row and a chart, in framework copy. Figures and chart values are sample data. Open each one full size to see its animations as you scroll.</p>
      </div>
    </section>

    {directions.map((d, i) => (
      <section class="border-t border-(--spec-rule) py-16 lg:py-20">
        <div class="container">
          <div class="row gap-y-12">
            <div class="lg:col-4">
              <p class="idx-label text-(--spec-slate)">{String(i + 1).padStart(2, '0')}</p>
              <h2 class="mt-3 text-[2.5rem] leading-none tracking-tight" style={`font-family:${fontFamily(d.fonts.heading)};font-weight:${d.id === 'report' ? 500 : 600};${d.id === 'signal' ? 'font-stretch:116%;' : ''}`}>{d.name}</h2>
              <p class="mt-5 text-[15px] leading-relaxed text-(--spec-slate)">{d.summary}</p>

              <dl class="mt-8 space-y-4 border-t border-(--spec-rule) pt-6 text-[14px]">
                <div>
                  <dt class="idx-label text-(--spec-slate)">Headings</dt>
                  <dd class="mt-1 text-2xl" style={`font-family:${fontFamily(d.fonts.heading)};font-weight:${d.id === 'report' ? 500 : 600};${d.id === 'signal' ? 'font-stretch:116%;' : ''}`}>{d.fonts.heading} · Data That Builds</dd>
                </div>
                <div>
                  <dt class="idx-label text-(--spec-slate)">Numbers, labels, eyebrows</dt>
                  <dd class="mt-1 text-lg tabular-nums" style={`font-family:${fontFamily(d.fonts.mono)}`}>{d.fonts.mono} · 0123456789</dd>
                </div>
                <div>
                  <dt class="idx-label text-(--spec-slate)">Body</dt>
                  <dd class="mt-1" style={`font-family:${fontFamily(d.fonts.body)}`}>{d.fonts.body}{d.fonts.body === 'Inter' ? ' (shared with Consumer Choice Canada)' : ''}</dd>
                </div>
              </dl>

              <ul class="mt-8 grid grid-cols-6 gap-1.5" aria-label={`${d.name} palette`}>
                {d.palette.filter((c) => !/^h\d$/.test(c.key)).map((c) => (
                  <li title={`${c.name} ${c.hex}: ${c.use}`}>
                    <span class="block aspect-square rounded-[3px] border border-(--spec-rule)" style={`background:${c.hex}`}></span>
                    <span class="mt-1.5 block text-[10px] leading-tight text-(--spec-slate)" style={`font-family:${fontFamily(d.fonts.mono)}`}>{c.name}<br />{c.hex}</span>
                  </li>
                ))}
              </ul>

              <table class="mt-8 w-full text-[13px]">
                <caption class="sr-only">{d.name}: key contrast ratios</caption>
                <tbody>
                  {checks(d.id).map((c) => (
                    <tr class="border-t border-(--spec-rule)">
                      <th scope="row" class="py-2 text-left font-normal text-(--spec-slate)">{c.use}</th>
                      <td class="py-2 text-right tabular-nums">{c.ratio.toFixed(2)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              <a href={`/component-lab/brand/${d.id}`} class="line-link mt-8 inline-block text-[15px] font-medium text-(--spec-ink)">Open {d.name} full size</a>
            </div>

            <div class="lg:col-8">
              <div class="idx-frame" data-spec-frame>
                <iframe src={`/component-lab/brand/${d.id}`} title={`${d.name}: sample page`} tabindex="-1" loading={i === 0 ? 'eager' : 'lazy'}></iframe>
              </div>
            </div>
          </div>
        </div>
      </section>
    ))}
  </div>
</Base>

<style is:global>
  body:has(.spec-index) {
    background: var(--spec-white);
    color: var(--spec-ink);
  }
  .spec-index .idx-label {
    font-family: var(--spec-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .spec-index .idx-signal::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 10px 1px 0;
    vertical-align: middle;
    background: var(--spec-red);
  }
  /* a window onto the page: the top 1,000px of it at 1280px wide, scaled to the column, with a
     fade at the foot; the full page opens from the link */
  .idx-frame {
    position: relative;
    height: var(--h, 640px);
    overflow: hidden;
    border: 1px solid var(--spec-rule);
    border-radius: 8px;
  }
  .idx-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 120px;
    background: linear-gradient(transparent, var(--spec-white));
    pointer-events: none;
  }
  .idx-frame iframe {
    display: block;
    width: 1280px;
    height: 1700px;
    border: 0;
    transform-origin: 0 0;
    pointer-events: none;
  }
</style>

<script>
  // Each preview renders the page at 1280px wide and scales it to the column (the full page
  // opens from the link). The dev toolbar and the dev size badge are hidden inside the frame.
  const DESKTOP = 1280;
  document.querySelectorAll<HTMLElement>('[data-spec-frame]').forEach((wrap) => {
    const frame = wrap.querySelector('iframe')!;
    const fit = () => {
      const scale = wrap.clientWidth / DESKTOP;
      frame.style.transform = `scale(${scale})`;
      wrap.style.setProperty('--h', `${Math.round(1700 * scale)}px`);
    };
    frame.addEventListener('load', () => {
      const doc = frame.contentDocument;
      if (doc) {
        const style = doc.createElement('style');
        style.textContent = 'astro-dev-toolbar,.z-500000,.spec-badge{display:none!important}';
        doc.head.append(style);
      }
    });
    fit();
    new ResizeObserver(fit).observe(wrap);
  });
</script>
