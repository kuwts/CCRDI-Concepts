---
// A ranked bar chart (dev only, brand specimen, Signal direction). Signature: as it comes into
// view the bars grow from the baseline one after another on the theme's curve while their values
// count up (the theme's CounterUp); when the highlighted bar lands, three of the logo's pixel
// squares break off its end. Red marks that one bar; the rest are steel. A hairline marks the
// average. Hover or keyboard focus on a row shows its value against the average; the table view
// carries every number. Reduced motion: in place, values final.
import CounterUp from '@/components/CounterUp.astro';

interface Props {
  bars: { label: string; value: number; highlight?: boolean }[];
  max?: number;
  ticks?: number[];
  caption: string;
  /** name of the reference line, e.g. "Category average" */
  averageLabel: string;
  class?: string;
}
const { bars, max = 100, ticks = [0, 20, 40, 60, 80, 100], caption, averageLabel, class: className = '' } = Astro.props;
const average = Math.round(bars.reduce((n, b) => n + b.value, 0) / bars.length);
const pct = (v: number) => `${(v / max) * 100}%`;
---

<figure class:list={['bar-chart', className]}>
  <div class="bc-plot has-anim">
    <div class="bc-grid" aria-hidden="true">
      {ticks.map((t) => <span style={`left:${pct(t)}`}><i>{t}</i></span>)}
      <span class="bc-avg" style={`left:${pct(average)}`}><i>{averageLabel} {average}</i></span>
    </div>
    <ol class="bc-rows">
      {bars.map((b, i) => (
        <li
          class:list={['bc-row', b.highlight && 'is-hl']}
          style={`--i:${i}`}
          tabindex="0"
          aria-label={`${b.label}: ${b.value} (${averageLabel.toLowerCase()} ${average})`}
        >
          <span class="bc-label" aria-hidden="true">{b.label}</span>
          <span class="bc-track" aria-hidden="true">
            <span class="bc-bar" style={`width:${pct(b.value)}`}></span>
            {b.highlight && (
              <span class="bc-bits" style={`left:${pct(b.value)}`}>
                <i></i><i></i><i></i>
              </span>
            )}
            <span class="bc-value" style={`left:${pct(b.value)}`}><CounterUp value={String(b.value)} /></span>
            <span class="bc-tip">
              {b.value} · {b.value - average > 0 ? '+' : ''}{b.value - average} against the {averageLabel.toLowerCase()}
            </span>
          </span>
        </li>
      ))}
    </ol>
  </div>

  <details class="bc-table">
    <summary>Show as a table</summary>
    <table>
      <caption class="sr-only">{caption}</caption>
      <tbody>
        {bars.map((b) => <tr><th scope="row">{b.label}</th><td>{b.value}</td></tr>)}
        <tr><th scope="row">{averageLabel}</th><td>{average}</td></tr>
      </tbody>
    </table>
  </details>
</figure>

<style>
  .bar-chart {
    --mono: var(--spec-mono, ui-monospace, monospace);
    --label: 11.5rem;
    --end: 3rem;
  }
  @media (max-width: 575px) {
    .bar-chart {
      --label: 0px;
    }
  }
  .bc-plot {
    position: relative;
    padding: 2.25rem 0 1.75rem;
  }
  .bc-plot:global(.has-anim) {
    opacity: 1;
    transform: none;
  }
  .bc-grid {
    position: absolute;
    inset: 1.25rem var(--end) 0 var(--label);
  }
  .bc-grid span {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--spec-rule);
  }
  .bc-grid i {
    position: absolute;
    bottom: 0;
    translate: -50% 0;
    font: 400 11px/1 var(--mono);
    font-style: normal;
    color: var(--spec-slate);
  }
  .bc-grid .bc-avg {
    top: -0.25rem;
    background: var(--spec-ink);
  }
  .bc-grid .bc-avg i {
    top: -1.1rem;
    bottom: auto;
    white-space: nowrap;
    color: var(--spec-ink);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .bc-rows {
    position: relative;
    display: grid;
    gap: 18px;
  }
  .bc-row {
    display: grid;
    grid-template-columns: var(--label) 1fr;
    align-items: center;
    outline-offset: 6px;
  }
  @media (max-width: 575px) {
    .bc-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }
  }
  .bc-label {
    padding-right: 1rem;
    font-size: 14px;
    color: var(--spec-slate);
  }
  .bc-row.is-hl .bc-label {
    color: var(--spec-ink);
    font-weight: 600;
  }
  .bc-track {
    position: relative;
    height: 14px;
    margin-right: var(--end);
  }
  .bc-bar {
    position: absolute;
    inset: 0 auto 0 0;
    background: var(--spec-steel);
    border-radius: 0 3px 3px 0;
    transform-origin: left center;
    scale: 0 1;
    transition: scale 1.3s var(--ease-theme) calc(var(--i) * 110ms + 150ms);
  }
  .bc-row.is-hl .bc-bar {
    background: var(--spec-red);
  }
  .bc-plot:global(.is-visible) .bc-bar {
    scale: 1 1;
  }
  .bc-value {
    position: absolute;
    top: 50%;
    translate: 10px -50%;
    padding: 0 4px;
    background: var(--spec-white);
    font: 400 13px/1 var(--mono);
    font-variant-numeric: tabular-nums;
    color: var(--spec-slate);
    opacity: 0;
    transition: opacity 0.4s ease-out calc(var(--i) * 110ms + 700ms);
  }
  .bc-row.is-hl .bc-value {
    color: var(--spec-ink);
    font-weight: 600;
    translate: 36px -50%;
  }
  .bc-plot:global(.is-visible) .bc-value {
    opacity: 1;
  }
  /* three of the logo's squares break off the highlighted bar's end once it lands */
  .bc-bits {
    position: absolute;
    top: 50%;
  }
  .bc-bits i {
    position: absolute;
    width: 9px;
    height: 9px;
    border-radius: 1px;
    background: var(--spec-signal, var(--spec-red));
    opacity: 0;
    translate: -6px -3px;
    transition:
      opacity 0.3s ease-out,
      translate 0.9s var(--ease-theme);
    transition-delay: calc(var(--i) * 110ms + 1100ms);
  }
  .bc-bits i:nth-child(2) {
    width: 6px;
    height: 6px;
    background: var(--spec-wine, var(--spec-red));
  }
  .bc-bits i:nth-child(3) {
    width: 7px;
    height: 7px;
    background: var(--spec-blush, var(--spec-rule));
  }
  .bc-plot:global(.is-visible) .bc-bits i:nth-child(1) { opacity: 1; translate: 5px -19px; }
  .bc-plot:global(.is-visible) .bc-bits i:nth-child(2) { opacity: 1; translate: 17px -10px; }
  .bc-plot:global(.is-visible) .bc-bits i:nth-child(3) { opacity: 1; translate: 8px 9px; }
  .bc-tip {
    position: absolute;
    left: 0;
    bottom: calc(100% + 10px);
    z-index: 2;
    padding: 7px 10px;
    white-space: nowrap;
    background: var(--spec-ink);
    color: var(--spec-white);
    font: 400 12px/1 var(--mono);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) ease-out;
  }
  .bc-row:is(:hover, :focus-visible) .bc-tip {
    opacity: 1;
  }
  .bc-row:is(:hover, :focus-visible) .bc-bar {
    filter: brightness(1.08);
  }
  .bc-table {
    margin-top: 1.5rem;
    font: 400 12px/1.4 var(--mono);
  }
  .bc-table summary {
    cursor: pointer;
    width: max-content;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .bc-table table {
    margin-top: 1rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .bc-table :is(th, td) {
    padding: 6px 24px 6px 0;
    border-bottom: 1px solid var(--spec-rule);
    text-align: left;
    font-weight: 400;
  }
  @media (prefers-reduced-motion: reduce) {
    .bc-bar,
    .bc-value,
    .bc-bits i {
      transition: none;
    }
    .bc-bar {
      scale: 1 1;
    }
    .bc-value {
      opacity: 1;
    }
    .bc-bits i:nth-child(1) { opacity: 1; translate: 5px -19px; }
    .bc-bits i:nth-child(2) { opacity: 1; translate: 17px -10px; }
    .bc-bits i:nth-child(3) { opacity: 1; translate: 8px 9px; }
  }
</style>
