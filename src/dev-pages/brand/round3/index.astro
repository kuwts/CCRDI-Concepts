---
// Design directions, round 3 (/component-lab/brand; dev and preview builds; noindex): the
// presentation overview of the three CCRDI directions, Precision, Human Insight and Vivid. For
// each: its idea, imagery and signature, its type pairing set in its own faces, its palette with
// the contrast of the pairs that matter, and a live preview of its page (rendered at 1280px wide
// and scaled to the column). Round 2 stays as presented at /component-lab/brand/round-2.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import Base from '@/layouts/Base.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import PixelCluster from './parts/PixelCluster.astro';
import { contrast, direction, directions, fontFamily, headStyle, hexOf } from './directions';

// the pairs that decide each palette
const checks: Record<string, [string, string, string][]> = {
  precision: [['Text on the page', 'ink', 'canvas'], ['Secondary text', 'slate', 'canvas'], ['Red on the page', 'red', 'canvas'], ['Button label', 'white', 'ink']],
  'human-insight': [['Text on the page', 'espresso', 'linen'], ['Secondary text', 'taupe', 'linen'], ['Crimson on the page', 'crimson', 'linen'], ['Button label', 'white', 'crimson']],
  vivid: [['White on the red field', 'white', 'red'], ['White on the wine field', 'white', 'wine'], ['Wine on blush', 'wine', 'blush'], ['Red on the page', 'red', 'white']],
};
const headingStyle = (id: string) =>
  ({
    precision: `font-family:${fontFamily('Geist')};font-weight:600;letter-spacing:-0.04em`,
    'human-insight': `font-family:${fontFamily('Fraunces')};font-weight:380;letter-spacing:-0.02em;font-variation-settings:'SOFT' 60`,
    vivid: `font-family:${fontFamily('Bricolage Grotesque')};font-weight:800;font-stretch:78%;letter-spacing:-0.03em`,
  })[id];
const accent = { precision: 'red', 'human-insight': 'crimson', vivid: 'red' } as const;
---

<Base title="Design directions" noindex footerClass="hidden">
  <Fragment slot="head" set:html={headStyle(direction('precision'))} />

  <div class="dir-index">
    <header class="border-b border-(--spec-rule)">
      <div class="container flex flex-wrap items-center justify-between gap-6 py-4">
        <AstroImage src="/images/brands/ccrdi.png" alt="Consumer Choice Research, Data & Insights" height={96} loading="eager" class="h-14 w-auto" />
        <p class="dir-label text-(--spec-slate)">Design directions · for review</p>
      </div>
    </header>

    <section class="pt-16 pb-14 lg:pt-24 lg:pb-20">
      <div class="container">
        <div class="row items-end gap-y-10">
          <div class="lg:col-8">
            <p class="dir-label dir-signal mb-6">Three directions</p>
            <h1 class="text-[clamp(2.25rem,1.5rem+2.6vw,4rem)] leading-[1.02] font-semibold tracking-[-0.04em]">Precision, Human Insight and Vivid</h1>
            <p class="mt-6 max-w-[40rem] text-lead text-(--spec-slate)">Three different ways to carry the CCRDI brand, all from the logo’s colours, its pixel squares and its circuit ring. Each is a full sample page: a header and hero, a card section, a stat row and a chart, in the client’s approved copy. Figures and chart values are sample data. Open each page and scroll to see its animations.</p>
          </div>
          <div class="lg:col-3 lg:offset-1">
            <PixelCluster class="ml-auto w-36 max-lg:mr-auto max-lg:ml-0" />
          </div>
        </div>
      </div>
    </section>

    {directions.map((d, i) => (
      <section class="border-t border-(--spec-rule) py-16 lg:py-24">
        <div class="container">
          <div class="row gap-y-12">
            <div class="lg:col-4">
              <p class="dir-label text-(--spec-slate)">{String(i + 1).padStart(2, '0')}</p>
              <h2 class="mt-3 text-[3rem] leading-none" style={headingStyle(d.id)}>{d.name}</h2>
              <p class="mt-6 text-[15px] leading-relaxed text-(--spec-slate)">{d.summary}</p>

              <dl class="mt-8 space-y-5 border-t border-(--spec-rule) pt-6 text-[14px] leading-relaxed">
                <div>
                  <dt class="dir-label text-(--spec-slate)">Type</dt>
                  <dd class="mt-2 text-[1.75rem] leading-tight" style={headingStyle(d.id)}>{d.fonts.heading}</dd>
                  <dd class="mt-1" style={`font-family:${fontFamily(d.fonts.body)}`}>{d.fonts.body === d.fonts.heading ? `${d.fonts.body} for text` : `with ${d.fonts.body} for text`}{d.fonts.label !== d.fonts.body && d.fonts.label !== d.fonts.heading ? `, ${d.fonts.label} for figures and labels` : ''}</dd>
                </div>
                <div>
                  <dt class="dir-label text-(--spec-slate)">Imagery</dt>
                  <dd class="mt-2">{d.imagery}</dd>
                </div>
                <div>
                  <dt class="dir-label text-(--spec-slate)">Signature</dt>
                  <dd class="mt-2">{d.signature}</dd>
                </div>
              </dl>

              <ul class="mt-8 grid grid-cols-6 gap-1.5" aria-label={`${d.name} palette`}>
                {d.palette.filter((c) => !/^h\d$/.test(c.key)).map((c) => (
                  <li title={`${c.name} ${c.hex}: ${c.use}`}>
                    <span class="block aspect-square rounded-[3px] border border-(--spec-rule)" style={`background:${c.hex}`}></span>
                    <span class="dir-swatch mt-1.5 block">{c.name}<br />{c.hex}</span>
                  </li>
                ))}
              </ul>

              <table class="mt-8 w-full text-[13px]">
                <caption class="sr-only">{d.name}: contrast of the key pairs (WCAG 2.1 AA: 4.5 for text)</caption>
                <tbody>
                  {checks[d.id].map(([use, fg, bg]) => (
                    <tr class="border-t border-(--spec-rule)">
                      <th scope="row" class="py-2 text-left font-normal text-(--spec-slate)">{use}</th>
                      <td class="dir-num py-2 text-right">{contrast(hexOf(d, fg), hexOf(d, bg)).toFixed(2)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              <a href={`/component-lab/brand/${d.id}`} class="dir-open mt-9" style={`--dir-accent:${hexOf(d, accent[d.id])}`}>Open {d.name}<span aria-hidden="true">→</span></a>
            </div>

            <div class="lg:col-8">
              <a href={`/component-lab/brand/${d.id}`} class="dir-frame block" data-dir-frame tabindex="-1" aria-hidden="true">
                <iframe src={`/component-lab/brand/${d.id}`} title={`${d.name}: sample page`} tabindex="-1" loading={i === 0 ? 'eager' : 'lazy'}></iframe>
              </a>
            </div>
          </div>
        </div>
      </section>
    ))}

    <footer class="border-t border-(--spec-rule) py-10">
      <div class="container flex flex-wrap justify-between gap-4">
        <p class="dir-label text-(--spec-slate)">Round 2, as presented: <a href="/component-lab/brand/round-2" class="underline underline-offset-4">Report, Platform, Signal</a></p>
        <p class="dir-label text-(--spec-slate)">Photography: free-licence placeholders (Unsplash)</p>
      </div>
    </footer>
  </div>
</Base>

<style is:global>
  body:has(.dir-index) {
    background: var(--spec-white);
    color: var(--spec-ink);
  }
  .dir-index .dir-label {
    font-family: var(--spec-mono);
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .dir-index .dir-num,
  .dir-index .dir-swatch {
    font-family: var(--spec-mono);
    font-variant-numeric: tabular-nums;
  }
  .dir-index .dir-swatch {
    font-size: 10px;
    line-height: 1.3;
    color: var(--spec-slate);
  }
  .dir-index .dir-signal::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 10px 1px 0;
    vertical-align: middle;
    background: var(--spec-red);
  }
  .dir-open {
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 14px 22px;
    border-radius: 6px;
    background: var(--spec-ink);
    color: var(--spec-white);
    font-size: 15px;
    font-weight: 600;
  }
  .dir-open span {
    color: var(--dir-accent);
    transition: translate var(--duration-base) var(--ease-theme);
  }
  .dir-open:is(:hover, :focus-visible) span {
    translate: 4px 0;
  }
  /* a window onto the page: its top, at 1280px wide, scaled to the column; a fade at the foot */
  .dir-frame {
    position: relative;
    height: var(--h, 640px);
    overflow: hidden;
    border: 1px solid var(--spec-rule);
    border-radius: 10px;
    transition: border-color var(--duration-base) ease-out;
  }
  .dir-frame:hover {
    border-color: var(--spec-steel);
  }
  .dir-frame::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 140px;
    background: linear-gradient(transparent, var(--spec-white));
    pointer-events: none;
  }
  .dir-frame iframe {
    display: block;
    width: 1280px;
    height: 1800px;
    border: 0;
    transform-origin: 0 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .dir-open span {
      transition: none;
    }
  }
</style>

<script>
  // Each preview renders its page at 1280px wide, scaled to the column; the dev toolbar, the dev
  // size badge and the direction badge are hidden inside the frame.
  const DESKTOP = 1280;
  document.querySelectorAll<HTMLElement>('[data-dir-frame]').forEach((wrap) => {
    const frame = wrap.querySelector('iframe')!;
    const fit = () => {
      const scale = wrap.clientWidth / DESKTOP;
      frame.style.transform = `scale(${scale})`;
      wrap.style.setProperty('--h', `${Math.round(1800 * scale)}px`);
    };
    frame.addEventListener('load', () => {
      const doc = frame.contentDocument;
      if (doc) {
        const style = doc.createElement('style');
        style.textContent = 'astro-dev-toolbar,.z-500000,.spec-badge{display:none!important}';
        doc.head.append(style);
      }
    });
    fit();
    new ResizeObserver(fit).observe(wrap);
  });
</script>
