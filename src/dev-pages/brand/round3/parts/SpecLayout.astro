---
// The page frame for a round 3 brand direction (dev and preview builds): the site's Base layout
// (scripts, reveals, global styles) with the direction's palette, fonts and shape mapped onto
// the theme's roles for this page only, the site header and footer hidden, and the specimen's
// shared details: the label style, figures, the primary button's hover, text wrapping, and a
// small badge naming the direction.
import '@fontsource-variable/geist';
import '@fontsource-variable/geist-mono';
import '@fontsource-variable/fraunces/full.css';
import '@fontsource-variable/fraunces/full-italic.css';
import '@fontsource-variable/dm-sans';
import '@fontsource-variable/bricolage-grotesque/standard.css';
import Base from '@/layouts/Base.astro';
import { direction, headStyle } from '../directions';

interface Props {
  id: 'precision' | 'human-insight' | 'vivid';
  index: number;
}
const { id, index } = Astro.props;
const d = direction(id);
---

<Base title={`Design direction: ${d.name}`} noindex footerClass="hidden">
  <Fragment slot="head" set:html={headStyle(d)} />
  <div class="spec" data-direction={id}>
    <slot />
  </div>
  <p class="spec-badge" aria-hidden="true">{String(index).padStart(2, '0')} · {d.name}</p>
</Base>

<style is:global>
  body:has(.spec) {
    background: var(--spec-page);
    color: var(--spec-ink);
  }
  /* labels and eyebrows: each direction's label face (a mono, or the body face), small, tracked */
  .spec .spec-label {
    font-family: var(--spec-label-font);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  /* a label led by one of the logo's squares, in the accent: the signal */
  .spec .spec-label.is-signal::before {
    content: '';
    display: inline-block;
    width: 7px;
    height: 7px;
    margin: 0 10px 1px 0;
    vertical-align: middle;
    background: var(--spec-accent);
  }
  .spec .spec-num {
    font-family: var(--spec-label-font);
    font-variant-numeric: tabular-nums;
  }
  /* the primary button: one of the logo's squares before the label; on hover or focus it
     stretches into a short signal bar while the fill deepens (Human Insight: a pill, no square) */
  .spec .btn-primary span {
    display: inline-flex;
    align-items: center;
    gap: 12px;
  }
  .spec .btn-primary span::before {
    content: '';
    width: 7px;
    height: 7px;
    background: var(--btn-mark, var(--spec-red));
    transition: width var(--duration-base) var(--ease-theme);
  }
  .spec .btn-primary:is(:hover, :focus-visible) span::before {
    width: 18px;
  }
  [data-direction='human-insight'] .btn-primary span::before {
    display: none;
  }
  [data-direction='vivid'] {
    --btn-mark: var(--spec-blush);
  }
  .spec :is(h1, h2, h3),
  .spec .text-display,
  .spec .text-h1,
  .spec .text-h2,
  .spec .text-h3,
  .spec .text-statement {
    text-wrap: balance;
  }
  /* paragraphs never end on a lone word */
  .spec p,
  .spec li,
  .spec dd {
    text-wrap: pretty;
  }
  .spec ::selection {
    background: var(--spec-ink);
    color: var(--spec-white);
  }
  /* which direction this is, bottom left, clear of the theme's scroll-to-top button */
  .spec-badge {
    position: fixed;
    left: 16px;
    bottom: 16px;
    z-index: 60;
    padding: 7px 10px 7px 26px;
    background: color-mix(in srgb, var(--spec-ink) 88%, transparent);
    backdrop-filter: blur(8px);
    color: var(--spec-white);
    font: 500 11px/1 var(--spec-label-font);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .spec-badge::before {
    content: '';
    position: absolute;
    left: 10px;
    top: 50%;
    width: 7px;
    height: 7px;
    translate: 0 -50%;
    background: var(--spec-accent);
  }
  @media (prefers-reduced-motion: reduce) {
    .spec .btn-primary span::before {
      transition: none;
    }
  }
</style>
