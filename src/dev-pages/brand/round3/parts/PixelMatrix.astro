---
// A heat map made of the logo's pixel squares (dev only, brand specimen, Platform direction).
// Signature: as it comes into view the squares fly in from the upper right, where the logo's
// squares sit, and settle into their rows column by column, a wave on the theme's curve; once
// set, a single hairline scans across the columns and stops. Values run on a five-step cool
// ramp; red marks only the highlighted row (its label square and a hairline frame). Hover a
// square for its value; the table view carries every number. Reduced motion: in place, no scan.
interface Props {
  rows: { name: string; values: number[]; highlight?: boolean }[];
  columns: string[];
  caption: string;
  class?: string;
}
const { rows, columns, caption, class: className = '' } = Astro.props;

const step = (v: number) => (v < 20 ? 1 : v < 40 ? 2 : v < 60 ? 3 : v < 80 ? 4 : 5);
const nc = columns.length;
const nr = rows.length;
// each square's start: pulled toward the top right and scattered (deterministic jitter)
const jitter = (r: number, c: number) => ((Math.sin(r * 12.9898 + c * 78.233) * 43758.5453) % 1 + 1) % 1;
const start = (r: number, c: number) => {
  const j = jitter(r, c);
  const dx = (nc - c) * 5 + j * 40;
  const dy = -(r + 1) * 14 - j * 30;
  return `--sx:${dx.toFixed(0)}px;--sy:${dy.toFixed(0)}px;--d:${(c * 32 + r * 24 + j * 140).toFixed(0)}ms`;
};
const hlRow = rows.findIndex((r) => r.highlight);
---

<figure class:list={['pixel-matrix', className]}>
  <div class="pm-body has-anim" style={`--cols:${nc};--rows:${nr};--hl:${hlRow}`}>
    <div class="pm-grid" aria-hidden="true">
      {rows.map((row, r) => (
        <div class:list={['pm-row', row.highlight && 'is-hl']}>
          <span class="pm-label"><i></i>{row.name}</span>
          <div class="pm-cells">
            {row.values.map((v, c) => (
              <span class={`pm-cell s${step(v)}`} style={start(r, c)} data-v={v}>
                <span class="pm-tip">{row.name} · {columns[c]} · {v}</span>
              </span>
            ))}
          </div>
        </div>
      ))}
      <div class="pm-cols">
        <span class="pm-label"></span>
        <div class="pm-cells">{columns.map((c) => <span>{c}</span>)}</div>
      </div>
      <span class="pm-scan" aria-hidden="true"></span>
    </div>
  </div>

  <div class="pm-legend" aria-hidden="true">
    <span>0</span>
    {[1, 2, 3, 4, 5].map((s) => <i class={`s${s}`}></i>)}
    <span>100</span>
  </div>

  <details class="pm-table">
    <summary>Show as a table</summary>
    <div class="pm-table-scroll" role="region" aria-label={caption} tabindex="0">
      <table>
        <caption class="sr-only">{caption}</caption>
        <thead><tr><th scope="col"></th>{columns.map((c) => <th scope="col">{c}</th>)}</tr></thead>
        <tbody>
          {rows.map((row) => (
            <tr><th scope="row">{row.name}</th>{row.values.map((v) => <td>{v}</td>)}</tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</figure>

<style>
  .pixel-matrix {
    --mono: var(--spec-mono, ui-monospace, monospace);
    --label: 11rem;
    --gap: 4px;
  }
  /* phones: each row's label above its squares, the squares the full width */
  @media (max-width: 767px) {
    .pixel-matrix {
      --label: 0px;
      --gap: 2px;
    }
    .pm-grid {
      row-gap: 10px;
    }
    .pm-row {
      grid-template-columns: 1fr;
      row-gap: 6px;
    }
  }
  .pm-body:global(.has-anim) {
    opacity: 1;
    transform: none;
  }
  .pm-grid {
    position: relative;
    display: grid;
    gap: var(--gap);
  }
  .pm-row,
  .pm-cols {
    display: grid;
    grid-template-columns: var(--label) 1fr;
    align-items: center;
  }
  .pm-row.is-hl {
    position: relative;
  }
  /* the highlighted row: a hairline frame in red */
  .pm-row.is-hl .pm-cells {
    outline: 1px solid var(--spec-red);
    outline-offset: 4px;
  }
  .pm-label {
    display: flex;
    align-items: center;
    gap: 10px;
    padding-right: 16px;
    font: 400 12px/1.2 var(--mono);
    color: var(--spec-slate);
    letter-spacing: 0.02em;
  }
  .pm-label i {
    flex: none;
    width: 7px;
    height: 7px;
    background: var(--spec-rule);
  }
  .pm-row.is-hl .pm-label {
    color: var(--spec-ink);
    font-weight: 500;
  }
  .pm-row.is-hl .pm-label i {
    background: var(--spec-red);
  }
  .pm-cells {
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    gap: var(--gap);
  }
  .pm-cell {
    position: relative;
    aspect-ratio: 1;
    border-radius: 1.5px;
    opacity: 0;
    translate: var(--sx) var(--sy);
    scale: 0.35;
    transition:
      opacity 0.5s ease-out var(--d),
      translate 1.2s var(--ease-theme) var(--d),
      scale 1.2s var(--ease-theme) var(--d),
      filter var(--duration-fast) ease-out 0s;
  }
  .s1 { background: var(--spec-h1); }
  .s2 { background: var(--spec-h2); }
  .s3 { background: var(--spec-h3); }
  .s4 { background: var(--spec-h4); }
  .s5 { background: var(--spec-h5); }
  .pm-body:global(.is-visible) .pm-cell {
    opacity: 1;
    translate: 0 0;
    scale: 1;
  }
  .pm-cell:hover {
    box-shadow: 0 0 0 2px var(--spec-white), 0 0 0 3px var(--spec-ink);
    z-index: 3;
  }
  /* focus and context: the other squares recede (a filter, so the assembly's own opacity
     transition and its delays are untouched), the hovered square's row label lights up */
  .pm-grid:has(.pm-cell:hover) .pm-cell:not(:hover) {
    filter: opacity(0.4);
  }
  .pm-row:has(.pm-cell:hover) .pm-label {
    color: var(--spec-ink);
  }
  .pm-tip {
    position: absolute;
    left: 50%;
    bottom: calc(100% + 8px);
    translate: -50% 0;
    padding: 6px 9px;
    white-space: nowrap;
    background: var(--spec-ink);
    color: var(--spec-white);
    font: 400 12px/1 var(--mono);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--duration-fast) ease-out;
  }
  .pm-cell:hover .pm-tip {
    opacity: 1;
  }
  .pm-cols .pm-cells span {
    padding-top: 6px;
    text-align: center;
    font: 400 11px/1 var(--mono);
    color: var(--spec-slate);
  }
  .pm-cols .pm-cells span:nth-child(even) {
    visibility: hidden;
  }
  @media (max-width: 767px) {
    .pm-cols .pm-cells span:not(:nth-child(6n + 1)) {
      visibility: hidden;
    }
  }
  /* the scan: one hairline across the columns once the squares have settled */
  .pm-scan {
    position: absolute;
    top: -6px;
    bottom: 18px;
    left: var(--label);
    width: 1px;
    background: var(--spec-ink);
    opacity: 0;
  }
  .pm-body:global(.is-visible) .pm-scan {
    animation: pm-scan 2.4s var(--ease-theme) 1.9s 1 both;
  }
  @keyframes pm-scan {
    0% { left: var(--label); opacity: 0; }
    10% { opacity: 0.8; }
    85% { opacity: 0.8; }
    100% { left: 100%; opacity: 0; }
  }
  .pm-legend {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 1.5rem 0 0 var(--label);
    font: 400 11px/1 var(--mono);
    color: var(--spec-slate);
  }
  .pm-legend i {
    width: 22px;
    height: 8px;
    border-radius: 1px;
  }
  .pm-legend span:first-child { margin-right: 6px; }
  .pm-legend span:last-child { margin-left: 6px; }
  .pm-table {
    margin-top: 1.5rem;
    font: 400 12px/1.4 var(--mono);
  }
  .pm-table summary {
    cursor: pointer;
    width: max-content;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .pm-table-scroll {
    margin-top: 1rem;
    overflow-x: auto;
  }
  .pm-table table {
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }
  .pm-table :is(th, td) {
    padding: 5px 12px 5px 0;
    border-bottom: 1px solid var(--spec-grid);
    text-align: right;
    font-weight: 400;
  }
  .pm-table th[scope='row'] {
    text-align: left;
    white-space: nowrap;
  }
  @media (prefers-reduced-motion: reduce) {
    .pm-cell {
      opacity: 1;
      translate: 0 0;
      scale: 1;
      transition: none;
    }
    .pm-body:global(.is-visible) .pm-scan {
      animation: none;
    }
  }
</style>
