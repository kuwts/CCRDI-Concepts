---
// Theme demo page, not in brief/sitemap.md: noindex and out of the XML sitemap until the
// cleanup phase (brief/cleanup-list.md)
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import Button from '@/components/Button.astro';
import Faq from '@/components/Faq.astro';
import { animDelay } from '@/utils/animDelay';
import config from '@/config/site.config.json';

const pricing = await getEntry('pricing', 'index');
const { header, plans, faq } = pricing!.data;

const faqEntry = await getEntry('faq', 'index');
const groups = faqEntry!.data.groups;
---

<Base title="Pricing" seo={pricing!.data.seo} noindex>
  <PageHeader subtitle={header.subtitle} title={header.title} />

  <!-- Pricing plans -->
  <section class="bg-white text-dark py-20 md:py-25">
    <div class="container">
      <!-- Toggle -->
      <div class="flex justify-center mb-14">
        <div class="flex items-center gap-3 relative font-medium">
          <span id="toggle-label-monthly" class="text-sm font-semibold text-dark transition-colors duration-300">Monthly</span>
          <button
            id="pricing-toggle"
            type="button"
            role="switch"
            aria-checked="false"
            aria-label="Yearly billing"
            data-locale={config.locale.format}
            class="h-7 w-13 cursor-pointer rounded-full bg-dark transition-colors duration-300 after:absolute after:inset-0"
          >
            <strong class="relative inline-block h-full w-full">
              <span class="absolute top-1/2 left-1 h-5.5 w-5.5 -translate-y-1/2 rounded-full bg-white shadow-md transition-transform duration-300 ease-theme"></span>
            </strong>
          </button>
          <span id="toggle-label-yearly" class="text-sm text-dark/70 transition-colors duration-300">Yearly</span>
          <span class="rounded-full bg-dark/5 border border-dark/10 px-2.5 py-0.5 text-[13px] sm:text-[11px] font-semibold uppercase tracking-wider text-dark">Save 20%</span>
        </div>
      </div>

      <div class="row justify-center items-stretch">
        {
          plans.map((plan, i) => (
            <div
              class:list={[
                'xl:col-4 lg:col-5 md:col-6 has-anim fade flex',
                animDelay[i],
                i > 0 && 'mt-4 pt-2 md:mt-0 md:pt-0',
                i === 2 && 'xl:mt-0 xl:pt-0',
              ]}
            >
              <div
                class:list={[
                  'relative p-10 max-md:p-7.5 max-sm:p-5 w-full flex flex-col',
                  plan.featured ? 'bg-dark text-white' : 'border border-black/10',
                ]}
              >
                {
                  plan.featured && (
                    <span class="absolute -top-3 left-1/2 -translate-x-1/2 rounded-full bg-white px-4 py-1 text-[13px] sm:text-xs font-semibold uppercase tracking-wider text-dark shadow-lg">
                      Most Popular
                    </span>
                  )
                }

                <h2 class:list={['font-medium', !plan.featured && 'text-mutedDark']}>{plan.name}</h2>

                <div class="my-6">
                  <span
                    class:list={['pricing-price text-4xl font-bold inline-block', !plan.featured && 'text-dark']}
                    data-monthly={plan.price}
                    data-annual={plan.priceAnnual}
                  >
                    {plan.price}
                  </span>
                  <span
                    class="pricing-cadence text-sm inline-block"
                    data-monthly={plan.cadence}
                    data-annual={plan.cadenceAnnual}
                  >
                    {plan.cadence}
                  </span>
                </div>
                <Button
                  href={plan.cta.href}
                  label={plan.cta.label}
                  variant={plan.featured ? 'white' : 'black'}
                  block
                  class="mb-6"
                />

                <div class:list={['content grow', plan.featured && 'content-dark text-light']}>
                  <p>{plan.description}</p>
                  <h3 class="[font-size:inherit]!">{plan.feature_title}</h3>
                  <ul class="pricing-features-list">
                    {plan.features.map((f) => (
                      <li class="flex items-start gap-2.5">
                        <svg aria-hidden="true" class="shrink-0 mt-0.5 text-primary" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
                        <span>{f}</span>
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="bg-white pt-4 pb-20 md:pb-25">
    <div class="container">
      <div class="row justify-center mb-4">
        <div class="col-12">
          <SectionTitle subtitle={faq.subtitle} title={faq.title} class="has-anim fade" />
        </div>
      </div>
      <div class="row justify-center">
        <div class="lg:col-10">
          <Faq groups={groups} headingLevel="h3" />
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  // Prices count to the new value when both are numbers ("$3,500", "€49",
  // "9.99 kr"), keeping the content's symbol, decimals and separators. Anything
  // else ("Custom", "Free") is swapped as written. No count with reduced motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  const locale = document.getElementById('pricing-toggle')?.dataset.locale ?? 'en-US';

  interface Price {
    prefix: string;
    suffix: string;
    value: number;
    decimals: number;
    grouping: boolean;
  }

  function parsePrice(text: string): Price | null {
    const m = text.match(/^([^\d]*)([\d.,]+)(.*)$/);
    if (!m) return null;
    const value = parseFloat(m[2].replace(/,/g, ''));
    if (isNaN(value)) return null;
    return {
      prefix: m[1],
      suffix: m[3],
      value,
      decimals: m[2].split('.')[1]?.length || 0,
      grouping: m[2].includes(','),
    };
  }

  function animatePrice(el: HTMLElement, fromText: string, toText: string, duration: number): void {
    const from = parsePrice(fromText);
    const to = parsePrice(toText);
    if (!from || !to || reduceMotion) {
      el.textContent = toText;
      return;
    }
    const format = (n: number) =>
      to.prefix +
      n.toLocaleString(locale, {
        minimumFractionDigits: to.decimals,
        maximumFractionDigits: to.decimals,
        useGrouping: to.grouping,
      }) +
      to.suffix;
    const start = performance.now();
    const tick = (now: number) => {
      const p = Math.min((now - start) / duration, 1);
      const eased = p * (2 - p);
      el.textContent = p < 1 ? format(from.value + (to.value - from.value) * eased) : toText;
      if (p < 1) requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  }

  const toggle = document.getElementById('pricing-toggle');
  const knob = toggle?.querySelector('span');
  const labelMonthly = document.getElementById('toggle-label-monthly');
  const labelYearly = document.getElementById('toggle-label-yearly');
  const prices = document.querySelectorAll<HTMLElement>('.pricing-price');
  const cadences = document.querySelectorAll<HTMLElement>('.pricing-cadence');

  let isYearly = false;

  toggle?.addEventListener('click', () => {
    isYearly = !isYearly;
    toggle?.setAttribute('aria-checked', String(isYearly));

    if (knob) {
      knob.style.transform = isYearly ? 'translateX(1.375rem)' : 'translateX(0)';
    }

    if (labelMonthly) {
      labelMonthly.className = `text-sm font-medium transition-colors duration-300 ${isYearly ? 'text-dark/70 ' : 'text-dark font-semibold'}`;
    }
    if (labelYearly) {
      labelYearly.className = `text-sm font-medium transition-colors duration-300 ${isYearly ? 'text-dark font-semibold' : 'text-dark/70'}`;
    }

    cadences.forEach((el) => {
      el.textContent = isYearly ? (el.dataset.annual ?? '') : (el.dataset.monthly ?? '');
    });

    prices.forEach((el) => {
      const from = (isYearly ? el.dataset.monthly : el.dataset.annual) ?? '';
      const to = (isYearly ? el.dataset.annual : el.dataset.monthly) ?? '';
      animatePrice(el, from, to, 400);
    });
  });
</script>

<style>
  .pricing-features-list li::after {
    display: none !important;
  }
  .pricing-features-list li {
    padding-left: 0 !important;
  }
</style>
