---
import { getCollection, render } from 'astro:content';

import Base from '@/layouts/Base.astro';
import LineLink from '@/components/LineLink.astro';
import PortfolioCard from '@/components/PortfolioCard.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import { getProjects } from '@/lib/content';
import { animDelay } from '@/utils/animDelay';

export async function getStaticPaths() {
  const items = await getCollection('portfolio');
  return items.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const others = (await getProjects())
  .filter((p) => p.id !== entry.id)
  .slice(0, 3);
---

<Base title={data.title} image={data.carouselImage ?? data.image}>
  <section class="page-header pt-20 pb-16 text-muted">
    <div class="container -mt-1.5">
      <div class="row justify-center">
        <div class="lg:col-12 text-center">
          <p class="has-anim fade mb-5 font-medium">Case Study</p>
          <h1 class="text-3xl sm:text-4xl has-anim fade delay-100 font-medium text-white">
            {data.title}
          </h1>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero -->
  <div class="container">
    <div class="row">
      <div class="lg:col-11 -mb-12 has-anim delay-200 mx-auto">
        <AstroImage
          src={data.carouselImage ?? data.image}
          alt={data.title}
          class="h-auto max-h-130 w-full aspect-video object-contain bg-white/3"
        />
      </div>
    </div>
  </div>

  <section class="bg-white text-mutedDark py-20 md:py-25">
    <div class="container">
      <div class="row pt-5 justify-center">
        <!-- Sidebar -->
        <div class="lg:col-4 mt-1">
          <div class="mb-8 lg:mb-12 has-anim fade">
            <p class="text-lg font-medium text-black mb-4">{data.client.name}</p>
            <p class="mb-6">{data.client.description}</p>
            {
              data.client.website && (
                <LineLink
                  href={data.client.website}
                  label="Visit website"
                  tone="dark"
                  icon="arrow"
                  target="_blank"
                  class="font-medium before:bg-primary/70 text-sm"
                />
              )
            }
          </div>
          {data.otherInfo.map((info, i) => (
            <div class="mb-8 lg:mb-12 has-anim fade" style={`transition-delay: ${(i + 1) * 100}ms`}>
              <p class="text-lg font-medium text-black mb-3">{info.title}</p>
              <p>{info.content}</p>
            </div>
          ))}
          <div class="mb-8 lg:mb-12 has-anim fade" style={`transition-delay: ${(data.otherInfo.length + 1) * 100}ms`}>
            <p class="text-lg font-medium text-black mb-3">Services we provided</p>
            <ul class="space-y-1.5">
              {data.services.map((s) => <li>~ {s}</li>)}
            </ul>
          </div>
        </div>

        <!-- Body -->
        <div class="lg:col-7">
          <div
            class="content prose max-w-full pl-0 lg:pl-5 [&_img]:my-5 [&_p]:text-[18px] [&_p]:leading-relaxed"
          >
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- What's next -->
  <section class="bg-white pb-25 max-md:pb-20">
    <div class="container">
      <div class="row justify-between items-center">
        <div class="col-12 mb-10">
          <div class="border-t border-black/5 pt-25 pb-0 max-md:pt-20"></div>
          <p class="text-dark has-anim fade font-medium">What’s next?</p>
        </div>
        {
          others.map((p, i) => (
            <div
              class:list={[
                'lg:col-4 md:col-6 mb-5 md:mb-0',
                i === 2 && 'hidden lg:block',
              ]}
            >
              <PortfolioCard
                href={`/portfolio/${p.id}`}
                title={p.data.title}
                category={p.data.category}
                color={p.data.color}
                image={p.data.carouselImage ?? p.data.image}
                class:list={['has-anim fade', animDelay[i]]}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>
</Base>
