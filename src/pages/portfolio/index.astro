---
// Theme demo page, not in brief/sitemap.md: noindex and out of the XML sitemap until the
// cleanup phase (brief/cleanup-list.md)
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import PortfolioCard from '@/components/PortfolioCard.astro';
import LoadMore from '@/components/LoadMore.astro';
import { getProjects } from '@/lib/content';

const listing = (await getEntry('listings', 'portfolio'))!.data;
const projects = await getProjects();
const initial_load = 4;
---

<Base title="Portfolio" noindex>
  <PageHeader subtitle={listing.subtitle} title={listing.title} dot />

  <section class="bg-white py-20 md:py-25">
    <div class="container">
      <div class="row">
        <div class="lg:col-11 mx-auto">
          <div class="masonry relative" id="portfolio-grid" data-masonry>
            {
              projects.map((p, i) => (
                <div
                  class:list={['masonry-item mb-7.5 xl:mb-20 w-full', i >= initial_load && 'hidden']}
                  data-masonry-item
                  data-load-item
                >
                  <PortfolioCard
                    href={`/portfolio/${p.id}`}
                    title={p.data.title}
                    category={p.data.category}
                    color={p.data.color}
                    image={p.data.image}
                    as="h2"
                    class="has-anim"
                  />
                </div>
              ))
            }
          </div>
        </div>
      </div>

      <LoadMore target="portfolio-grid" total={projects.length} initial={initial_load} label={listing.load_more_label} />
    </div>
  </section>
</Base>

<script>
  // Two-column masonry, positioned by script. The "+" button (LoadMore) reveals
  // more items and fires `loadmore`, which re-runs the layout.
  const masonry = document.querySelector<HTMLElement>('[data-masonry]');
  if (masonry) {

  const all = Array.from(masonry.querySelectorAll<HTMLElement>('[data-masonry-item]'));

  const visible = () => all.filter((el) => !el.classList.contains('hidden'));

  const layout = () => {
    const items = visible();
    if (!items.length) return;
    const cols = window.innerWidth >= 768 ? 2 : 1;
    const gap = window.innerWidth >= 991 ? 100 : 50;
    const colW = (masonry.offsetWidth - gap * (cols - 1)) / cols;
    const heights = new Array(cols).fill(0);

    items.forEach((item) => {
      const ci = heights.indexOf(Math.min(...heights));
      item.style.position = 'absolute';
      item.style.width = `${colW}px`;
      item.style.left = `${ci * (colW + gap)}px`;
      item.style.top = `${heights[ci]}px`;
      heights[ci] += item.offsetHeight + gap;
    });

    masonry.style.height = `${Math.max(...heights)}px`;
  };

  masonry.addEventListener('loadmore', layout);
  window.addEventListener('resize', layout);
  new ResizeObserver(layout).observe(masonry);
  layout();

  masonry.querySelectorAll<HTMLImageElement>('img').forEach((img) => {
    if (img.complete) return;
    img.addEventListener('load', () => requestAnimationFrame(layout));
  });
  }
</script>