---
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import LineLink from '@/components/LineLink.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import BannerShape from '@/components/BannerShape.astro';
import Showreel from '@/components/Showreel.astro';
import BannerTestimonial from '@/components/BannerTestimonial.astro';
import PortfolioCarousel from '@/components/PortfolioCarousel.astro';
import WorkProcess from '@/components/WorkProcess.astro';
import StackedServices from '@/components/StackedServices.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import Clients from '@/components/Clients.astro';
import BlogCard from '@/components/BlogCard.astro';
import AnniversarySeal from '@/components/ccc/AnniversarySeal.astro';
import { animDelay } from '@/utils/animDelay';

// every section reads its copy (and placeholders) from the homepage entry
const home = await getEntry('homepage', 'index');
const { banner, intro, projects, process, testimonials, blog } = home!.data;

const [featuredPost, ...otherPosts] = blog.items.map((n) => ({ ...n, imageAlt: n.image_alt }));
const gridPosts = otherPosts.slice(0, 3);
---

<Base seo={home!.data.seo}>
  <!-- Banner -->
  <section class="relative">
    <div class="relative z-10 pt-20 lg:pt-25 pb-25 lg:pb-35 text-white">
      <div class="container text-center lg:text-left">
        <div class="row md:justify-center">
          <div class="xl:col-6 lg:col-7 md:col-10">
            <p class="mb-4 font-medium has-anim fade">{banner.subtitle}</p>
            <h1 class="mb-8 text-display has-anim fade delay-100">
              {banner.title}
            </h1>
            <div class="flex max-sm:flex-col items-center max-lg:justify-center gap-x-8 gap-y-5 sm:gap-x-10 has-anim fade delay-150">
              <Button href={banner.primary_cta.href} label={banner.primary_cta.label} target={banner.primary_cta.target} class="max-sm:w-full" />
              <LineLink
                href={banner.secondary_cta.href}
                label={banner.secondary_cta.label}
                tone="white"
                icon="arrow"
              />
            </div>
          </div>

          <div class="xl:col-4 lg:col-5 md:col-10 has-anim fade delay-100 mt-8 lg:mt-13">
            <p class="text-lead mb-8 has-anim fade delay-100">{banner.lead}</p>
            <BannerTestimonial class="has-anim fade delay-150" proof={banner.social_proof} />
          </div>
        </div>
      </div>
    </div>

    <!-- 40th anniversary seal: a stamp on the edge between the hero and the showreel,
         lined up with the hero's right column; only the seal itself takes clicks -->
    <div class="pointer-events-none relative z-20 container">
      <div class="row md:justify-center">
        <div class="col-12 md:col-10 lg:col-12 xl:col-10 flex h-0 items-start justify-end">
          <div class="-translate-y-1/2">
            <div class="has-anim pop">
              <AnniversarySeal
                href="/40-years"
                class="pointer-events-auto size-24 sm:size-32 lg:size-44 focus-visible:outline-none focus-visible:shadow-[0_0_0_4px_var(--color-dark),0_0_0_7px_var(--color-primary)] [&>svg]:drop-shadow-xl"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative z-10 -mb-12 has-anim fade">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <Showreel src={banner.video} sources={banner.video_sources} poster={banner.image} posterAlt={banner.image_alt} />
          </div>
        </div>
      </div>
    </div>

    <BannerShape />
  </section>

  <section class="bg-light py-section">
    <div class="container">
      <div class="row mt-12">

        <div class="lg:col-8">
          <div class="lg:grid grid-cols-12 sticky top-22">
            <div class="lg:col-span-3 max-lg:mb-4">
              <p class="text-eyebrow uppercase text-gold-text block lg:table-caption has-anim fade">
                {intro.section_title}
              </p>
            </div>
            
            <div class="lg:col-span-9 space-y-8">
              <div class="space-y-5">
                <h2 class="text-statement text-dark has-anim fade">
                  {intro.title}
                </h2>
                <p class="text-body text-text max-w-measure has-anim fade delay-100">
                  {intro.description}
                </p>
              </div>

              <div class="flex flex-col items-start gap-2.5 pt-2">
                {intro.info.map((item, i) => (
                  <p
                    class:list={['inline-block text-dark px-5 py-2 text-sm bg-white border border-dark/10 rounded-full has-anim', animDelay[i]]}
                  >
                    {item}
                  </p>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-4 max-lg:mt-16">
          <StackedServices services={intro.items.map((c) => ({ ...c, imageAlt: c.image_alt }))} />
        </div>

      </div>
    </div>
  </section>

  <!-- Family of brands carousel -->
  {projects.items.length > 0 && (
    <section class="bg-white py-section">
      <div class="container">
        <SectionTitle subtitle={projects.subtitle} title={projects.title} />
      </div>
      <PortfolioCarousel projects={projects.items.map((p) => ({ ...p, imageAlt: p.image_alt }))} />
    </section>
  )}

  <!-- Work process -->
  <WorkProcess subtitle={process.subtitle ?? ''} title={process.title} steps={process.steps} cta={process.cta} />

  <!-- Testimonials -->
  <section class="bg-light py-section">
    <div class="container">
      <SectionTitle
        subtitle={testimonials.subtitle ?? ''}
        title={testimonials.title ?? ''}
       
      />
    </div>
    <ReviewCarousel items={testimonials.items} testimonials={testimonials} />
    <Clients items={testimonials.logos} columnCount={5} class="mt-16" />
  </section>

  <!-- Blog (hidden when there are no posts) -->
  {featuredPost && (
    <section class="bg-white py-section">
      <div class="container">
        <SectionTitle subtitle={blog.subtitle} title={blog.title} />

        <div class="row">
          <div class="lg:col-12 has-anim">
            <BlogCard horizontal item={featuredPost} />
          </div>
          {
            gridPosts.map((post, i) => (
              <div class:list={['lg:col-4 md:col-6 has-anim', animDelay[i]]}>
                <BlogCard item={post} />
              </div>
            ))
          }
        </div>

        {blog.button && (
          <div class="mt-12 text-center has-anim fade delay-100">
            <LineLink href={blog.button.href} label={blog.button.label} tone="dark" icon="arrow" />
          </div>
        )}
      </div>
    </section>
  )}
</Base>
