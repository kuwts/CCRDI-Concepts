---
import { getEntry, getCollection } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import LineLink from '@/components/LineLink.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import BannerShape from '@/components/BannerShape.astro';
import Showreel from '@/components/Showreel.astro';
import BannerTestimonial from '@/components/BannerTestimonial.astro';
import PortfolioCarousel from '@/components/PortfolioCarousel.astro';
import WorkProcess from '@/components/WorkProcess.astro';
import StackedServices from '@/components/StackedServices.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import Clients from '@/components/Clients.astro';
import BlogCard from '@/components/BlogCard.astro';
import { getFeaturedProjects, getPosts } from '@/lib/content';
import { animDelay } from '@/utils/animDelay';

const home = await getEntry('homepage', 'index');
const { banner, intro, projects, process, testimonials, blog } = home!.data;

const servicesEntry = await getEntry('services', 'index');
const services = servicesEntry!.data.items.map((s) => ({ ...s }));

const featuredProjects = (await getFeaturedProjects()).map((p) => ({
  slug: p.id,
  ...p.data,
}));
const posts = await getPosts();
const featuredPost = posts.find((p) => p.data.featured) ?? posts[0];
const gridPosts = posts.filter((p) => p.id !== featuredPost.id).slice(0, 3);

const clientLogosDark = (await getCollection('clientsDark')).map((c) => c.data);
const reviews = (await getCollection('testimonials')).map((t) => t.data);
---

<Base>
  <!-- Banner -->
  <section class="relative">
    <div class="relative z-10 pt-20 lg:pt-25 pb-25 lg:pb-35 text-white">
      <div class="container text-center lg:text-left">
        <div class="row md:justify-center">
          <div class="xl:col-6 lg:col-7 md:col-10">
            <p class="mb-4 font-medium has-anim fade">{banner.subtitle}</p>
            <h1 class="mb-8 leading-tight font-medium text-3xl sm:text-5xl md:text-[56px] has-anim fade delay-100">
              {banner.title}<span class="text-primary">.</span>
            </h1>
            <div class="flex items-center max-lg:justify-center gap-x-8 sm:gap-x-10 has-anim fade delay-150">
              <Button href={banner.primary_cta.href} label={banner.primary_cta.label} />
              <LineLink
                href={banner.secondary_cta.href}
                label={banner.secondary_cta.label}
                tone="white"
                icon="arrow"
              />
            </div>
          </div>

          <div class="xl:col-4 lg:col-5 md:col-10 has-anim fade delay-100 mt-8 lg:mt-13">
            <p class="lg:text-xl mb-8 leading-relaxed max-lg:text-balance has-anim fade delay-100">{banner.lead}</p>
            <BannerTestimonial class="has-anim fade delay-150" proof={banner.social_proof} />
          </div>
        </div>
      </div>
    </div>

    <div class="relative z-10 -mb-12 has-anim fade">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <Showreel src={banner.video} poster={banner.image} />
          </div>
        </div>
      </div>
    </div>

    <BannerShape />
  </section>

  <section class="bg-gray-100 pt-20 md:pt-25">
    <div class="container">
      <div class="row mt-12">

        <div class="lg:col-8">
          <div class="lg:grid grid-cols-12 sticky top-22">
            <div class="lg:col-span-3 max-lg:mb-4">
              <p class="text-sm text-dark block lg:table-caption has-anim fade">
                {intro.section_title}
              </p>
            </div>
            
            <div class="lg:col-span-9 space-y-8">
              <div class="space-y-5">
                <h2 class="text-3xl md:text-4xl font-semibold tracking-tight text-black has-anim fade">
                  {intro.title}
                </h2>
                <p class="text-dark leading-relaxed max-w-xl text-balance has-anim fade delay-100">
                  {intro.description}
                </p>
              </div>

              <div class="flex flex-col items-start gap-2.5 pt-2">
                {intro.info.map((item, i) => (
                  <p
                    class="inline-block text-dark px-5 py-2 text-sm bg-white border border-dark/10 rounded-full has-anim"
                    style={`transition-delay: ${i * 75}ms`}
                  >
                    {item}
                  </p>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-4 max-lg:mt-16">
          <StackedServices services={services} />
        </div>

      </div>
    </div>
  </section>

  <!-- Selected projects carousel -->
  <section class="bg-gray-100 py-25 max-md:py-20">
    <div class="container">
      <SectionTitle subtitle={projects.subtitle} title={projects.title} />
    </div>
    <PortfolioCarousel projects={featuredProjects} />
  </section>

  <!-- Work process -->
  <WorkProcess subtitle={process.subtitle ?? ''} title={process.title} steps={process.steps} cta={process.cta} />

  <!-- Testimonials -->
  <section class="bg-gray-100 py-25 max-md:py-20">
    <div class="container">
      <SectionTitle
        subtitle={testimonials.subtitle ?? ''}
        title={testimonials.title ?? ''}
      />
    </div>
    <ReviewCarousel items={reviews} testimonials={testimonials} />
    <Clients items={clientLogosDark} columnCount={5} class="mt-16" />
  </section>

  <!-- Blog -->
  <section class="bg-white py-25 max-md:py-20">
    <div class="container">
      <SectionTitle subtitle={blog.subtitle} title={blog.title} />

      <div class="row">
        <div class="lg:col-12 has-anim">
          <BlogCard horizontal post={featuredPost} category="Featured" />
        </div>
        {
          gridPosts.map((post, i) => (
            <div class:list={['lg:col-4 md:col-6 has-anim', animDelay[i]]}>
              <BlogCard post={post} />
            </div>
          ))
        }
      </div>

      <div class="text-center">
        <Button href="/blog" label="View all posts" class="btn btn-dark mt-12 has-anim fade delay-100" />
      </div>
    </div>
  </section>
</Base>
