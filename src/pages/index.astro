---
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
import LineLink from '@/components/LineLink.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import BannerShape from '@/components/BannerShape.astro';
import Showreel from '@/components/Showreel.astro';
import BannerTestimonial from '@/components/BannerTestimonial.astro';
import PortfolioCarousel from '@/components/PortfolioCarousel.astro';
import WorkProcess from '@/components/WorkProcess.astro';
import StackedServices from '@/components/StackedServices.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import Clients from '@/components/Clients.astro';
import BlogCard from '@/components/BlogCard.astro';
import AnniversarySeal from '@/components/ccc/AnniversarySeal.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import AstroVideo from '@/components/helper/AstroVideo.astro';
import PauseButton from '@/components/PauseButton.astro';
import { animDelay } from '@/utils/animDelay';
import { getPressReleases } from '@/lib/content';

// every section reads its copy (and placeholders) from the homepage entry
const home = await getEntry('homepage', 'index');
const { banner, intro, projects, process, testimonials, blog } = home!.data;
const heroBg = banner.background;
const heroVideo = heroBg?.variant === 'video' && heroBg.video ? heroBg : null;

// press releases: the featured one large, then the three newest; each opens the release on its
// newswire in a new tab, with a decorative photo from the homepage content
const releases = await getPressReleases();
const lead = releases.find((r) => r.featured) ?? releases[0];
const cards = (lead ? [lead, ...releases.filter((r) => r !== lead).slice(0, 3)] : []).map((r, i) => ({
  title: r.title,
  description: r.summary,
  date: r.date,
  datetime: r.datetime,
  category: r.source,
  image: blog.images[i],
  imageAlt: '',
  href: r.url,
  external: true,
}));
const [featuredPost, ...gridPosts] = cards;
---

<Base seo={home!.data.seo}>
  <!-- Banner -->
  <section class="relative">
    <div class="relative z-10 isolate pt-24 lg:pt-36 pb-32 lg:pb-48 text-white" data-hero>
      {/* decorative imagery behind the hero text, under a navy overlay (version A: photo,
          version B: muted looping video; brief/ui-proposal.md) */}
      {heroBg && (
        <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
          {heroVideo ? (
            <AstroVideo
              src={heroVideo.video}
              poster={heroVideo.poster}
              posterWidth={1600}
              muted
              loop
              playsinline
              preload="none"
              class="absolute inset-0 h-full w-full object-cover"
              data-hero-video
            />
          ) : (
            <AstroImage
              src={heroBg.image}
              alt=""
              loading="eager"
              widths={[800, 1200, 1600, 2400]}
              sizes="100vw"
              class="absolute inset-0 h-full w-full object-cover object-[50%_40%]"
            />
          )}
          {/* the video's daytime sky is much brighter than the conference photo, so it needs a stronger overlay */}
          <div class:list={['absolute inset-0 hero-scrim', heroVideo && '[--scrim-left:82%] [--scrim-mid:74%] [--scrim-right:68%] [--scrim-small:78%]']}></div>
          <div class="absolute inset-x-0 bottom-0 h-px bg-hairline-dark"></div>
        </div>
      )}
      <div class="container text-center lg:text-left">
        <div class="row md:justify-center">
          <div class="xl:col-6 lg:col-7 md:col-10">
            <p class="mb-4 font-medium has-anim fade">{banner.subtitle}</p>
            <h1 class="mb-8 text-display has-anim fade delay-100">
              {banner.title}
            </h1>
            <div class="flex max-sm:flex-col items-center max-lg:justify-center gap-x-8 gap-y-5 sm:gap-x-10 has-anim fade delay-150">
              <Button href={banner.primary_cta.href} label={banner.primary_cta.label} target={banner.primary_cta.target} class="max-sm:w-full" />
              <LineLink
                href={banner.secondary_cta.href}
                label={banner.secondary_cta.label}
                tone="white"
                icon="arrow"
              />
            </div>
          </div>

          <div class="xl:col-4 lg:col-5 md:col-10 has-anim fade delay-100 mt-8 lg:mt-13">
            <p class="text-lead mb-8 has-anim fade delay-100">{banner.lead}</p>
            <BannerTestimonial class="has-anim fade delay-150" proof={banner.social_proof} />
          </div>
        </div>
      </div>
      {heroVideo && <PauseButton label="background video" class="bottom-4 left-4" />}
    </div>

    <!-- 40th anniversary seal: a stamp on the edge between the hero and the showreel,
         lined up with the hero's right column; only the seal itself takes clicks -->
    <div class="pointer-events-none relative z-20 container">
      <div class="row md:justify-center">
        <div class="col-12 md:col-10 lg:col-12 xl:col-10 flex h-0 items-start justify-end">
          <div class="-translate-y-1/2">
            <div class="has-anim pop">
              <AnniversarySeal
                href="/40-years"
                class="pointer-events-auto size-24 sm:size-32 lg:size-44 focus-visible:outline-none focus-visible:shadow-[0_0_0_4px_var(--color-dark),0_0_0_7px_var(--color-primary)] [&>svg]:drop-shadow-xl"
              />
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="relative z-10 -mb-12 pt-16 lg:pt-28 has-anim fade">
      <div class="container">
        <div class="row">
          <div class="col-12">
            <Showreel src={banner.video} sources={banner.video_sources} poster={banner.image} posterAlt={banner.image_alt} />
          </div>
        </div>
      </div>
    </div>

    <BannerShape />
  </section>

  <section class="bg-light py-section">
    <div class="container">
      <div class="row mt-12">

        <div class="lg:col-8">
          <div class="lg:grid grid-cols-12 sticky top-22">
            <div class="lg:col-span-3 max-lg:mb-4">
              <p class="text-eyebrow uppercase text-gold-text block lg:table-caption has-anim fade">
                {intro.section_title}
              </p>
            </div>
            
            <div class="lg:col-span-9 space-y-8">
              <div class="space-y-8 lg:space-y-10">
                <h2 class="pull-quote text-dark has-anim fade">
                  {intro.title}
                </h2>
                <p class="text-body text-text max-w-measure has-anim fade delay-100">
                  {intro.description}
                </p>
              </div>

              <div class="flex flex-col items-start gap-2.5 pt-2">
                {intro.info.map((item, i) => (
                  <p
                    class:list={['inline-block text-dark px-5 py-2 text-sm bg-white border border-dark/10 rounded-full has-anim', animDelay[i]]}
                  >
                    {item}
                  </p>
                ))}
              </div>
            </div>
          </div>
        </div>

        <div class="lg:col-4 max-lg:mt-16">
          <StackedServices services={intro.items.map((c) => ({ ...c, imageAlt: c.image_alt }))} />
        </div>

      </div>
    </div>
  </section>

  <!-- Family of brands carousel -->
  {projects.items.length > 0 && (
    <section class="hairline-top bg-white py-section">
      <div class="container">
        <SectionTitle subtitle={projects.subtitle} title={projects.title} />
      </div>
      <PortfolioCarousel projects={projects.items.map((p) => ({ ...p, imageAlt: p.image_alt }))} />
    </section>
  )}

  <!-- Work process -->
  <WorkProcess subtitle={process.subtitle ?? ''} title={process.title} steps={process.steps} cta={process.cta} />

  <!-- Testimonials -->
  <section class="bg-light py-section">
    <div class="container">
      <SectionTitle
        subtitle={testimonials.subtitle ?? ''}
        title={testimonials.title ?? ''}
       
       
      />
    </div>
    <ReviewCarousel items={testimonials.items} testimonials={testimonials} />
    <Clients items={testimonials.logos} columnCount={5} class="mt-16" />
  </section>

  <!-- Blog (hidden when there are no posts) -->
  {featuredPost && (
    <section class="hairline-top bg-white py-section">
      <div class="container">
        <SectionTitle subtitle={blog.subtitle} title={blog.title} />

        <div class="row">
          <div class="lg:col-12 has-anim">
            <BlogCard horizontal item={featuredPost} />
          </div>
          {
            gridPosts.map((post, i) => (
              <div class:list={['lg:col-4 md:col-6 has-anim', animDelay[i]]}>
                <BlogCard item={post} />
              </div>
            ))
          }
        </div>

        {blog.button && (
          <div class="mt-12 text-center has-anim fade delay-100">
            <LineLink href={blog.button.href} label={blog.button.label} tone="dark" icon="arrow" />
          </div>
        )}
      </div>
    </section>
  )}
</Base>

<script>
  // Hero background video (version B): the poster shows first; the video plays only
  // while the hero is on screen, the tab is visible and it isn't paused, and never
  // with reduced motion (poster only, so the pause button is removed).
  const heroVideo = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  if (heroVideo) {
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const pauseBtn = heroVideo.closest('[data-hero]')?.querySelector<HTMLButtonElement>(':scope > [data-pause-toggle]');
    if (reduceMotion) {
      pauseBtn?.remove();
    } else {
      let inView = false;
      let paused = false;
      const sync = () => {
        if (inView && !paused && !document.hidden) {
          if (heroVideo.paused) heroVideo.play().catch(() => {});
        } else if (!heroVideo.paused) {
          heroVideo.pause();
        }
      };
      new IntersectionObserver(([e]) => {
        inView = e.isIntersecting;
        sync();
      }).observe(heroVideo);
      document.addEventListener('visibilitychange', sync);
      pauseBtn?.addEventListener('click', () => {
        paused = !paused;
        pauseBtn.setAttribute('aria-pressed', String(paused));
        pauseBtn.textContent = `${paused ? 'Play' : 'Pause'} background video`;
        sync();
      });
    }
  }
</script>
