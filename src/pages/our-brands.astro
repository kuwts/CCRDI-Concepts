---
import { getEntry } from 'astro:content';
import { Icon } from 'astro-icon/components';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import SectionTitle from "@/components/SectionTitle.astro";
import Clients from "@/components/Clients.astro";
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import Facts from '@/components/Facts.astro';
import LineLink from '@/components/LineLink.astro';

// Our Brands: the theme's Services page, with its own content (src/content/brands)
const home = await getEntry('homepage', 'index');
const { testimonials } = home!.data;

const brandsEntry = await getEntry('brands', 'index');
const { header, clients, facts, items } = brandsEntry!.data;

const clientLogos = clients.logos ?? [];
const reviews = testimonials.items;
---

<Base title="Our Brands" seo={brandsEntry!.data.seo}>
  <PageHeader
    subtitle={header.subtitle}
    title={header.title}
    align="center"
    colClass="text-balance [&_h1]:leading-relaxed!"
  />

  <!-- Intro -->
  <section class="pb-section -mt-24 sm:-mt-28">
    <div class="container">
      <SectionTitle subtitle={clients.subtitle ?? ''} background="dark" class="pt-20 sm:pt-24" />
      <Clients items={clientLogos} columnCount={4} logoHeight={88} tiles class="mt-16" />
    </div>
  </section>
  
  <!-- Facts -->
  <Facts facts={facts} />

  <section class="hairline-top bg-white py-section">
    <div class="container">
      <div class="row">
        <div class="lg:col-11 mx-auto -mb-10">
          <div
            class="flex flex-col gap-2"
            data-stacked-deck
            data-stacked-drama
            style={{
              '--numcards': items.length,
              '--stacked-top-offset': '0px',
            }}
          >
            {
              items.map((item, i) => {
                const cardIndex = i + 1;
                const flip = i % 2 === 1;
                const external = /^https?:\/\//.test(item.link.href);
                // the brand's logo for dark backgrounds, in its own column (decorative: the panel's
                // heading names the brand right beside it); a Lucide icon if there's no logo
                const mark = item.logo ? (
                  <AstroImage
                    src={item.logo.src}
                    alt=""
                    height={320}
                    class="h-24 sm:h-28 lg:h-auto lg:max-h-40 w-auto max-w-[70%] lg:max-w-full object-contain"
                  />
                ) : (
                  <Icon name={item.icon} class="size-14 text-primary" aria-hidden="true" />
                );
                const content = (
                  <div>
                    {/* the brand's tagline (§9), above its name */}
                    <p class="mb-3 text-eyebrow uppercase text-primary">{item.tagline}</p>
                    <h2 class="mb-5 text-h2 text-white break-words">{item.title}</h2>
                    <div class="lg:max-w-xl">
                      <div class="mb-7 space-y-3 text-white/85">
                        {item.info.map((p) => <p class="text-balance">{p}</p>)}
                      </div>
                      <ul class="grid grid-cols-2 gap-x-4 gap-y-2.5 font-medium text-sm text-white">
                        {item.sub_services.map((li) => <li>{li}</li>)}
                      </ul>
                      {item.accent ? (
                        <span class="my-6 block h-0.5 w-12 rounded-full" style={{ background: item.accent }} aria-hidden="true"></span>
                      ) : (
                        <span class="my-6 block h-0.5 w-12 rounded-full bg-primary" aria-hidden="true"></span>
                      )}
                      <div class="space-y-3 text-white/85">
                        {item.meta.map((p) => <p>{p}</p>)}
                      </div>
                      <LineLink
                        href={item.link.href}
                        label={item.link.label}
                        tone="white"
                        icon="arrow"
                        target={external ? '_blank' : undefined}
                        class="mt-7"
                      />
                    </div>
                  </div>
                );
                return (
                  <div
                    data-stacked-card
                    class="lg:sticky top-10 mb-10"
                    style={{
                      '--index': cardIndex,
                      zIndex: cardIndex,
                      paddingTop: `calc(${cardIndex} * var(--stacked-top-offset))`,
                    }}
                  >
                    {/* the brand's photo under a navy overlay (strongest behind the text), an inset
                        edge in the brand's colours, the logo in its own column */}
                    <div
                      data-stacked-content
                      class="group relative min-h-0 origin-[50%_0%] overflow-hidden rounded-card bg-dark text-white"
                      style={`--edge:${item.edge ?? 'var(--edge-award)'}; --edge-inset: 14px`}
                    >
                      <AstroImage
                        src={item.image}
                        alt=""
                        loading="lazy"
                        widths={[800, 1200, 1600]}
                        sizes="(min-width: 1024px) 85vw, 100vw"
                        class="absolute inset-0 size-full object-cover"
                      />
                      <span
                        class:list={[
                          'absolute inset-0 bg-dark/85',
                          flip ? 'lg:bg-linear-to-r' : 'lg:bg-linear-to-l',
                          'lg:bg-transparent lg:from-dark/93 lg:via-dark/88 lg:to-dark/62',
                        ]}
                        aria-hidden="true"
                      ></span>
                      <span class="edge-ring" aria-hidden="true"></span>
                      <div class="relative row items-center gap-y-10 px-6 py-14 sm:px-12 sm:py-16 lg:px-16 lg:py-20">
                        <div class:list={['lg:col-4 flex justify-center', flip && 'lg:order-2']}>{mark}</div>
                        <div class:list={['lg:col-8', flip && 'lg:order-1']}>{content}</div>
                      </div>
                    </div>
                  </div>
                );
              })
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reviews + clients -->
  <section class="hairline-top bg-light py-section">
    <div class="container">
      <SectionTitle
        subtitle={testimonials.subtitle ?? ''}
        title={testimonials.title ?? ''}
      />
    </div>
    <ReviewCarousel items={reviews} testimonials={testimonials} />
  </section>
</Base>

<script>
  document.querySelectorAll<HTMLElement>("[data-stacked-deck]").forEach((deck) => {
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;

    const cards = Array.from(
      deck.querySelectorAll<HTMLElement>("[data-stacked-card]")
    );

    const contents = Array.from(
      deck.querySelectorAll<HTMLElement>("[data-stacked-content]")
    );

    const START_AT = 0.6;
    const END_SCALE = 0.9;

    let frame = 0;

    const clamp = (value: number, min: number, max: number): number =>
      Math.min(max, Math.max(min, value));

    const easeOutCubic = (t: number): number =>
      1 - Math.pow(1 - t, 3);

    const update = (): void => {
      frame = 0;

      if (window.matchMedia("(max-width: 1023px)").matches) {
        contents.forEach((content) => {
          if (content) content.style.transform = "";
        });
        return;
      }

      const viewportHeight = window.innerHeight;
      const startY = viewportHeight * START_AT;

      cards.forEach((card, i) => {
        const content = contents[i];
        const nextCard = cards[i + 1];

        if (!content) return;

        if (!nextCard) {
          content.style.transform = "";
          return;
        }

        const nextRect = nextCard.getBoundingClientRect();

        // Sticky top value (e.g. Tailwind's top-10 = 40px)
        const stickyTop = Number.parseFloat(getComputedStyle(card).top) || 0;

        let progress =
          (startY - nextRect.top) / (startY - stickyTop);

        progress = clamp(progress, 0, 1);
        progress = easeOutCubic(progress);

        const scale = 1 - (1 - END_SCALE) * progress;

        if (progress <= 0) {
          content.style.transform = "";
        } else {
          content.style.transform = `scale(${scale})`;
        }
      });
    };

    const onScroll = (): void => {
      if (!frame) {
        frame = window.requestAnimationFrame(update);
      }
    };

    update();

    window.addEventListener("scroll", onScroll, { passive: true });
    window.addEventListener("resize", onScroll);
  });
</script>