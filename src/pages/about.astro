---
import { getEntry, getCollection } from 'astro:content';

import Base from '@/layouts/Base.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import Button from '@/components/Button.astro';
import TeamGroupCarousel from '@/components/TeamGroupCarousel.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import Clients from '@/components/Clients.astro';
import Facts from '@/components/Facts.astro';
import TeamGrid from '@/components/TeamGrid.astro';

const home = await getEntry('homepage', 'index');
const { testimonials } = home!.data;

const about = await getEntry('about', 'index');
const { header, clients, facts, team_group, team } = about!.data;

// page content first; the shared collections only when the page doesn't set its own
const clientLogos = clients.logos ?? (await getCollection('clients')).map((c) => c.data);
const reviews = testimonials.items;
const members = team.members ?? (await getCollection('teamMembers')).map((m) => m.data);
---

<Base title="About" seo={about!.data.seo}>
  <PageHeader subtitle={header.subtitle} title={header.title} colClass="max-sm:[&_br]:hidden lg:col-10" />

  <!-- Intro -->
  <section class="pb-section">
    <div class="container">
      <div class="has-anim">
        <AstroImage
          src={header.image}
          alt={header.image_alt}
          width={1672}
          height={818}
          class="h-auto max-w-full w-full bg-white/3"
        />
      </div>

      <SectionTitle subtitle={clients.subtitle ?? ''} background="dark" class="pt-20 sm:pt-24" />
      <Clients items={clientLogos} columnCount={5} class="mt-16" />
    </div>
  </section>
  
  <!-- Facts -->
  <Facts facts={facts} quote />

  <!-- Team group carousel -->
  <section class="bg-white py-section overflow-hidden">
    <TeamGroupCarousel images={team_group.images} />
  </section>

  <!-- Reviews + clients -->
  <section class="hairline-top bg-light py-section">
    <div class="container">
      <SectionTitle
        subtitle={testimonials.subtitle ?? ''}
        title={testimonials.title ?? ''}
      />
    </div>
    <ReviewCarousel items={reviews} testimonials={testimonials} />
  </section>

  <!-- Team grid -->
  <section class="hairline-top bg-white py-section">
    <div class="container">
      <div class="row justify-center">
        <div class="col-12 has-anim fade">
          <SectionTitle
            subtitle={team.subtitle}
            title={team.title}
            marginClass="mb-4"
          />
        </div>
      </div>
      <div class="row">
        <TeamGrid members={members} />
        <div class="col-12 mt-16 has-anim fade text-center">
          <Button href={team.cta.href} label={team.cta.label} variant="black" />
        </div>
      </div>
    </div>
  </section>
</Base>
