---
import { getEntry, getCollection } from 'astro:content';
import { animDelay } from '@/utils/animDelay';
import { markdownify } from "@/utils/textConverter";

import Base from '@/layouts/Base.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import PageHeader from '@/components/PageHeader.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import Button from '@/components/Button.astro';
import TeamGroupCarousel from '@/components/TeamGroupCarousel.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import Clients from '@/components/Clients.astro';
import Facts from '@/components/Facts.astro';

const home = await getEntry('homepage', 'index');
const { testimonials } = home!.data;

const about = await getEntry('about', 'index');
const { header, clients, facts, team_group, team } = about!.data;

const clientLogos = (await getCollection('clients')).map((c) => c.data);
const reviews = (await getCollection('testimonials')).map((t) => t.data);
const members = (await getCollection('teamMembers')).map((m) => m.data);
---

<Base title="About">
  <PageHeader subtitle={header.subtitle} title={header.title} colClass="max-sm:[&_br]:hidden lg:col-10" />

  <!-- Intro -->
  <section class="pb-20 md:pb-25">
    <div class="container">
      <div class="has-anim">
        <AstroImage
          src={header.image}
          alt="about"
          width={1672}
          height={818}
          class="h-auto max-w-full w-full bg-white/3"
        />
      </div>

      <SectionTitle subtitle={clients.subtitle ?? ''} background="dark" class="pt-20 sm:pt-24" />
      <Clients items={clientLogos} columnCount={5} class="mt-16" />
    </div>
  </section>
  
  <!-- Facts -->
  <Facts facts={facts} />

  <!-- Team group carousel -->
  <section class="bg-white py-20 md:py-25 overflow-hidden">
    <TeamGroupCarousel images={team_group.images} />
  </section>

  <!-- Reviews + clients -->
  <section class="bg-light py-20 md:py-25">
    <div class="container">
      <SectionTitle
        subtitle={testimonials.subtitle ?? ''}
        title={testimonials.title ?? ''}
      />
    </div>
    <ReviewCarousel items={reviews} testimonials={testimonials} />
  </section>

  <!-- Team grid -->
  <section class="bg-white py-20 md:py-25">
    <div class="container">
      <div class="row justify-center">
        <div class="col-12 has-anim fade">
          <SectionTitle
            subtitle={team.subtitle}
            title={team.title}
            marginClass="mb-4"
          />
        </div>
      </div>
      <div class="row">
        {
          members.map((m, i) => (
            <div class="xl:col-3 lg:col-4 col-6">
              <div class:list={['has-anim fade mt-8.75', animDelay[i % 4]]}>
                <div class="relative overflow-hidden">
                  <AstroImage src={m.image} alt={m.name} loading="lazy" class="h-auto max-w-full bg-gray-100" />
                </div>
                <div class="mt-5">
                  <h4 class="text-dark text-xl font-semibold">{m.name}</h4>
                  <p class="mt-1 text-dark/50">{m.role}</p>
                </div>
              </div>
            </div>
          ))
        }
        <div class="col-12 mt-16 has-anim fade text-center">
          <Button href={team.cta.href} label={team.cta.label} variant="black" />
        </div>
      </div>
    </div>
  </section>
</Base>
