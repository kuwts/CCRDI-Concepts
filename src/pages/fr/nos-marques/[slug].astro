---
// Brand pages, in French (/fr/nos-marques/[slug]): the English brand page's template with the
// French entries (src/content/brand-pages/fr/, named like the English ones); the French URL
// slugs come from src/i18n/routes.json.
import { getCollection } from 'astro:content';
import BrandPage from '../../our-brands/[slug].astro';
import { frSlug } from '@/i18n';

export async function getStaticPaths() {
  const entries = await getCollection('brandPages', (e) => e.id.startsWith('fr/'));
  return entries.map((entry) => {
    const slug = frSlug(`/our-brands/${entry.id.slice(3)}`);
    if (!slug) throw new Error(`No French URL for brand page ${entry.id} (src/i18n/routes.json)`);
    return { params: { slug }, props: { entry } };
  });
}

const { entry } = Astro.props;
---

<BrandPage entry={entry} />
