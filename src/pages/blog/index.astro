---
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import BlogCard from '@/components/BlogCard.astro';
import LoadMore from '@/components/LoadMore.astro';
import { getPosts } from '@/lib/content';
import { animDelay } from '@/utils/animDelay';

const listing = (await getEntry('listings', 'blog'))!.data;
const posts = await getPosts();
const initial = 4;
---

<Base title="Blog">
  <PageHeader subtitle={listing.subtitle} title={listing.title} dot />

  <section class="bg-white py-20 md:py-25">
    <div class="container -mt-7.5">
      <div class="row">
        <div class="lg:col-11 mx-auto">
          <div class="row" id="blog-grid">
            {
              posts.map((post, i) => (
                <div
                  data-load-item
                  class:list={[
                    i === 0 ? 'col-12' : 'lg:col-4 md:col-6',
                    'has-anim',
                    'fade',
                    animDelay[i % 3],
                    i >= initial && 'hidden',
                  ]}
                >
                  <BlogCard horizontal={i === 0} post={post} as="h2" />
                </div>
              ))
            }
          </div>

          <LoadMore target="blog-grid" total={posts.length} initial={initial} label={listing.load_more_label} class="mt-16" />
        </div>
      </div>
    </div>
  </section>
</Base>
