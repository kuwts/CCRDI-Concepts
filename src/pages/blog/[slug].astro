---
import { render } from 'astro:content';

import Base from '@/layouts/Base.astro';
import BlogCard from '@/components/BlogCard.astro';
import { formatDate } from '@/utils/formatDate';
import { getPosts } from '@/lib/content';
import { animDelay } from '@/utils/animDelay';
import AstroImage from "@/components/helper/AstroImage.astro";

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

const related = (await getPosts()).filter((p) => p.id !== entry.id).slice(0, 3);

const tocItems = [...(entry.body ?? '').matchAll(/^(#{2,3})\s+(.+)$/gm)].map(([, hashes, text]) => ({
  level: hashes.length,
  id: text.toLowerCase().replace(/\s+/g, '-').replace(/[^\w-]/g, ''),
  text,
}));
---

<Base title={data.title} description={data.description} image={data.image} seo={data.seo} type="article">
  <section class="page-header pt-20 pb-16 text-muted">
    <div class="container -mt-1.5">
      <div class="row justify-center">
        <div class="lg:col-10 text-center">
          <p class="has-anim fade mb-5 text-sm">
            {data.category} <span class="mx-2 inline-block" aria-hidden="true">━</span> {formatDate(data.date)}
          </p>
          <h1 class="text-3xl sm:text-4xl has-anim fade delay-100 font-medium text-white leading-snug text-balance">
            {data.title}
          </h1>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero -->
  <div class="container">
    <div class="row">
      <div class="col-12 -mb-12 has-anim delay-200">
        <AstroImage
          src={data.image}
          alt=""
          loading="eager"
          class="h-auto w-full bg-white/3"
        />
      </div>
    </div>
  </div>

  <section class="bg-white py-20 md:py-25">
    <div class="container">
      <div class="row justify-center pt-5">
        {/* table of contents: only when the post has ## / ### headings */}
        {tocItems.length > 0 && (
        <nav class="lg:col-3 order-0 lg:order-1" aria-labelledby="toc-toggle">
          <div class="max-lg:mb-10 sticky top-24">
            <button
              id="toc-toggle"
              type="button"
              class="flex items-center justify-between w-full mb-5 text-dark lg:text-dark/70 max-lg:cursor-pointer lg:cursor-default max-lg:border max-lg:border-dashed max-lg:border-dark/10 max-lg:p-3"
              aria-expanded="false"
              aria-controls="toc-list"
            >
              <span>Table of Contents</span>
              <svg class="w-4 h-4 lg:hidden transition-transform" data-arrow viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 9 6 6 6-6" />
              </svg>
            </button>
            <!-- links are blocks with py-1 (a 26px+ tap target); no list gap keeps the old rhythm -->
            <ul class="max-h-0 lg:max-h-[55dvh] overflow-hidden transition-all duration-300 ease-theme lg:overflow-y-auto max-lg:ps-10" id="toc-list">
              {tocItems.map((item) => (
                <li>
                  <a
                    href={`#${item.id}`}
                    class:list={[
                      'block py-1 text-dark/80 hover:text-black transition-colors text-sm font-medium',
                      item.level === 3 && 'pl-4 text-[13px]',
                      '[&.active]:text-primary [&.active]:font-semibold',
                    ]}
                  >
                    {item.text}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </nav>
        )}
        <div class="lg:col-8 order-1 lg:order-0">
          <div class="content prose max-w-full text-dark pr-0 lg:pr-10 break-words [&>p:first-of-type]:text-[22px] [&>p:first-of-type]:leading-relaxed [&_img]:my-6">
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Related (hidden when there are no other posts) -->
  {related.length > 0 && (
  <section class="bg-white pb-20 md:pb-25">
    <div class="container">
      <div class="row">
        <div class="col-12 mb-4">
          <div class="border-t border-black/5 pt-25 max-md:pt-20"></div>
          <h2 class="text-dark has-anim fade font-medium">Related Posts</h2>
        </div>
        {
          related.map((post, i) => (
            <div
              class:list={[
                'lg:col-4 md:col-6',
                i === 2 && 'hidden lg:block',
              ]}
            >
              <BlogCard
                post={post}
                class:list={['has-anim fade', animDelay[i]]}
              />
            </div>
          ))
        }
      </div>
    </div>
  </section>
  )}

</Base>

<script>
  const tocToggle = document.getElementById('toc-toggle');
  const tocList = document.getElementById('toc-list');

  // Below lg the list collapses behind the toggle (inert while closed); from lg
  // it's always open and the toggle is just its label.
  const desktop = window.matchMedia('(min-width: 1024px)');
  const syncToc = () => {
    if (!tocToggle || !tocList) return;
    const open = desktop.matches || tocToggle.getAttribute('aria-expanded') === 'true';
    if (desktop.matches) tocList.style.removeProperty('max-height');
    else tocList.style.maxHeight = open ? tocList.scrollHeight + 'px' : '0';
    tocList.inert = !open;
    tocToggle.toggleAttribute('aria-disabled', desktop.matches);
  };

  if (tocToggle && tocList) {
    syncToc();
    tocToggle.addEventListener('click', () => {
      if (desktop.matches) return;
      const expanded = tocToggle.getAttribute('aria-expanded') === 'true';
      tocToggle.setAttribute('aria-expanded', String(!expanded));
      tocToggle.querySelector('[data-arrow]')?.classList.toggle('rotate-180', !expanded);
      syncToc();
    });
    desktop.addEventListener('change', syncToc);
  }

  const tocLinks = document.querySelectorAll<HTMLAnchorElement>('#toc-list a');
  const headings = [...document.querySelectorAll('.content h2, .content h3')];
  if (tocLinks.length && headings.length) {
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            tocLinks.forEach((l) => l.classList.toggle('active', l.getAttribute('href') === `#${entry.target.id}`));
          }
        }
      },
      { rootMargin: '-80px 0px -60% 0px' },
    );
    headings.forEach((h) => observer.observe(h));
  }
</script>
