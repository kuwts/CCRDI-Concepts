---
// Brand pages (/our-brands/[slug]): the theme's case-study page (portfolio/[slug].astro), the
// same layout as 40 Years, content in src/content/brand-pages. Each page uses its division
// colour as the accent: a rule under the H1, the sidebar list markers and the link underline
// (decorative only; text stays white or dark for contrast).
import { getCollection, getEntry, render } from 'astro:content';

import Base from '@/layouts/Base.astro';
import LineLink from '@/components/LineLink.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import PortfolioCarousel from '@/components/PortfolioCarousel.astro';
import AstroImage from '@/components/helper/AstroImage.astro';
import WorkProcess from '@/components/WorkProcess.astro';
import StackedServices from '@/components/StackedServices.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import { animDelay } from '@/utils/animDelay';

export async function getStaticPaths() {
  const entries = await getCollection('brandPages');
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

// the homepage brand slider (one source for each brand's photo, colour and link)
const home = await getEntry('homepage', 'index');
const brands = home!.data.projects.items.map((p) => ({ ...p, imageAlt: p.image_alt }));
// testimonials: the homepage placeholders, until the client supplies real ones
const testimonials = data.testimonials ? home!.data.testimonials : undefined;
const { process, stack } = data;
const external = (href: string) => /^https?:\/\//.test(href);
---

<Base title={data.title} image={data.image} seo={data.seo}>
  <section class="page-header pt-20 pb-16 text-muted" style={{ '--accent': data.accent }}>
    <div class="container -mt-1.5">
      <div class="row justify-center">
        <div class="lg:col-12 text-center">
          <p class="has-anim fade mb-5 font-medium">{data.eyebrow}</p>
          <h1 class="text-h1 has-anim fade delay-100 text-white break-words">
            {data.title}
          </h1>
          <span class="mx-auto mt-6 block h-1 w-16 rounded-full bg-(--accent) has-anim fade delay-150" aria-hidden="true"></span>
        </div>
      </div>
    </div>
  </section>

  <!-- Hero -->
  <div class="container">
    <div class="row">
      <div class="lg:col-11 -mb-12 has-anim delay-200 mx-auto">
        <AstroImage
          src={data.image}
          alt={data.image_alt}
          loading="eager"
          class="h-auto max-h-130 w-full aspect-video object-cover bg-white/3"
        />
      </div>
    </div>
  </div>

  <section class="bg-white text-mutedDark py-section" style={{ '--accent': data.accent }}>
    <div class="container">
      <div class="row pt-5 justify-center">
        <!-- Sidebar -->
        <div class="lg:col-4 mt-1">
          <div class="mb-8 lg:mb-12 has-anim fade">
            {data.logo && (
              <AstroImage src={data.logo.src} alt={data.logo.alt} height={120} class="mb-8 h-30 w-auto" />
            )}
            <p class="text-lg font-medium text-black mb-4">{data.sidebar.name}</p>
            <p class="mb-6">{data.sidebar.description}</p>
            {data.sidebar.list.length > 0 && (
              <ul class="mb-6 space-y-1.5">
                {data.sidebar.list.map((s) => <li><span class="text-(--accent)" aria-hidden="true">~ </span>{s}</li>)}
              </ul>
            )}
            {/* the underline takes the division colour */}
            <LineLink
              href={data.sidebar.link.href}
              label={data.sidebar.link.label}
              tone="dark"
              icon="arrow"
              target={external(data.sidebar.link.href) ? '_blank' : undefined}
              class="font-medium text-sm [--color-primary:var(--accent)]"
            />
          </div>
          {data.facts.map((info, i) => (
            <div class="mb-8 lg:mb-12 has-anim fade" style={`transition-delay: ${(i + 1) * 100}ms`}>
              <p class="text-lg font-medium text-black mb-3">{info.title}</p>
              <p>{info.content}</p>
            </div>
          ))}
        </div>

        <!-- Body -->
        <div class="lg:col-7">
          <div
            class="content prose max-w-full pl-0 lg:pl-5 text-text [&_img]:my-5 [&_ul_li]:after:bg-(--accent)!"
          >
            <Content />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Process cards (Award) -->
  {process && (
    <WorkProcess subtitle="" title={process.title} steps={process.steps} cta={process.cta} />
  )}

  <!-- Intro + card stack (CCRDI's core services) -->
  {stack && (
    <section class="hairline-top bg-light py-section">
      <div class="container">
        <div class="row">
          <div class="lg:col-8">
            <div class="lg:grid grid-cols-12 sticky top-22">
              <div class="lg:col-span-3 max-lg:mb-4">
                <p class="text-eyebrow uppercase text-gold-text block lg:table-caption has-anim fade">{stack.section_title}</p>
              </div>
              <div class="lg:col-span-9 space-y-8">
                <div class="space-y-8 lg:space-y-10">
                  <h2 class="pull-quote text-dark has-anim fade">{stack.title}</h2>
                  {stack.description && <p class="text-body text-text max-w-measure has-anim fade delay-100">{stack.description}</p>}
                </div>
                {stack.info.length > 0 && (
                  <div class="flex flex-col items-start gap-2.5 pt-2">
                    {stack.info.map((item, i) => (
                      <p class:list={['inline-block text-dark px-5 py-2 text-sm bg-white border border-dark/10 rounded-full has-anim', animDelay[i]]}>{item}</p>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
          <div class="lg:col-4 max-lg:mt-16">
            <StackedServices services={stack.items.map((c) => ({ ...c, imageAlt: c.image_alt }))} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Testimonials (Marketing) -->
  {testimonials && (
    <section class="hairline-top bg-light py-section">
      <div class="container">
        <SectionTitle subtitle={testimonials.subtitle ?? ''} title={testimonials.title ?? ''} />
      </div>
      <ReviewCarousel items={testimonials.items} testimonials={testimonials} />
    </section>
  )}

  <!-- Family of brands: the homepage brand slider -->
  {brands.length > 0 && (
    <section class="hairline-top bg-white py-section">
      <div class="container">
        <SectionTitle title={data.next_title} />
      </div>
      <PortfolioCarousel projects={brands} />
    </section>
  )}
</Base>
