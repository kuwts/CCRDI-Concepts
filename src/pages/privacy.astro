---
import { getEntry, render } from 'astro:content';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Button from '@/components/Button.astro';

const entry = await getEntry('pages', 'privacy');
const data = entry!.data;
const { Content } = await render(entry!);
---

<Base title={data.title} description={data.description} seo={data.seo}>
  <PageHeader subtitle={data.subtitle ?? ''} title={data.heading} hairline />

  <section class="bg-white py-section">
    <div class="container has-anim fade delay-150">
      <div class="row justify-center">
        <div class="lg:col-10">
          <!-- body headings are ## / ###; they keep the 22px / 18px sizes of the old ### / #### -->
          <div class="content prose max-w-full text-text pr-0 lg:pr-10 [&_img]:my-6">
            <Content />
          </div>

          {
            data.cta && (
              <div class="mt-16 has-anim fade text-center">
                <h2 class="text-dark text-h3">{data.cta_heading}</h2>
                <Button href={data.cta.href} label={data.cta.label} variant="black" class="my-5" />
                {data.cta_note && (
                  <small class="block text-dark/70">{data.cta_note}</small>
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>
</Base>
