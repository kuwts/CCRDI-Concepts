---
import { getCollection, getEntry, render } from 'astro:content';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import Button from '@/components/Button.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import Callout from '@/components/ccc/Callout.astro';
import DownloadCards from '@/components/ccc/DownloadCards.astro';
import NewsList from '@/components/ccc/NewsList.astro';
import { getPressReleases } from '@/lib/content';
import { statSync } from 'node:fs';
import type { ImageMetadata } from 'astro';
import Clients from '@/components/Clients.astro';

// The theme's long-form page (privacy.astro) for the other `pages` entries:
// /media (Media & Partners: logo wall, body with a media enquiries note, logo downloads and
// the homepage news as a list) and /accessibility.
// /privacy keeps its own page file.
export async function getStaticPaths() {
  const entries = await getCollection('pages', (e) => e.id !== 'privacy' && !e.data.draft);
  return entries.map((entry) => ({ params: { page: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const data = entry.data;
const { Content } = await render(entry);

// press releases (src/content/data/press-releases.json), newest first, under the homepage's
// section heading; each opens the release on its newswire in a new tab
const home = data.news ? await getEntry('homepage', 'index') : undefined;
const blog = home?.data.blog;
const newsItems = blog
  ? (await getPressReleases()).map((r) => ({ title: r.title, href: r.url, date: r.date, datetime: r.datetime, category: r.source, excerpt: r.summary, external: true }))
  : [];

// downloads: each file's built URL, format and size are read from the file itself
// downloads come from the brand logos folder (an eager glob emits every file it matches)
const assetFiles = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/brands/*.{png,jpg,jpeg,webp,svg}', { eager: true });
const fileSize = (bytes: number) => (bytes >= 1048576 ? `${(bytes / 1048576).toFixed(1)} MB` : `${Math.round(bytes / 1024)} KB`);
const downloads = data.downloads?.items.map((d) => {
  const key = `/src/assets/${d.file.replace(/^\//, '')}`;
  return {
    title: d.title,
    href: assetFiles[key]?.default.src ?? '',
    format: d.file.split('.').pop()!.toUpperCase(),
    size: fileSize(statSync(`.${key}`).size),
    filename: d.filename,
  };
});

// the Our Brands logo wall (the same logos, one source)
const brandsEntry = data.brand_logos ? await getEntry('brands', 'index') : undefined;
const logoWall = brandsEntry?.data.clients;
---

<Base title={data.title} description={data.description} seo={data.seo}>
  <PageHeader subtitle={data.subtitle ?? ''} title={data.heading} hairline={!logoWall} />

  {/* logo wall on navy, as on Our Brands */}
  {logoWall && (
    <section class="pb-section -mt-24 sm:-mt-28">
      <div class="container">
        <SectionTitle subtitle={logoWall.subtitle} background="dark" class="pt-20 sm:pt-24" />
        <Clients items={logoWall.logos ?? []} columnCount={4} logoHeight={88} tiles class="mt-16" />
      </div>
    </section>
  )}

  <section class="bg-white py-section">
    <div class="container has-anim fade delay-150">
      <div class="row justify-center">
        <div class="lg:col-10">
          <!-- body headings are ## / ###; they keep the 22px / 18px sizes of the old ### / #### -->
          <div class="content prose max-w-full text-text pr-0 lg:pr-10 [&_img]:my-6">
            <Content />
          </div>

          {/* media enquiries */}
          {data.media_contact && (
            <Callout title={data.media_contact.title} as="h2" link={{ label: 'Contact Us', href: '/contact' }} class="mt-14">
              <p>{data.media_contact.body}</p>
            </Callout>
          )}

          {
            data.cta && (
              <div class="mt-16 has-anim fade text-center">
                <h2 class="text-dark text-h3">{data.cta_heading}</h2>
                <Button href={data.cta.href} label={data.cta.label} variant="black" class="my-5" />
                {data.cta_note && (
                  <small class="block text-dark/70">{data.cta_note}</small>
                )}
              </div>
            )
          }
        </div>
      </div>
    </div>
  </section>

  {/* logo downloads */}
  {data.downloads && downloads && downloads.length > 0 && (
    <section class="bg-light py-section">
      <div class="container">
        <SectionTitle title={data.downloads.title} />
        <DownloadCards id="downloads" items={downloads} />
      </div>
    </section>
  )}

  {/* press releases, as a list (no photos, so no cursor preview) */}
  {blog && newsItems.length > 0 && (
    <section class="hairline-top bg-white py-section">
      <div class="container">
        <SectionTitle subtitle={blog.subtitle} title={blog.title} />
        <NewsList items={newsItems} />
      </div>
    </section>
  )}
</Base>
