---
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import LineLink from '@/components/LineLink.astro';
import Button from '@/components/Button.astro';
import site from '@/config/site.config.json';
import { entryId, fill, getLang, localizePath, ui } from '@/i18n';

// English at /contact, French at /fr/nous-joindre (src/pages/_fr/nous-joindre.astro, routed while French is on); both send
// to the same Netlify form, with a `language` field saying which page it came from
const lang = getLang(Astro.url);
const t = ui(lang);
const thankYou = localizePath('/thank-you/contact', lang);
const contact = await getEntry('contact', entryId('index', lang));
const { header, intro, email, phone, address, form } = contact!.data;
const { fields } = form;
// Submissions go to Netlify Forms (form name "contact"). Where they're emailed is
// set per site in the Netlify dashboard: Forms > Submission notifications.
// Each field has a visible label (the job application form's pattern, with its
// required marker); the placeholder stays as a hint. Labels, placeholders and
// messages come from content.
const fieldClass = 'field';
const selectClass = 'field select-icon cursor-pointer';
const textareaClass = 'field field-textarea';
const labelClass = 'mb-2 text-[13px] sm:text-xs font-medium uppercase';
const required = '<span class="text-error" aria-hidden="true">*</span>';
---

<Base title={header.title} seo={contact!.data.seo}>
  <PageHeader subtitle={header.subtitle} title={header.title} colClass="lg:col-10" hairline />

  <section class="bg-white py-section">
    <div class="container">
      <div class="row justify-center">
        <div class="xl:col-11">
          <div class="row justify-center">
            <!-- Info -->
            <div class="lg:col-5 mb-5 lg:mb-0">
              <div class="pr-0 lg:pr-4">
                <h2 class="text-dark text-h3 has-anim fade mb-3">{intro.title}</h2>
                <p class="has-anim fade text-balance">{intro.text}</p>

                <div class="mt-8 has-anim fade delay-100">
                  {email.label && <p class={labelClass}>{email.label}</p>}
                  <p>
                    {email.value.includes('@') ? (
                      <LineLink href={`mailto:${email.value}`} label={email.value} tone="dark" />
                    ) : (
                      email.value
                    )}
                  </p>
                </div>
                <div class="mt-8 has-anim fade delay-200">
                  {phone.label && <p class={labelClass}>{phone.label}</p>}
                  {/* a real number is a tel: link; a placeholder is plain text */}
                  <p>
                    {/^[+\d][\d\s().-]+$/.test(phone.value) ? (
                      <LineLink href={`tel:${phone.value.replace(/\s/g, '')}`} label={phone.value} tone="dark" />
                    ) : (
                      phone.value
                    )}
                  </p>
                </div>
                <div class="mt-8 has-anim fade delay-300">
                  {address.label && <p class={labelClass}>{address.label}</p>}
                  {address.lines.map((l) => <p>{l}</p>)}
                </div>
              </div>
            </div>

            <!-- Form -->
            <div class="lg:col-7 max-lg:mt-8">
              <form
                name="contact"
                method="POST"
                action={thankYou}
                data-netlify="true"
                netlify-honeypot="bot-field"
                id="contact-form"
                data-sending={form.sending_label}
                data-error={form.error_message}
                data-required={form.validation?.required}
                data-invalid-email={form.validation?.email}
              >
                <input type="hidden" name="form-name" value="contact" />
                <input type="hidden" name="subject" value={fill(t.formSubject, { site: site.brand.name })} />
                <input type="hidden" name="language" value={lang} />
                <!-- spam honeypot: hidden from people; Netlify rejects submissions that fill it -->
                <p class="hidden">
                  <label>{t.botField} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
                </p>
                <div class="row">
                  <div class="col-12 md:col-6 has-anim fade">
                    <label for="contact-name" class="field-label">{fields.name.label} <Fragment set:html={required} /></label>
                    <input id="contact-name" type="text" name="name" autocomplete="name" class={fieldClass} placeholder={fields.name.placeholder} required />
                  </div>
                  <div class="col-12 md:col-6 has-anim fade">
                    <label for="contact-email" class="field-label">{fields.email.label} <Fragment set:html={required} /></label>
                    <input id="contact-email" type="email" name="email" autocomplete="email" class={fieldClass} placeholder={fields.email.placeholder} required />
                  </div>
                  {fields.phone && (
                    <div class="col-12 md:col-6 has-anim fade">
                      <label for="contact-phone" class="field-label">{fields.phone.label} <Fragment set:html={required} /></label>
                      <input id="contact-phone" type="tel" name="phone" autocomplete="tel" class={fieldClass} placeholder={fields.phone.placeholder} required />
                    </div>
                  )}
                  {fields.company && (
                    <div class:list={[fields.phone ? 'col-12 md:col-6' : 'col-12', 'has-anim fade']}>
                      <label for="contact-company" class="field-label">{fields.company.label}</label>
                      <input id="contact-company" type="text" name="company" autocomplete="organization" class={fieldClass} placeholder={fields.company.placeholder} />
                    </div>
                  )}
                  {fields.project_type && form.project_types.length > 0 && (
                    <div class="col-12 md:col-6 has-anim fade">
                      <label for="contact-project-type" class="field-label">{fields.project_type.label}</label>
                      <select id="contact-project-type" name="project_type" class={selectClass}>
                        <option value="" disabled selected>{fields.project_type.placeholder}</option>
                        {form.project_types.map((o) => <option value={o}>{o}</option>)}
                      </select>
                    </div>
                  )}
                  {fields.budget && form.budgets.length > 0 && (
                    <div class="col-12 md:col-6 has-anim fade">
                      <label for="contact-budget" class="field-label">{fields.budget.label}</label>
                      <select id="contact-budget" name="budget" class={selectClass}>
                        <option value="" disabled selected>{fields.budget.placeholder}</option>
                        {form.budgets.map((o) => <option value={o}>{o}</option>)}
                      </select>
                    </div>
                  )}
                  <div class="col-12 has-anim fade">
                    <label for="contact-message" class="field-label">{fields.message.label} <Fragment set:html={required} /></label>
                    <textarea id="contact-message" name="message" class={textareaClass} rows="1" placeholder={fields.message.placeholder} required></textarea>
                  </div>
                  <div class="col-12 has-anim fade">
                    <Button type="submit" label={form.submit_label} variant="black" />
                    <div class="status empty:hidden py-2 px-3 bg-error text-white font-medium text-sm mt-4" role="status" aria-live="polite"></div>
                  </div>
                </div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<script>
  const contactFormRef = document.getElementById('contact-form') as HTMLFormElement | null;

  if (contactFormRef) {
    const submitBtnRef = contactFormRef.querySelector<HTMLButtonElement>("button[type='submit']");
    const submitBtnTextRef = submitBtnRef?.innerHTML;
    const statusRef = contactFormRef.querySelector<HTMLElement>('.status');

    // custom messages for the browser's own checks (French pages), set before it validates
    const { required, invalidEmail } = contactFormRef.dataset;
    if (required || invalidEmail) {
      contactFormRef.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('input:not([type=hidden]), textarea').forEach((field) => {
        const check = () => {
          field.setCustomValidity('');
          if (field.validity.valueMissing && required) field.setCustomValidity(required);
          else if (field.validity.typeMismatch && invalidEmail) field.setCustomValidity(invalidEmail);
        };
        field.addEventListener('invalid', check);
        field.addEventListener('input', check);
      });
    }

    const showError = (text: string) => {
      if (statusRef) statusRef.textContent = text;
    };
    const resetButton = () => {
      if (!submitBtnRef) return;
      if (submitBtnTextRef) submitBtnRef.innerHTML = submitBtnTextRef;
      submitBtnRef.disabled = false;
    };

    contactFormRef.addEventListener('submit', (e) => {
      e.preventDefault();

      if (statusRef) statusRef.textContent = '';
      if (submitBtnRef) {
        submitBtnRef.disabled = true;
        const btnSpan = submitBtnRef.querySelector('span');
        if (btnSpan) btnSpan.textContent = contactFormRef.dataset.sending ?? '';
      }

      // Netlify Forms AJAX submission: URL-encoded body (JSON isn't supported),
      // posted to "/"; form-name and the honeypot travel with the form fields.
      fetch('/', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: new URLSearchParams(new FormData(contactFormRef) as unknown as Record<string, string>).toString(),
      })
        .then((response) => {
          // only a 2xx from Netlify counts as sent; then go to the thank-you page
          // (the form's `action`, which is also where no-JS visitors land)
          if (!response.ok) throw new Error(`Form submission failed (${response.status})`);
          window.location.href = contactFormRef.getAttribute('action') ?? '/';
        })
        .catch(() => {
          showError(contactFormRef.dataset.error ?? '');
        })
        .finally(resetButton);
    });
  }
</script>
