---
import Base from '@/layouts/Base.astro';
import Button from '@/components/Button.astro';
// heading and button: content.md 404 labels; the message is a placeholder (brief/gaps.md)
---

<Base title="Page not found" noindex>
  <section class="pt-24 sm:pt-28 pb-28 sm:pb-32">
    <div class="container">
      <div class="row justify-center text-center">
        <div class="lg:col-8">
          <p class="mb-3 font-medium text-9xl text-white" aria-hidden="true">40<span class="rotate-y-180 inline-block">4</span></p>
          <h1 class="mb-6 font-normal text-white">
            Page not found<span class="text-primary" aria-hidden="true">.</span>
          </h1>
          <p class="lead mb-8 text-white/80">
            [CLIENT TO PROVIDE: 404 message]
          </p>
          <Button href="/" label="Return Home" />
        </div>
      </div>
    </div>
  </section>
</Base>
