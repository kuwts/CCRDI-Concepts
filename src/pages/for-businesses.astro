---
// For Businesses: a Services-overview page composed from the theme's own sections
// (PageHeader, the homepage intro block and card stack, WorkProcess, the homepage brand slider);
// plan in brief/page-plans.md
import { getEntry } from 'astro:content';

import Base from '@/layouts/Base.astro';
import PageHeader from '@/components/PageHeader.astro';
import WorkProcess from '@/components/WorkProcess.astro';
import SectionTitle from '@/components/SectionTitle.astro';
import PortfolioCarousel from '@/components/PortfolioCarousel.astro';
import StackedServices from '@/components/StackedServices.astro';
import ReviewCarousel from '@/components/ReviewCarousel.astro';
import { animDelay } from '@/utils/animDelay';

const entry = await getEntry('businesses', 'index');
const { title, intro, audiences, brands } = entry!.data;
// testimonials: the homepage placeholders, until the client supplies real ones
const home = entry!.data.testimonials ? await getEntry('homepage', 'index') : undefined;
const testimonials = home?.data.testimonials;
const slides = brands.items.map((b) => ({ ...b, imageAlt: b.image_alt }));
---

<Base title={title} seo={entry!.data.seo}>
  <PageHeader subtitle="" title={title} hairline />

  <!-- Why Consumer Choice: intro + the benefits as a card stack (the homepage's intro block) -->
  {intro && (
    <section class="bg-light py-section">
      <div class="container">
        <div class="row">
          <div class="lg:col-8">
            <div class="lg:grid grid-cols-12 sticky top-22">
              <div class="lg:col-span-3 max-lg:mb-4">
                <p class="text-eyebrow uppercase text-gold-text block lg:table-caption has-anim fade">{intro.section_title}</p>
              </div>
              <div class="lg:col-span-9 space-y-8">
                <div class="space-y-8 lg:space-y-10">
                  <h2 class="pull-quote text-dark has-anim fade">{intro.title}</h2>
                  <p class="text-body text-text max-w-measure has-anim fade delay-100">{intro.description}</p>
                </div>
                {intro.info.length > 0 && (
                  <div class="flex flex-col items-start gap-2.5 pt-2">
                    {intro.info.map((item, i) => (
                      <p class:list={['inline-block text-dark px-5 py-2 text-sm bg-white border border-dark/10 rounded-full has-anim', animDelay[i]]}>{item}</p>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </div>
          <div class="lg:col-4 max-lg:mt-16">
            <StackedServices services={intro.items.map((c) => ({ ...c, imageAlt: c.image_alt }))} />
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Audiences + contact path -->
  <WorkProcess subtitle="" title={audiences.title} steps={audiences.steps} cta={audiences.cta} columns={3} />

  <!-- Family of brands: the homepage brand slider -->
  {slides.length > 0 && (
    <section class="hairline-top bg-white py-section">
      <div class="container">
        <SectionTitle title={brands.title} />
      </div>
      <PortfolioCarousel projects={slides} />
    </section>
  )}

  <!-- Testimonials -->
  {testimonials && (
    <section class="hairline-top bg-light py-section">
      <div class="container">
        <SectionTitle subtitle={testimonials.subtitle ?? ''} title={testimonials.title ?? ''} />
      </div>
      <ReviewCarousel items={testimonials.items} testimonials={testimonials} />
    </section>
  )}
</Base>
